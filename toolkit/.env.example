# DFIR toolkit — API keys for the OPTIONAL model steps only.
# Generation, build_disk.py, and selftest.py need NONE of these.
#
#   cp .env.example .env      # then paste your real keys below
#   set -a; source .env; set +a
#
# Family separation: score a Gemini policy with an Anthropic judge, and a
# Claude policy with a Gemini judge — never the same family as judge and policy.

# Agent policy (e.g. terminus-2 + gemini/gemini-3.6-flash) and Gemini judge:
GEMINI_API_KEY=

# Tier-3 judge (e.g. anthropic/claude-opus-5) and Anthropic policies:
ANTHROPIC_API_KEY=
