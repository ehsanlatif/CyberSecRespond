  "remediation": [
    {
      "chk": "CHK-20",
      "action": "block attacker source IP inbound",
      "verify": "iptables -L INPUT -n | grep <ip>",
      "phase": "contain",
      "risk_class": "network"
    },
    {
      "chk": "CHK-01",
      "action": "quarantine miner binary and terminate the process",
      "verify": "pgrep -f .xorg returns empty",
      "phase": "eradicate",
      "risk_class": "runtime"
    },
    {
      "chk": "CHK-11",
      "action": "remove cron entry from /var/spool/cron/root",
      "verify": "grep -c '<marker>' /var/spool/cron/root == 0",
      "phase": "eradicate",
      "risk_class": "runtime"
    },
    {
      "chk": "CHK-12",
      "action": "remove injected line from /root/.bashrc",
      "verify": "grep -c '<marker>' /root/.bashrc == 0",
      "phase": "eradicate",
      "risk_class": "runtime"
    },
    {
      "chk": "CHK-13",
      "action": "disable and remove system-update-helper.service",
      "verify": "systemctl is-enabled system-update-helper 2>&1 | grep -qv enabled",
      "phase": "eradicate",
      "risk_class": "service"
    },
    {
      "chk": "CHK-08",
      "action": "remove /etc/sudoers.d/devops NOPASSWD grant",
      "verify": "! grep -q NOPASSWD /etc/sudoers.d/devops",
      "phase": "eradicate",
      "risk_class": "auth"
    },
    {
      "chk": "CHK-04",
      "action": "set PermitRootLogin no, PasswordAuthentication no, MaxAuthTries 3; reload sshd",
      "verify": "sshd -T | grep -E 'permitrootlogin|passwordauthentication|maxauthtries'",
      "phase": "harden",
      "risk_class": "auth"
    },
    {
      "chk": "CHK-09",
      "action": "bind MySQL to localhost and revoke the remote root grant",
      "verify": "grep -q '^bind-address' /etc/my.cnf",
      "phase": "harden",
      "risk_class": "service"
    },
    {
      "chk": "CHK-07",
      "action": "rotate root and devops credentials",
      "verify": "chage -l root shows a recent change date",
      "phase": "rotate",
      "risk_class": "auth"
    },
    {
      "chk": "CHK-21",
      "action": "confirm sshd hardening took effect",
      "verify": "sshd -T | grep permitrootlogin",
      "phase": "verify",
      "risk_class": "auth"
    },
    {
      "chk": "CHK-22",
      "action": "restart affected services and confirm health",
      "verify": "systemctl is-active <svc> and HTTP 200 on /",
      "phase": "verify",
      "risk_class": "service"
    }
  ],
