  "remediation": [
    {
      "chk": "CHK-20",
      "action": "block the exfil destination and attacker IP at the egress firewall",
      "verify": "iptables -L OUTPUT -n | grep <ip>",
      "phase": "contain",
      "risk_class": "network"
    },
    {
      "chk": "CHK-01",
      "action": "quarantine upload.jsp and its drop directory",
      "verify": "! test -f /opt/tomcat/webapps/ROOT/static/upload.jsp",
      "phase": "eradicate",
      "risk_class": "service"
    },
    {
      "chk": "CHK-02",
      "action": "remove the staged exfil archive",
      "verify": "! test -f /tmp/.cache/dump.tar.gz",
      "phase": "eradicate",
      "risk_class": "runtime"
    },
    {
      "chk": "CHK-03",
      "action": "remove the attacker key from /root/.ssh/authorized_keys",
      "verify": "! grep -q attacker /root/.ssh/authorized_keys",
      "phase": "eradicate",
      "risk_class": "auth"
    },
    {
      "chk": "CHK-04",
      "action": "remove the tomcat cron entry",
      "verify": "! test -f /var/spool/cron/tomcat",
      "phase": "eradicate",
      "risk_class": "runtime"
    },
    {
      "chk": "CHK-05",
      "action": "upgrade struts2 past the fixed release",
      "verify": "rpm -q struts2 shows a patched version",
      "phase": "harden",
      "risk_class": "service"
    },
    {
      "chk": "CHK-07",
      "action": "rotate application, root, and any exfiltrated credentials",
      "verify": "credential rotation timestamps are recent",
      "phase": "rotate",
      "risk_class": "auth"
    },
    {
