[36.440317, "o", "<!doctype html><html><body>\r\nsuspicious defaced-page artifact observed (defanged)\r\nindicator hacked=CHK-02 (T1491.001)\r\n</body></html>\r\n# .htaccess\r\n.htaccess RewriteRule redirect of all traffic to 198.51.100.40 (pharma) — defanged\r\n<?php\r\n// wp-config.php\r\nrequire 'config.php';\r\nwp-config.php DB_PASSWORD is weak; XML-RPC enabled\r\n?>\r\n<?php\r\n// inc.php\r\nrequire 'config.php';\r\nPHP webshell: calls eval() on base64_decode() of the request body — defanged, non-runnable\r\n?>\r\n\u001b[?2004hroot@c89c930ede79:/app# "]
