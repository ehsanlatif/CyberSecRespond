[163.686679, "o", "{\r\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\r\n  \"title\": \"finding\",\r\n  \"type\": \"object\",\r\n  \"required\": [\r\n    \"chk\",\r\n    \"path\",\r\n    \"attck\",\r\n    \"confidence\",\r\n    \"evidence\"\r\n  ],\r\n  \"properties\": {\r\n    \"chk\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"path\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"attck\": {\r\n      \"type\": \"string\",\r\n      \"pattern\": \"^T\\\\d{4}(\\\\.\\\\d{3})?$\"\r\n    },\r\n    \"confidence\": {\r\n      \"enum\": [\r\n        \"low\",\r\n        \"medium\",\r\n        \"high\"\r\n      ]\r\n    },\r\n    \"evidence\": {\r\n      \"type\": \"string\",\r\n      \"description\": \"backtick-cited /disk or /sas path\"\r\n    }\r\n  }\r\n}\r\n\u001b[?2004hroot@d442ccdcc174:/app# echo \"== partial json ==\"\r\n\u001b[?2004l\r== partial json ==\r\n\u001b[?2004hroot@d442ccdcc174:/app# cat /sas/handoff/findings.partial.json\r\n\u001b[?2004l\r"]
