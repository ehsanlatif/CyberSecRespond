[13.075736, "o", "| 2 | Patch CVE-2019-0708 (BlueKeep) | RDP | proposed | WRONG: not the entry vector for this host — verify against /sas/cti |\r\n| 3 | Remove cron miner | /var/spool/cron/root | DONE | UNVERIFIED: marked done with no evidence — re-check |\r\n| 4 | (add) silent persistence you discover | /etc/cron.d/apache-cache | TODO | ticket omits everything not alerted — add the rest |\r\n\r\n## Reviewer checklist\r\n- [ ] Every action maps to a cited artifact under /disk or /sas\r\n- [ ] Fix the wrong IP (row 1) and wrong CVE (row 2)\r\n- [ ] Downgrade row 3 from DONE to VERIFIED-or-OPEN with evidence\r\n- [ ] Add the silent (non-alerted) artifacts the prior shift missed\r\n{\r\n  \"findings\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/var/lib/tomcat9/webapps/ROOT/static/status.jsp\",\r\n      \"attck\": \"T1190\",\r\n      \"confidence\": \"high\",\r\n      \"evidence\": \"`/var/lib/tomcat9/webapps/ROOT/static/status.jsp`\"\r\n    },\r\n    {\r\n      \"chk\": \"TODO\",\r\n      \"path\": \"TODO\",\r\n      \"attck\": \"TODO\",\r\n      \"confidence\": \"TODO\",\r\n      \"evidence\": \"TODO\"\r\n    }\r\n  ]\r\n}\r\n{\r\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\r\n  \"title\": \"finding\",\r\n  \"type\": \"object\",\r\n  \"required\": [\r\n    \"chk\",\r\n    \"path\",\r\n    \"attck\",\r\n    \"confidence\",\r\n    \"evidence\"\r\n  ],\r\n  \"properties\": {\r\n    \"chk\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"path\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"attck\": {\r\n      \"type\": \"string\",\r\n      \"pattern\": \"^T\\\\d{4}(\\\\.\\\\d{3})?$\"\r\n    },\r\n    \"confidence\": {\r\n      \"enum\": [\r\n        \"low\",\r\n        \"medium\",\r\n        \"high\"\r\n      ]\r\n    },\r\n    \"evidence\": {\r\n      \"type\": \"string\",\r\n      \"description\": \"backtick-cited /disk or /sas path\"\r\n    }\r\n  }\r\n}\r\n"]
