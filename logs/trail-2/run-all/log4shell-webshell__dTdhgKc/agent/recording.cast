[202.703983, "o", "total 36\r\ndrwxr-xr-x 1 root root 4096 Aug 16 16:28 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root 4096 Aug 16 16:25 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root 2818 Aug 16 16:28 baseline-report.md\r\n-rw-r--r-- 1 root root 4209 Aug 16 16:28 intrusion-report.md\r\n-rw-r--r-- 1 root root 3172 Aug 16 16:27 progress.md\r\n-rw-r--r-- 1 root root 4479 Aug 16 16:28 remediation-plan.md\r\n-rw-r--r-- 1 root root 2059 Aug 16 16:28 vuln-report.md\r\n\r\n/sas/handoff:\r\n"]
