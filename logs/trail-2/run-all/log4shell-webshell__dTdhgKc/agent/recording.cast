[179.136128, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[179.136233, "o", "## Baseline Audit Recommendations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.136403, "o", "1. Enforce hardening of `/opt/app/log4j2.xml` (`/disk/opt/app/log4j2.xml:3`).\r\n\u001b[?2004l\r\u001b[?2004h"]
