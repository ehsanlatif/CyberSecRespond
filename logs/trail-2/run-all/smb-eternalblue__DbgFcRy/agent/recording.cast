[73.49242, "i", "python3 -c '\nimport os, re\n\nfiles = [\n    \"/disk/Windows/System32/config/RegBack/SECURITY.bak\",\n    \"/disk/Windows/System32/wbem/Repository/OBJECTS.DATA\",\n    \"/disk/Windows/System32/wbem/wbemcomn.dll\",\n    \"/disk/Windows/System32/winevt/Logs/System.evtx\",\n    \"/disk/Windows/Temp/lsass.dmp\",\n    \"/disk/Windows/Temp/mssecsvc.exe\",\n    \"/disk/Users/Public/enc.exe\",\n    \"/disk/Windows/System32/drivers/srv.sys\"\n]\n\nfor f in files:\n    print(f\"=== {f} ===\")\n    try:\n        with open(f, \"rb\") as fp:\n            content = fp.read()\n        # find ASCII and UTF-16 strings\n        ascii_strings = re.findall(b\"[\\x20-\\x7e]{4,}\", content)\n        for s in ascii_strings:\n            s_str = s.decode(\"latin1\")\n            if not re.match(r\"^[0-9a-f]{8}\\s+[0-9a-f ]{47}\", s_str):\n                print(\"  ASCII:\", s_str)\n        # wide strings\n        wide_strings = re.findall(b\"(?:[\\x20-\\x7e]\\x00){4,}\", content)\n        for ws in wide_strings:\n            w_str = ws.decode(\"utf-16le\", errors=\"ignore\")\n            print(\"  WIDE:\", w_str)\n    except Exception as e:\n        print(\"  Error:\", e)\n'\n"]
[73.493253, "o", "python3 -c '\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.493733, "o", "> import os, re\r\n"]
[73.494161, "o", "\u001b[?2004l\r\u001b[?2004h"]
[73.494283, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> files = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.494686, "o", "    \"/disk/Windows/System32/config/RegBack/SECURITY.bak\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"/disk/Windows/System32/wbem/Repository/OBJECTS.DATA\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"/disk/Windows/System32/wbem/wbemcomn.dll\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"/disk/Windows/System32/winevt/Logs/System.evtx\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"/disk/Windows/Temp/lsass.dmp\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"/disk/Windows/Temp/mssecsvc.exe\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"/disk/Users/Public/enc.exe\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"/disk/Windows/System32/drivers/srv.sys\"\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for f in files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.494719, "o", "    print(f\"=== {f} ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.494757, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.494774, "o", "        with open(f, \"rb\") as fp:\r\n\u001b[?2004l\r"]
[73.494789, "o", "\u001b[?2004h> "]
[73.494823, "o", "            content = fp.read()\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.495041, "o", ">         # find ASCII and UTF-16 strings\r\n\u001b[?2004l\r"]
[73.49512, "o", "\u001b[?2004h> "]
[73.495155, "o", "        ascii_strings = re.findall(b\"[\\x20-\\x7e]{4,}\", content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.495227, "o", "        for s in ascii_strings:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.495344, "o", "            s_str = s.decode(\"latin1\")\r\n\u001b[?2004l\r\u001b[?2004h>             if not re.match(r\"^[0-9a-f]{8}\\s+[0-9a-f ]{47}\", s_str):"]
[73.495664, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                 print(\"  ASCII:\", s_str)\r\n\u001b[?2004l\r\u001b[?2004h>         # wide strings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.495857, "o", "        wide_strings = re.findall(b\"(?:[\\x20-\\x7e]\\x00){4,}\", content)\r\n\u001b[?2004l\r\u001b[?2004h>         for ws in wide_strings:\r\n\u001b[?2004l\r\u001b[?2004h>             w_str = ws.decode(\"utf-16le\", errors=\"ignore\")"]
[73.495869, "o", "\r\n\u001b[?2004l\r"]
[73.495937, "o", "\u001b[?2004h> "]
[73.495973, "o", "            print(\"  WIDE:\", w_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.496025, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.496035, "o", "        print(\"  Error:\", e)\r\n\u001b[?2004l\r"]
[73.496091, "o", "\u001b[?2004h> '\r\n\u001b[?2004l\r"]
