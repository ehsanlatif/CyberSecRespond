[195.782764, "o", "\u001b[?2004h> "]
[195.782928, "o", "4. SMBv1 driver baseline check (`/disk/Windows/System32/drivers/srv.sys`). Cited: `/sas/alerts.json`.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[195.783007, "o", "\u001b[?2004h> "]
