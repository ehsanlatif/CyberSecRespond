[21.458471, "o", "\r\n\u001b[?2004l\r{\r\n  \"range_id\": \"ssh-miner\",\r\n  \"difficulty\": 2,\r\n  \"alert_coverage\": 0.55,\r\n  \"platform\": {\r\n    \"os\": \"centos\",\r\n    \"version\": \"7\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1110\",\r\n      \"desc\": \"SSH brute force as root\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1021.004\",\r\n      \"desc\": \"SSH login\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1059.004\",\r\n      \"desc\": \"shell execution\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1496\",\r\n      \"desc\": \"cryptomining\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n      \"attck\": \"T1546.004\",\r\n      \"desc\": \"bashrc persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 7,\r\n      \"attck\": \"T1543.002\",\r\n      \"desc\": \"systemd persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 8,\r\n      \"attck\": \"T1070.002\",\r\n      \"desc\": \"auth log cleared\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/tmp/.X11-unix/.xorg\",\r\n      \"kind\": \"miner-process\",\r\n      \"capability\": \"ENT-P01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1496\",\r\n      \"match\": [\r\n        \"process\",\r\n        \"pid\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/tmp/.X11-unix/.xorg\",\r\n      \"kind\": \"miner-binary\",\r\n      \"capability\": \"ENT-F02\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1496\",\r\n      \"match\": [\r\n        \"binary\",\r\n        \"hash\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/home/devops/.bash_history\",\r\n      \"kind\": \"attack-tool-residue\",\r\n      \"capability\": \"ENT-F04\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1110\",\r\n      \"match\": [\r\n        \"hydra\",\r\n        \"brute\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/etc/ssh/sshd_config\",\r\n      \"kind\": \"ssh-baseline\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"PermitRootLogin\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-08\",\r\n      \"path\": \"/etc/sudoers.d/devops\",\r\n      \"kind\": \"sudoers-backdoor\",\r\n      \"capability\": \"PER-A01\",\r\n      \"alerted\": false,\r\n      \"weight\": 1.5,\r\n      \"attck\": \"T1548.003\",\r\n      \"match\": [\r\n        \"NOPASSWD\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-09\",\r\n      \"path\": \"/etc/my.cnf\",\r\n      \"kind\": \"mysql-remote-root\",\r\n      \"capability\": \"BAS-02\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"bind-address\",\r\n        \"0.0.0.0\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-11\",\r\n      \"path\": \"/var/spool/cron/root\",\r\n      \"kind\": \"cron\",\r\n      \"capability\": \"PER-S01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1053.003\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-12\",\r\n      \"path\": \"/root/.bashrc\",\r\n      \"kind\": \"shell-init\",\r\n      \"capability\": \"PER-I01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1546.004\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-13\",\r\n      \"path\": \"/etc/systemd/system/system-update-helper.service\",\r\n      \"kind\": \"systemd\",\r\n      \"capability\": \"PER-V01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1543.002\"\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"block attacker source IP inbound\",\r\n      \"verify\": \"iptables -L INPUT -n | grep <ip>\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"quarantine miner binary and terminate the process\",\r\n      \"verify\": \"pgrep -f .xorg returns empty\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-11\",\r\n      \"action\": \"remove cron entry from /var/spool/cron/root\",\r\n      \"verify\": \"grep -c '<marker>' /var/spoo"]
[21.458517, "o", "l/cron/root == 0\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-12\",\r\n      \"action\": \"remove injected line from /root/.bashrc\",\r\n      \"verify\": \"grep -c '<marker>' /root/.bashrc == 0\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-13\",\r\n      \"action\": \"disable and remove system-update-helper.service\",\r\n      \"verify\": \"systemctl is-enabled system-update-helper 2>&1 | grep -qv enabled\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-08\",\r\n      \"action\": \"remove /etc/sudoers.d/devops NOPASSWD grant\",\r\n      \"verify\": \"! grep -q NOPASSWD /etc/sudoers.d/devops\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"set PermitRootLogin no, PasswordAuthentication no, MaxAuthTries 3; reload sshd\",\r\n      \"verify\": \"sshd -T | grep -E 'permitrootlogin|passwordauthentication|maxauthtries'\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-09\",\r\n      \"action\": \"bind MySQL to localhost and revoke the remote root grant\",\r\n      \"verify\": \"grep -q '^bind-address' /etc/my.cnf\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"action\": \"rotate root and devops credentials\",\r\n      \"verify\": \"chage -l root shows a recent change date\",\r\n      \"phase\": \"rotate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-21\",\r\n      \"action\": \"confirm sshd hardening took effect\",\r\n      \"verify\": \"sshd -T | grep permitrootlogin\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-22\",\r\n      \"action\": \"restart affected services and confirm health\",\r\n      \"verify\": \"systemctl is-active <svc> and HTTP 200 on /\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    }\r\n  ],\r\n  \"precedence\": [\r\n    \"contain\",\r\n    \"eradicate\",\r\n    \"harden\",\r\n    \"rotate\",\r\n    \"verify\"\r\n  ],\r\n  \"no_cve_entry\": true,\r\n  \"decoys\": [],\r\n  \"signature\": \"0d1ec67074f7\"\r\n}\r\n"]
