/task/baselines/oracle/vuln-report.md\r\n/app/task/baselines/oracle/remediation-plan.md\r\n/app/task/baselines/oracle/intrusion-report.md\r\n/app/task/baselines/oracle/progress.md\r\n/app/task/.DS_Store\r\n/app/task/environment\r\n"]
