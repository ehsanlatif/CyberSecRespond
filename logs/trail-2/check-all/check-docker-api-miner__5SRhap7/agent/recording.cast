[53.298178, "o", "[{'claim': '| miner-process (xmrig, pool) | `/opt/xmrig/xmrig` | T1496 |', 'citations': [('/opt/xmrig/xmrig', '')], 'source': 'intrusion-report.md'}, {'claim': '| container-residue (entrypoint, curl) | `/var/lib/docker/overlay2/attacker/diff/entrypoint.sh` | T1610 |', 'citations': [('/var/lib/docker/overlay2/attacker/diff/entrypoint.sh', '')], 'source': 'intrusion-report.md'}, {'claim': '| cron (xmrig, cron) | `/etc/cron.d/docker-mon` | T1053.003 | yes |', 'citations': [('/etc/cron.d/docker-mon', '')], 'source': 'intrusion-report.md'}, {'claim': '| systemd (xmrig, ExecStart) | `/etc/systemd/system/docker-metrics.service` | T1543.002 | **no** |', 'citations': [('/etc/systemd/system/docker-metrics.service', '')], 'source': 'intrusion-report.md'}, {'claim': 'set (`/sas/vulns.json`), and disk evidence attributes initial access to weak-credential and', 'citations': [('/sas/vulns.json', '')], 'source': 'vuln-report.md'}, {'claim': 'Confidence: high. Evidence: `/etc/docker/daemon.json`, empty `/sas/vulns.json`.', 'citations': [('/etc/docker/daemon.json', ''), ('/sas/vulns.json', '')], 'source': 'vuln-report.md'}, {'claim': '| docker-baseline (2375, hosts) | `/etc/docker/daemon.json` | BAS-01 |', 'citations': [('/etc/docker/daemon.json', '')], 'source': 'baseline-report.md'}]\r\n"]
