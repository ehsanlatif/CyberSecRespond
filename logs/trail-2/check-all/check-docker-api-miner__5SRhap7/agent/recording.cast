[25.125281, "o", "{\r\n  \"range_id\": \"docker-api-miner\",\r\n  \"difficulty\": 3,\r\n  \"alert_coverage\": 0.6,\r\n  \"platform\": {\r\n    \"os\": \"ubuntu\",\r\n    \"version\": \"22.04\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1133\",\r\n      \"desc\": \"exposed Docker API (external service)\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1610\",\r\n      \"desc\": \"deploy privileged container\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1611\",\r\n      \"desc\": \"container escape to host\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1496\",\r\n      \"desc\": \"cryptomining\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n      \"attck\": \"T1543.002\",\r\n      \"desc\": \"systemd persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/opt/xmrig/xmrig\",\r\n      \"kind\": \"miner-process\",\r\n      \"capability\": \"ENT-P01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1496\",\r\n      \"match\": [\r\n        \"xmrig\",\r\n        \"pool\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/etc/cron.d/docker-mon\",\r\n      \"kind\": \"cron\",\r\n      \"capability\": \"PER-S01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1053.003\",\r\n      \"match\": [\r\n        \"xmrig\",\r\n        \"cron\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/etc/systemd/system/docker-metrics.service\",\r\n      \"kind\": \"systemd\",\r\n      \"capability\": \"PER-V01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1543.002\",\r\n      \"match\": [\r\n        \"xmrig\",\r\n        \"ExecStart\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/var/lib/docker/overlay2/attacker/diff/entrypoint.sh\",\r\n      \"kind\": \"container-residue\",\r\n      \"capability\": \"ENT-F02\",\r\n      \"alerted\": false,\r\n      \"weight\": 1.5,\r\n      \"attck\": \"T1610\",\r\n      \"match\": [\r\n        \"entrypoint\",\r\n        \"curl\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/etc/docker/daemon.json\",\r\n      \"kind\": \"docker-baseline\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"2375\",\r\n        \"hosts\"\r\n      ]\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"firewall the Docker API port and block the attacker IP\",\r\n      \"verify\": \"port 2375 is not reachable off-host\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"quarantine the xmrig miner and terminate the process\",\r\n      \"verify\": \"pgrep -f xmrig returns empty\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"action\": \"remove the docker-mon cron entry\",\r\n      \"verify\": \"! test -f /etc/cron.d/docker-mon\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"action\": \"disable and remove the docker-metrics systemd unit\",\r\n      \"verify\": \"systemctl is-enabled docker-metrics returns not enabled\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"stop and remove the attacker container and image\",\r\n      \"verify\": \"docker ps -a shows no attacker container\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"action\": \"disable the TCP Docker socket; require TLS/localhost only\",\r\n      \"verify\": \"daemon.json exposes no 0.0.0.0:2375 host\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"action\": \"rotate credentials and secrets reachable from the host and containers\",\r\n      \"verify\": \"credential rotation timestamps are recent\",\r\n      \"phase\": \"rotate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-22\",\r\n      \"actio"]
[25.125294, "o", "n\": \"restart Docker with the hardened config and confirm host health\",\r\n      \"verify\": \"systemctl is-active docker and CPU baseline normal\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    }\r\n  ],\r\n  \"precedence\": [\r\n    \"contain\",\r\n    \"eradicate\",\r\n    \"harden\",\r\n    \"rotate\",\r\n    \"verify\"\r\n  ],\r\n  \"no_cve_entry\": true,\r\n  \"decoys\": [],\r\n  \"signature\": \"9e202e3a533f\"\r\n}\r\n"]
