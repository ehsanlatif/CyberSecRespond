[203.263308, "i", "python3 -c '\nimport json\nwith open(\"check-result.json\") as f:\n  data = json.load(f)\nprint(f\"Keys count: {len(data)}\")\nrequired_keys = [\n    \"verifiable\", \"solvable\", \"difficult\", \"interesting\", \"outcome_verified\",\n    \"anti_cheat_robustness\", \"task_security\", \"functional_verification\",\n    \"deterministic_reproducible\", \"essential_difficulty\", \"test_instruction_alignment\",\n    \"novel\", \"agentic\", \"reviewable\", \"instruction_concision\", \"solution_quality\",\n    \"separate_verifier_configured\", \"environment_hygiene\", \"structured_data_schema\",\n    \"typos\", \"difficulty_explanation_quality\", \"solution_explanation_quality\",\n    \"verification_explanation_quality\", \"category_and_tags\", \"task_name\",\n    \"resource_configuration\", \"task_readme\", \"expert_time_estimate\",\n    \"task_toml_schema\", \"no_extraneous_files\", \"artifact_efficiency\",\n    \"verifier_execution_isolation\", \"ctrf_reporting\", \"do_not_modify_enforced\",\n    \"binary_reward\"\n]\nmissing = [k for k in required_keys if k not in data]\nprint(f\"Missing keys: {missing}\")\nfor k, v in data.items():\n  assert \"outcome\" in v and \"explanation\" in v\n  assert v[\"outcome\"] in [\"pass\", \"fail\", \"not_applicable\"]\nprint(\"All assertions passed successfully!\")\n'\n"]
[203.265613, "o", "python3 -c '\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> with open(\"check-result.json\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>   data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Keys count: {len(data)}\")\r\n\u001b[?2004l\r\u001b[?2004h> required_keys = [\r\n\u001b[?2004l\r\u001b[?2004h>     \"verifiable\", \"solvable\", \"difficult\", \"interesting\", \"outcome_verified\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"anti_cheat_robustness\", \"task_security\", \"functional_verification\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"deterministic_reproducible\", \"essential_difficulty\", \"test_instruction_alignment\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"novel\", \"agentic\", \"reviewable\", \"instruction_concision\", \"solution_quality\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"separate_verifier_configured\", \"environment_hygiene\", \"structured_data_schema\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"typos\", \"difficulty_explanation_quality\", \"solution_explanation_quality\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"verification_explanation_quality\", \"category_and_tags\", \"task_name\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"resource_configuration\", \"task_readme\", \"expert_time_estimate\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"task_toml_schema\", \"no_extraneous_files\", \"artifact_efficiency\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"verifier_execution_isolation\", \"ctrf_reporting\", \"do_not_modify_enforced\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"binary_reward\"\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> missing = [k for k in required_keys if k not in data]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.26585, "o", "print(f\"Missing keys: {missing}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.265944, "o", "for k, v in data.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.266035, "o", "  assert \"outcome\" in v and \"explanation\" in v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.266131, "o", "  assert v[\"outcome\"] in [\"pass\", \"fail\", \"not_applicable\"]\r\n\u001b[?2004l\r"]
