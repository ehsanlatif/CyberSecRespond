[90.726747, "i", "cat /app/task/tests/structure/five_files_exist.py\n"]
[90.727417, "o", "cat /app/task/tests/structure/five_files_exist.py\r\n\u001b[?2004l\r"]
[90.728264, "o", "# tests/structure/five_files_exist.py  (FIXED — structure gate, required_pass)\r\n"]
[90.728302, "o", "from pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nREQUIRED = (\"progress.md\", \"intrusion-report.md\", \"vuln-report.md\",\r\n            \"baseline-report.md\", \"remediation-plan.md\")\r\n\r\n\r\n@criterion(description=\"all five required report files exist\", required_pass=True)\r\ndef five_files_exist(workspace: Path) -> bool:\r\n    # A run that produces fewer than five files is `incomplete_output`, not a low score\r\n    # (doc 04 §2.2). The structure gate is multiplicative in the reward (doc 02 §4.4).\r\n    return all((workspace / name).exists() for name in REQUIRED)\r\n"]
[90.728425, "o", "\u001b[?2004hroot@454259a7e7a2:/app# "]
[90.922663, "i", "cat /app/task/tests/structure/nonempty_and_parses.py\n"]
[90.923633, "o", "cat /app/task/tests/structure/nonempty_and_parses.py\r\n\u001b[?2004l\r"]
[90.924405, "o", "# tests/structure/nonempty_and_parses.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import REPORT_FILES\r\n\r\nREQUIRED = (\"progress.md\", \"intrusion-report.md\", \"vuln-report.md\",\r\n            \"baseline-report.md\", \"remediation-plan.md\")\r\nMIN_CHARS = 40  # a plausible report has at least a heading and a sentence\r\n\r\n\r\n@criterion(description=\"every report is non-empty and has at least one markdown heading\",\r\n           required_pass=True)\r\ndef nonempty_and_parses(workspace: Path) -> bool:\r\n    for name in REQUIRED:\r\n        p = workspace / name\r\n        if not p.exists():\r\n            return False\r\n        text = p.read_text(errors=\"replace\").strip()\r\n        if len(text) < MIN_CHARS:\r\n            return False\r\n        if not any(line.lstrip().startswith(\"#\") for line in text.splitlines()):\r\n            return False\r\n    return True\r\n"]
[90.924494, "o", "\u001b[?2004hroot@454259a7e7a2:/app# "]
[91.12835, "i", "cat /app/task/tests/structure/required_sections.py\n"]
[91.128719, "o", "cat /app/task/tests/structure/required_sections.py\r\n\u001b[?2004l\r"]
[91.129339, "o", "# tests/structure/required_sections.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n# Minimal section contract each report must satisfy (case-insensitive substring match).\r\n# Deliberately loose — the gate checks SHAPE, not content quality. In particular it does NOT\r\n# require verification language in the plan (that is a Tier-1 plan score, not a structure\r\n# gate), so a well-formed but evidence-free no-op report still passes structure.\r\n# Each requirement is either a substring that must appear, or a tuple of alternatives of which\r\n# at least one must appear. This is a SHAPE gate only. The intrusion report must contain an\r\n# attack-chain section (the entry point is its first step); it is NOT additionally required to\r\n# contain the literal word \"entry\" — the instruction asks for \"attack chain, evidence, entities,\r\n# persistence, impact\", and a report that names the entry via a MITRE technique such as\r\n# \"Exploitation of Remote Services (T1210)\" or \"Initial Access\" must not fail a shape check.\r\n# Entry-point QUALITY is scored on the detection axis (chain step 1 / discovery), not here.\r\nREQUIRED_SECTIONS = {\r\n    \"intrusion-report.md\": (\"chain\",),                # attack chain (entry point = its step 1)\r\n    \"vuln-report.md\":      (\"vuln\",),                 # a vulnerability section\r\n    \"baseline-report.md\":  (\"baseline\",),             # baseline weaknesses\r\n    \"remediation-plan.md\": (\"remediat\",),             # a remediation plan\r\n}\r\n\r\n\r\ndef _headings(text: str) -> str:\r\n    return \"\\n\".join(l for l in text.splitlines() if l.lstrip().startswith(\"#\")).lower()\r\n\r\n\r\n@criterion(description=\"each report contains its required sections\", required_pass=True)\r\ndef required_sections(workspace: Path) -> bool:\r\n    for name, needles in REQUIRED_SECTIONS.items():\r\n        p = workspace / name\r\n        if not p.exists():\r\n            return False\r\n        blob = p.read_text(errors=\"replace\").lower()\r\n        heads = _headings(blob)\r\n        for n in needles:\r\n            alts = (n,) if isinstance(n, str) else n\r\n            if not any(a in heads or a in blob for a in alts):\r\n                return False\r\n    return True\r\n"]
[91.129896, "o", "\u001b[?2004hroot@454259a7e7a2:/app# "]
[103.866105, "i", "cat /app/task/tests/rewardkit/__main__.py\n"]
[103.867215, "o", "cat /app/task/tests/rewardkit/__main__.py"]
[103.867236, "o", "\r\n\u001b[?2004l\r"]
[103.867933, "o", "\"\"\"CLI: `python -m rewardkit --tests DIR [--app DIR --disk DIR --sas DIR]`.\r\n\r\nInvoked by tests/test.sh inside the Harbor container. Scores /app against the range's\r\nmanifest and writes reward.json (+ reward-details.json), then prints reward.json to stdout.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport json\r\nimport sys\r\n\r\nfrom rewardkit.runner import run\r\n\r\n\r\ndef main(argv=None) -> int:\r\n    ap = argparse.ArgumentParser(prog=\"rewardkit\", description=__doc__)\r\n    ap.add_argument(\"--tests\", default=\"/tests\", help=\"tests directory (manifest + criteria)\")\r\n    ap.add_argument(\"--app\", default=\"/app\", help=\"agent workspace (the reports to score)\")\r\n    ap.add_argument(\"--disk\", default=\"/disk\", help=\"forensic-image evidence root\")\r\n    ap.add_argument(\"--sas\", default=\"/sas\", help=\"security-product feed evidence root\")\r\n    args = ap.parse_args(argv)\r\n\r\n    reward = run(args.tests, args.app, args.disk, args.sas)\r\n    json.dump(reward, sys.stdout, indent=2)\r\n    sys.stdout.write(\"\\n\")\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[103.868273, "o", "\u001b[?2004h"]
[103.868298, "o", "root@454259a7e7a2:/app# "]
[104.043382, "i", "cat /app/task/tests/rewardkit/__init__.py\n"]
[104.043984, "o", "cat /app/task/tests/rewardkit/__init__.py\r\n\u001b[?2004l\r"]
[104.044696, "o", "\"\"\"rewardkit — the reward substrate the DFIR verifier is written against.\r\n\r\nThis is a real, self-contained implementation of the (previously fictional) `harbor-rewardkit`\r\nAPI the criterion files use: the `@criterion` decorator, the `rk.shared.<name>` namespace of\r\nshared helpers, and the `rk.<name>(...)` registrars for parametrized criteria\r\n(`rk.discovered`, `rk.step_verified`, `rk.silent_artifact_recall`). The scoring/aggregation\r\nloop lives in `runner.py`; the Tier-3 judge adapter in `judge.py`.\r\n"]
[104.044769, "o", "\r\nDesign notes:\r\n- `@criterion(shared=True)` registers a helper on `shared` (callable as `rk.shared.<name>`).\r\n- `@criterion(...)` (non-shared) registers a criterion *definition*. A definition with no\r\n  required parameters beyond `workspace` is auto-scheduled to run once; a definition that\r\n  takes extra required parameters (e.g. `discovered(workspace, chk, artifact)`) is a template\r\n"]
[104.044819, "o", "  scheduled explicitly via `rk.<name>(...)`.\r\n- `rk.<name>(...)` schedules one instance of criterion `<name>` with bound args + a weight.\r\n- Instance dedup key is (name, positional-args). An explicit registration overrides an\r\n  auto-scheduled one for the same key (this is how `rk.silent_artifact_recall(weight=0.0)`\r\n  turns the auto-scheduled headline metric into a reported-but-unweighted one).\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport inspect\r\n\r\n\r\nclass _Shared:\r\n    \"\"\"Namespace object populated by @criterion(shared=True); reached as rk.shared.<name>.\"\"\"\r\n\r\n\r\nshared = _Shared()\r\n\r\n# name -> {\"fn\", \"description\", \"required_pass\", \"group\"}\r\n_defs: dict = {}\r\n# (name, args_tuple) -> {\"name\",\"args\",\"kwargs\",\"weight\",\"auto\",\"group\"}\r\n_instances: dict = {}\r\n_current_group = None\r\n\r\n\r\ndef _reset() -> None:\r\n"]
[104.044963, "o", "    \"\"\"Clear all state (the runner calls this before each run).\"\"\"\r\n    global _current_group\r\n    _defs.clear()\r\n    _instances.clear()\r\n    for k in [k for k in vars(shared)]:\r\n        delattr(shared, k)\r\n    _current_group = None\r\n\r\n\r\ndef _set_group(group) -> None:\r\n    global _current_group\r\n    _current_group = group\r\n\r\n\r\ndef _required_extra(fn) -> list:\r\n    \"\"\"Required positional parameters beyond the leading `workspace` (no default, not *args).\"\"\"\r\n    params = list(inspect.signature(fn).parameters.values())[1:]\r\n    return [p for p in params\r\n            if p.default is inspect._empty\r\n            and p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)]\r\n\r\n\r\ndef criterion(_fn=None, *, shared=False, description=None, weight=1.0,\r\n              required_pass=False, **_extra):\r\n    \"\"\"Register a criterion (or, with shared=True, a shared helper).\"\"\"\r\n    def deco(fn):\r\n        if shared:\r\n            setattr(globals()[\"shared\"], fn.__name__, fn)\r\n            return fn\r\n        _defs[fn.__name__] = {\r\n            \"fn\": fn, \"description\": description,\r\n            \"required_pass\": required_pass, \"group\": _current_group,\r\n        }\r\n        if not _required_extra(fn):          # runnable with only `workspace` → auto-schedule\r\n            _schedule(fn.__name__, (), {}, weight, auto=True)\r\n        return fn\r\n    return deco(_fn) if _fn is not None else deco\r\n\r\n\r\ndef _schedule(name, args, kwargs, weight, auto) -> None:\r\n    key = (name, tuple(args))\r\n    existing = _instances.get(key)\r\n    if existing is not None and not existing[\"auto\"] and auto:\r\n        return                               # never let an auto instance clobber an explicit one\r\n    _instances[key] = {\r\n        \"name\": name, \"args\": tuple(args), \"kwargs\": dict(kwargs),\r\n        \"weight\": weight, \"auto\": auto, \"group\": _current_group,\r\n    }\r\n\r\n\r\ndef __getattr__(name):\r\n    \"\"\"Any unknown attribute is a registrar: rk.discovered(...), rk.step_verified(...), etc.\"\"\"\r\n    def register(*args, weight=1.0, **kwargs):\r\n        _schedule(name, args, kwargs, weight, auto=False)\r\n    return register\r\n"]
[104.045207, "o", "\u001b[?2004h"]
[104.045242, "o", "root@454259a7e7a2:/app# "]
