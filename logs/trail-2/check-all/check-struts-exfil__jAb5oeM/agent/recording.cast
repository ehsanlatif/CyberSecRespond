[31.17553, "o", "\r\n  \"range_id\": \"struts-exfil\",\r\n  \"difficulty\": 4,\r\n  \"alert_coverage\": 0.67,\r\n  \"platform\": {\r\n    \"os\": \"rhel\",\r\n    \"version\": \"9\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1190\",\r\n      \"desc\": \"Struts2 OGNL RCE (CVE-2023-50164)\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1505.003\",\r\n      \"desc\": \"JSP webshell planted\",\r\n      \"depends_on\": [\r\n        1\r\n      ]"]
[31.175575, "o", "\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1059.004\",\r\n      \"desc\": \"shell execution\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1560.001\",\r\n      \"desc\": \"stage archive for exfil\",\r\n      \"depends_on\": [\r\n        3"]
[31.1756, "o", "\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1048\",\r\n      \"desc\": \"exfiltrate over HTTPS\",\r\n      \"depends_on\": [\r\n        4\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n      \"attck\": \"T1098.004\",\r\n      \"desc\": \"authorized_keys backdoor\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n"]
[31.175732, "o", "      \"step\": 7,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },"]
[31.175888, "o", "\r\n    {\r\n      \"step\": 8,\r\n      \"attck\": \"T1070.002\",\r\n      \"desc\": \"selective auth-log wipe\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/opt/tomcat/webapps/ROOT/static/upload.jsp\",\r\n      \"kind\": \"webshell\",\r\n      \"capability\": \"VUL-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"cve\": \"CVE-2023-50164\",\r\n      \"attck\": \"T1190\",\r\n      \"match\": [\r\n        \"jsp\",\r\n        \"ognl\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/tmp/.cache/dump.tar.gz\",\r\n      \"kind\": \"exfil-archive\",\r\n      \"capability\": \"ENT-F01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1560.001\",\r\n      \"match\": [\r\n        \"tar\",\r\n        \"dump\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/root/.ssh/authorized_keys\",\r\n      \"kind\": \"ssh-key-backdoor\",\r\n      \"capability\": \"PER-K01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1098.004\",\r\n      \"match\": [\r\n        \"ssh-ed25519\",\r\n        \"attacker\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/var/spool/cron/tomcat\",\r\n      \"kind\": \"cron\",\r\n      \"capability\": \"PER-S01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1053.003\",\r\n      \"match\": [\r\n        \"curl\",\r\n        \"beacon\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/opt/tomcat/lib/struts2-core.jar\",\r\n      \"kind\": \"vulnerable-lib\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"struts2\",\r\n        \"2.5\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"path\": \"/var/log/tomcat/access-exfil.log\",\r\n      \"kind\": \"exfil-endpoint\",\r\n      \"capability\": \"ENT-N01\",\r\n      \"alerted\": false,\r\n      \"weight\": 1.5,\r\n      \"attck\": \"T1048\",\r\n      \"match\": [\r\n        \"POST\",\r\n        \"exfil\"\r\n      ]\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"block the exfil destination and attacker IP at the egress firewall\",\r\n      \"verify\": \"iptables -L OUTPUT -n | grep <ip>\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"quarantine upload.jsp and its drop directory\",\r\n      \"verify\": \"! test -f /opt/tomcat/webapps/ROOT/static/upload.jsp\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"action\": \"remove the staged exfil archive\",\r\n      \"verify\": \"! test -f /tmp/.cache/dump.tar.gz\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"action\": \"remove the attacker key from /root/.ssh/authorized_keys\",\r\n      \"verify\": \"! grep -q attacker /root/.ssh/authorized_keys\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"remove the tomcat cron entry\",\r\n      \"verify\": \"! test -f /var/spool/cron/tomcat\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"action\": \"upgrade struts2 past the fixed release\",\r\n      \"verify\": \"rpm -q struts2 shows a patched version\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"action\": \"rotate application, root, and any exfiltrated credentials\",\r\n      \"verify\": \"credential rotation timestamps are recent\",\r\n      \"phase\": \"rotate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-21\",\r\n      \"action\": \"confirm the OGNL exploit path no longer executes\",\r\n      \"verify\": \"replay a benign probe and confirm it is rejected\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-22\",\r\n      \"action\": \"restart tomcat and confirm service health\",\r\n      \"verify\": \"systemctl is-active tomcat and HTTP 200 on /\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    }\r\n  ],\r\n  \"precedence\": [\r\n    \"contain\",\r\n    \"eradicate\",\r\n    \"harden\",\r\n    \"rotate\",\r\n    \"verify\"\r\n  ],\r\n  \"no_cve_entry\": false,\r\n  \"decoys\": [\r\n    {\r\n"]
