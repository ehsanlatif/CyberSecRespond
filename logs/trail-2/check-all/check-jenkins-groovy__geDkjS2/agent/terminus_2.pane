Run `python3 build_disk.py tasks/<range>` after generation to synthesise the forensic image here (+ sha256) and augment `sas-mock/` with the CTI/handoff materials. The Docker build (context = this directory) bakes it read-only at `/disk`; `sas-mock/` is baked at `/sas`.

Every path cited in `tests/manifest.json` must exist inside the image (QA gate: manifest ↔ disk 100%).
[?2004hroot@2e703238ddb6:/app# cat /app/task/task.toml
[?2004lschema_version = "1.4"

[task]
name        = "dfir-eval/jenkins-groovy"
version     = "1.0.0"
description = "Post-compromise forensics: Ubuntu 22.04 Jenkins controller breached via an authenticated RCE, Groovy init backdoor and SSH key planted, cryptominer dropped, log wipe."
authors     = [{ name = "DFIR Synthetic Corpus" }]
keywords    = ["security", "dfir", "incident-response", "long-horizon"]

[metadata]
author_name  = "DFIR Synthetic Corpus"
author_email = ""
difficulty   = "hard"
category     = "security"
tags         = ["security", "dfir", "incident-response", "long-horizon"]

[agent]
timeout_sec = 3600.0

[verifier]
timeout_sec = 900.0

[verifier.env]
# Tier-3 LLM judge (OPTIONAL). ${VAR:-} = empty default, so a missing var does NOT block the
# run (Harbor would treat a bare ${VAR} as required) — the judge degrades to Tier 1+2. To
# enable it: export REWARDKIT_JUDGE=anthropic/claude-opus-5 and ANTHROPIC_API_KEY before running.
ANTHROPIC_API_KEY = "${ANTHROPIC_API_KEY:-}"
REWARDKIT_JUDGE   = "${REWARDKIT_JUDGE:-}"

[environment]
# Analysis machine is Linux regardless of the victim OS in the forensic image at /disk.
os                = "linux"
build_timeout_sec = 900.0
