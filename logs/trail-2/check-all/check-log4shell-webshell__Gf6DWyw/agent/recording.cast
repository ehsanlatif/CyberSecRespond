[25.425402, "o", "\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1543.002\"\r\n    },"]
[25.425441, "o", "\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/var/lib/tomcat9/webapps/ROOT/static/.helper.jsp\",\r\n      \"kind\": \"webshell-secondary\",\r\n      \"capability\": \"PER-W01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1505.003\",\r\n      \"match\": [\r\n        \"jsp\",\r\n        \"webshell\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"path\": \"/opt/app/log4j2.xml\",\r\n      \"kind\": \"vulnerable-config\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"log4j\",\r\n        \"2.14\"\r\n      ]\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"block attacker source IP inbound at the edge\",\r\n      \"verify\": \"iptables -L INPUT -n | grep <ip>\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"quarantine the JSP webshell and remove the drop directory\",\r\n      \"verify\": \"! test -f /var/lib/tomcat9/webapps/ROOT/static/status.jsp\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"action\": \"terminate the reverse-shell process\",\r\n      \"verify\": \"pgrep -f .sysd returns empty\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"action\": \"remove /etc/cron.d/apache-cache\",\r\n      \"verify\": \"! test -f /etc/cron.d/apache-cache\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"disable and remove apache-cache.service\",\r\n      \"verify\": \"systemctl is-enabled apache-cache 2>&1 | grep -qv enabled\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"action\": \"remove the secondary .helper.jsp webshell\",\r\n      \"verify\": \"! test -f /var/lib/tomcat9/webapps/ROOT/static/.helper.jsp\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"action\": \"upgrade log4j past 2.15 and disable JNDI lookups\",\r\n      \"verify\": \"grep -L 'log4j-core-2.1[0-4]' /opt/app/log4j2.xml\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"action\": \"rotate application and service-account credentials\",\r\n      \"verify\": \"credential rotation timestamp is recent\",\r\n      \"phase\": \"rotate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-21\",\r\n      \"action\": \"confirm the exploit path no longer returns a shell\",\r\n      \"verify\": \"replay a benign JNDI probe and confirm it is refused\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-22\",\r\n      \"action\": \"restart the web service and confirm health\",\r\n      \"verify\": \"systemctl is-active tomcat9 and HTTP 200 on /\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    }\r\n  ],\r\n  \"precedence\": [\r\n    \"contain\",\r\n    \"eradicate\",\r\n    \"harden\",\r\n    \"rotate\",\r\n    \"verify\"\r\n  ],\r\n  \"no_cve_entry\": false,\r\n  \"decoys\": [\r\n    {\r\n      \"path\": \"/etc/cron.d/backup-nightly\",\r\n      \"looks_malicious\": true,\r\n      \"benign\": true\r\n    }\r\n  ],\r\n  \"signature\": \"ce1cc99945b1\"\r\n}\r\n"]
