[25.425075, "o", "\r\n  \"range_id\": \"log4shell-webshell\",\r\n  \"difficulty\": 3,\r\n  \"alert_coverage\": 0.67,\r\n  \"platform\": {\r\n    \"os\": \"ubuntu\",\r\n    \"version\": \"22.04\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1190\",\r\n      \"desc\": \"Log4Shell RCE (CVE-2021-44228)\"\r\n    },\r\n    {\r\n"]
[25.425119, "o", "      \"step\": 2,\r\n      \"attck\": \"T1505.003\",\r\n      \"desc\": \"JSP webshell planted\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1059.004\",\r\n"]
[25.425171, "o", "      \"desc\": \"reverse shell execution\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,"]
[25.425206, "o", "\r\n      \"attck\": \"T1543.002\",\r\n      \"desc\": \"systemd persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n"]
[25.425238, "o", "      \"attck\": \"T1070.006\",\r\n      \"desc\": \"timestomp webshell\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/var/lib/tomcat9/webapps/ROOT/static/status.jsp\",\r\n      \"kind\": \"webshell\",\r\n      \"capability\": \"VUL-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"cve\": \"CVE-2021-44228\",\r\n      \"attck\": \"T1190\",\r\n"]
[25.425286, "o", "      \"match\": [\r\n        \"jndi\",\r\n        \"ldap\",\r\n        \"webshell\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/tmp/.sysd\","]
[25.425325, "o", "\r\n      \"kind\": \"reverse-shell\",\r\n      \"capability\": \"ENT-P01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1059.004\","]
