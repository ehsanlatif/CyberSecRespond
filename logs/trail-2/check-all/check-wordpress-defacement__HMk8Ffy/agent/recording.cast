[16.62606, "o", "# tests/reward.toml  (FIXED — aggregate keys; per-dimension keys are never collapsed)\r\n[[reward]]\r\nname = \"detection\""]
[16.626271, "o", "\r\naggregation = \"weighted_mean\"\r\n\r\n[[reward]]\r\nname = \"plan\"\r\naggregation = \"weighted_mean\"\r\n\r\n[[reward]]\r\nname = \"quality\"           # Q-dimension judge items; reported, eval-only by default (doc 02 §6 Q2)\r\naggregation = \"weighted_mean\"\r\n\r\n[[reward]]"]
[16.626315, "o", "\r\nname = \"reward\"            # Harbor's parsed score\r\naggregation = \"threshold\"  # both axes >= 0.70 (never a sum of the two — doc 00 non-negotiable #2)\r\n"]
