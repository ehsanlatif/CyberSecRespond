from pathlib import Path

import rewardkit as rk
from rewardkit import criterion

from criteria import _detected_chks, _step_block_for


@criterion(description="every detected artifact has a remediation step")
def plan_covers_findings(workspace: Path) -> float:
    """Plan coverage is deliberately COUPLED to detection — the denominator is the set of
    *detected* CHKs, so an undetected finding earns no plan credit. This diverges from the
    published SecRespond rubric (which credits generic hardening independently) and is why
    we do not reproduce cells like ssh-miner CHK-03 0.00/1.00 (doc 04 §3). It measures
    detect-then-abandon directly."""
    m = rk.shared._manifest(workspace)
    findings = rk.shared._findings(workspace)
    detected = _detected_chks(findings, m)
    if not detected:
        return 0.0
    # Only artifacts that HAVE a manifest remediation entry are remediable. Detection-only
    # forensic evidence (e.g. cleared-log residue) has no remediation and must not count
    # against coverage — otherwise the oracle itself, which correctly leaves it alone, would
    # be penalised.
    remediable = {r["chk"] for r in m.get("remediation", [])}
    by_chk = {a["chk"]: a for a in m["artifacts"]}
    targets = [chk for chk in detected if chk in remediable and chk in by_chk]
    if not targets:
        return 1.0  # nothing detected was remediable → coverage vacuously satisfied
    plan = (workspace / "remediation-plan.md").read_text(errors="replace")
    covered = sum(1 for chk in targets if _step_block_for(plan, by_chk[chk]))
    return covered / len(targets)
# tests/planning/ordering.py  (FIXED — Tier 2, precedence violations)
from pathlib import Path

import rewardkit as rk
from rewardkit import criterion

from criteria import _count_precedence_violations, _ordered_steps

# Precedence rules the plan must respect are read from the manifest:
#   contain -> eradicate -> harden -> rotate -> verify


@criterion(description="remediation plan has no precedence violations")
def ordering_ok(workspace: Path) -> float:
    plan = (workspace / "remediation-plan.md").read_text(errors="replace")
    steps = _ordered_steps(plan)
    precedence = rk.shared._manifest(workspace)["precedence"]
    viol = _count_precedence_violations(steps, precedence)
    return max(0.0, 1.0 - viol / max(len(steps), 1))
# tests/planning/verification.py  (GENERATED by the task generator from manifest.json)
# One criterion per remediation entry: does the plan block for this finding contain a
# verification action? (doc 02 §3.3)
from pathlib import Path

import rewardkit as rk
from rewardkit import criterion

from criteria import VERIFY_TOKENS, _step_block_for


@criterion(description="remediation step for {chk} includes a verification action")
def step_verified(workspace: Path, chk: str) -> bool:
    m = rk.shared._manifest(workspace)
    rem = next((r for r in m["remediation"] if r["chk"] == chk), None)
    art = next((a for a in m["artifacts"] if a["chk"] == chk), None)
    plan = (workspace / "remediation-plan.md").read_text(errors="replace")
    # Locate the plan block: by artifact if this CHK is an artifact, else by action text.
    key = art if art else {"path": (rem or {}).get("action", chk), "match": [chk]}
    block = _step_block_for(plan, key)
    return bool(block) and any(v in block.lower() for v in VERIFY_TOKENS)


# --- registrations (one per remediation entry) ---

rk.step_verified("CHK-20", weight=1.0)
rk.step_verified("CHK-01", weight=1.0)
rk.step_verified("CHK-02", weight=1.0)
