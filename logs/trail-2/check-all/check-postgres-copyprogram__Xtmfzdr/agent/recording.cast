[64.513613, "o", "{\r\n  \"range_id\": \"postgres-copyprogram\",\r\n  \"difficulty\": 4,\r\n  \"alert_coverage\": 0.5,\r\n  \"platform\": {\r\n    \"os\": \"centos\",\r\n    \"version\": \"stream-9\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1078\",\r\n      \"desc\": \"valid accounts (weak postgres superuser)\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1059.004\",\r\n      \"desc\": \"COPY TO PROGRAM shell execution\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1048.003\",\r\n      \"desc\": \"DNS-tunnel exfiltration\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1543.002\",\r\n      \"desc\": \"systemd persistence\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n      \"attck\": \"T1070.006\",\r\n      \"desc\": \"timestomp dropped files\",\r\n"]
