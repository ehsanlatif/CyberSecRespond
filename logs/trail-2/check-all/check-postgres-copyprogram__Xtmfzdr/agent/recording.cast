[139.346086, "o", "cat /app/task/task.toml\r\n\u001b[?2004l\r"]
[139.346679, "o", "schema_version = \"1.4\"\r\n\r\n[task]\r\nname        = \"dfir-eval/postgres-copyprogram\"\r\nversion     = \"1.0.0\"\r\ndescription = \"Post-compromise forensics: CentOS Stream 9 host with a weak-credential PostgreSQL abused via COPY TO PROGRAM, DNS-tunnel exfiltration, cron and systemd persistence, timestomping.\"\r\nauthors     = [{ name = \"DFIR Synthetic Corpus\" }]\r\nkeywords    = [\"security\", \"dfir\", \"incident-response\", \"long-horizon\"]\r\n\r\n[metadata]\r\nauthor_name  = \"DFIR Synthetic Corpus\"\r\nauthor_email = \"\"\r\ndifficulty   = \"hard\"\r\ncategory     = \"security\"\r\ntags         = [\"security\", \"dfir\", \"incident-response\", \"long-horizon\"]\r\n\r\n[agent]\r\ntimeout_sec = 3600.0\r\n\r\n[verifier]\r\ntimeout_sec = 900.0\r\n\r\n[verifier.env]\r\n# Tier-3 LLM judge (OPTIONAL). ${VAR:-} = empty default, so a missing var does NOT block the\r\n# run (Harbor would treat a bare ${VAR} as required) — the judge degrades to Tier 1+2. To\r\n# enable it: export REWARDKIT_JUDGE=anthropic/claude-opus-5 and ANTHROPIC_API_KEY before running.\r\nANTHROPIC_API_KEY = \"${ANTHROPIC_API_KEY:-}\"\r\nREWARDKIT_JUDGE   = \"${REWARDKIT_JUDGE:-}\"\r\n\r\n[environment]\r\n# Analysis machine is Linux regardless of the victim OS in the forensic image at /disk.\r\nos                = \"linux\"\r\nbuild_timeout_sec = 900.0\r\n"]
[139.34689, "o", "\u001b[?2004hroot@a7143e8cfe39:/app# "]
