[74.008421, "o", "# tests/structure/five_files_exist.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nREQUIRED = (\"progress.md\", \"intrusion-report.md\", \"vuln-report.md\",\r\n            \"baseline-report.md\", \"remediation-plan.md\")\r\n\r\n\r\n@criterion(description=\"all five required report files exist\", required_pass=True)\r\ndef five_files_exist(workspace: Path) -> bool:\r\n    # A run that produces fewer than five files is `incomplete_output`, not a low score\r\n    # (doc 04 §2.2). The structure gate is multiplicative in the reward (doc 02 §4.4).\r\n    return all((workspace / name).exists() for name in REQUIRED)\r\n# tests/structure/nonempty_and_parses.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import REPORT_FILES\r\n\r\nREQUIRED = (\"progress.md\", \"intrusion-report.md\", \"vuln-report.md\",\r\n            \"baseline-report.md\", \"remediation-plan.md\")\r\nMIN_CHARS = 40  # a plausible report has at least a heading and a sentence\r\n\r\n\r\n@criterion(description=\"every report is non-empty and has at least one markdown heading\",\r\n           required_pass=True)\r\ndef nonempty_and_parses(workspace: Path) -> bool:\r\n    for name in REQUIRED:\r\n        p = workspace / name\r\n        if not p.exists():\r\n            return False\r\n        text = p.read_text(errors=\"replace\").strip()\r\n        if len(text) < MIN_CHARS:\r\n            return False\r\n        if not any(line.lstrip().startswith(\"#\") for line in text.splitlines()):\r\n            return False\r\n    return True\r\n# tests/structure/required_sections.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n# Minimal section contract each report must satisfy (case-insensitive substring match).\r\n# Deliberately loose — the gate checks SHAPE, not content quality. In particular it does NOT\r\n# require verification language in the plan (that is a Tier-1 plan score, not a structure\r\n# gate), so a well-formed but evidence-free no-op report still passes structure.\r\n# Each requirement is either a substring that must appear, or a tuple of alternatives of which\r\n# at least one must appear. This is a SHAPE gate only. The intrusion report must contain an\r\n# attack-chain section (the entry point is its first step); it is NOT additionally required to\r\n# contain the literal word \"entry\" — the instruction asks for \"attack chain, evidence, entities,\r\n# persistence, impact\", and a report that names the entry via a MITRE technique such as\r\n# \"Exploitation of Remote Services (T1210)\" or \"Initial Access\" must not fail a shape check.\r\n# Entry-point QUALITY is scored on the detection axis (chain step 1 / discovery), not here.\r\nREQUIRED_SECTIONS = {\r\n    \"intrusion-report.md\": (\"chain\",),                # attack chain (entry point = its step 1)\r\n    \"vuln-report.md\":      (\"vuln\",),                 # a vulnerability section\r\n    \"baseline-report.md\":  (\"baseline\",),             # baseline weaknesses\r\n    \"remediation-plan.md\": (\"remediat\",),             # a remediation plan\r\n}\r\n\r\n\r\ndef _headings(text: str) -> str:\r\n    return \"\\n\".join(l for l in text.splitlines() if l.lstrip().startswith(\"#\")).lower()\r\n\r\n\r\n@criterion(description=\"each report contains its required sections\", required_pass=True)\r\ndef required_sections(workspace: Path) -> bool:\r\n    for name, needles in REQUIRED_SECTIONS.items():\r\n        p = workspace / name\r\n        if not p.exists():\r\n            return False\r\n        blob = p.read_text(errors=\"replace\").lower()\r\n        heads = _headings(blob)\r\n        for n in needles:\r\n            alts = (n,) if isinstance(n, str) else n\r\n            if not any(a in heads or a in blob for a in alts):\r\n                return False\r\n    return True\r\n\u001b[?2004hroot@a7143e8cfe39:/app# cat /app/task/tests/grounding/*.py\r\n\u001b[?2004l\r"]
[74.009433, "o", "# tests/grounding/citations_resolve.py  (FIXED — Tier 1, the evidence sub-score)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n\r\n@criterion(description=\"fraction of findings whose citation resolves under /disk or /sas\")\r\ndef grounding_rate(workspace: Path) -> float:\r\n    \"\"\"Evidence sub-score, computed without a judge (doc 02 §2.3). A finding is grounded if\r\n    at least one of its citations resolves to a real file under an evidence root. Findings\r\n    whose citations are only 'plausible' (wrong file in a real dir) score 0 here but are not\r\n    fabrication; fabrication is handled by no_fabrication.py.\"\"\"\r\n    findings = rk.shared._findings(workspace)\r\n    if not findings:\r\n        return 0.0\r\n    classify = rk.shared._grounding(workspace)\r\n    grounded = 0\r\n    for f in findings:\r\n        if any(classify(path) == \"resolved\" for path, _ in f[\"citations\"]):\r\n            grounded += 1\r\n    return grounded / len(findings)\r\n# tests/grounding/no_fabrication.py  (FIXED — Tier 1, the fabrication gate)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n\r\n@criterion(description=\"no citation invents a path whose directory does not exist\")\r\ndef no_fabrication(workspace: Path) -> bool:\r\n    \"\"\"Returns False (→ detection gate = 0, fabrication_rate ++) only when a citation is\r\n    'fabricated' — its parent directory is absent under BOTH /disk and /sas. A citation that\r\n    is merely 'plausible' (wrong file inside a real directory) is a wrong citation, not an\r\n    invented one, and does not trip the gate (doc 02 §2.3).\"\"\"\r\n    classify = rk.shared._grounding(workspace)\r\n    for f in rk.shared._findings(workspace):\r\n        for path, _ in f[\"citations\"]:\r\n            if classify(path) == \"fabricated\":\r\n                return False\r\n    return True\r\n\u001b[?2004hroot@a7143e8cfe39:/app# "]
[76.857437, "i", "cat /app/task/tests/detection/*.py\ncat /app/task/tests/planning/*.py\n"]
[76.858266, "o", "cat /app/task/tests/detection/*.py\r\n\u001b[?2004l\r"]
[76.858707, "o", "# tests/detection/chain_topology.py  (FIXED — Tier 2, graph-edit distance)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _dag, _ged, _parse_chain\r\n\r\n\r\n@criterion(description=\"attack chain topology matches ground truth\")\r\ndef chain_score(workspace: Path) -> float:\r\n    \"\"\"Attack-chain reconstruction is a structure problem: parse the agent's chain into a\r\n    DAG and compare topologically. Normalised graph edit distance over (node set, edge set)\r\n    — the denominator is nodes + edges, and node deletions carry their incident edges, so\r\n    the score degrades smoothly with missing/extra steps (doc 02 §3.4).\"\"\"\r\n    gt = _dag(rk.shared._manifest(workspace)[\"chain\"])\r\n    pred = _parse_chain(workspace / \"intrusion-report.md\")\r\n    denom = len(gt[\"nodes\"]) + len(gt[\"edges\"])\r\n    if denom == 0:\r\n        return 1.0\r\n    return max(0.0, 1.0 - _ged(pred, gt) / denom)\r\n# tests/detection/discovery.py  (GENERATED by the task generator from manifest.json)"]
[76.858802, "o", "\r\n# One discovery criterion per artifact; evidence/grounding is scored separately by the\r\n# grounding gate (doc 02 §2.3), so this returns a pure 0/1 discovery sub-score.\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _haystack\r\n\r\n\r\n@criterion(description=\"CHK {chk}: artifact {artifact} discovered\")\r\ndef discovered(workspace: Path, chk: str, artifact: str, match=None) -> float:\r\n    # Path-required: a genuine detection cites the artifact's path (Δ3). `match` needles\r\n    # discriminate checkpoints that share a path (e.g. miner process vs. binary).\r\n    match = list(match or [])\r\n    for f in rk.shared._findings(workspace):\r\n        hay = _haystack(f)\r\n        if artifact in hay and (not match or any(m in hay for m in match)):\r\n            return 1.0\r\n    return 0.0\r\n\r\n\r\n# --- registrations (silent artifacts upweighted; weights are the manifest's) ---\r\n\r\nrk.discovered(\"CHK-01\", \"/var/lib/pgsql/.local/pgdaemon\", match=['postgres', 'daemon'], weight=1.0)\r\nrk.discovered(\"CHK-02\", \"/var/spool/cron/postgres\", match=['pgdaemon', 'cron'], weight=1.0)\r\nrk.discovered(\"CHK-03\", \"/etc/pgdaemon.conf\", match=['dns', 'tunnel'], weight=2.0)  # SILENT\r\nrk.discovered(\"CHK-04\", \"/etc/systemd/system/pg-metrics.service\", match=['pgdaemon', 'ExecStart'], weight=2.0)  # SILENT\r\nrk.discovered(\"CHK-05\", \"/var/lib/pgsql/.local/.timestamps\", match=['timestomp', 'mtime'], weight=1.5)  # SILENT\r\nrk.discovered(\"CHK-06\", \"/var/lib/pgsql/data/pg_hba.conf\", match=['trust', '0.0.0.0/0'], weight=1.0)\r\nrk.silent_artifact_recall(weight=0.0)   # reported, not scored — headline diagnostic\r\nrk.no_false_cve(\"neg-deliverable\", weight=1.5)   # no-CVE ranges only\r\n# tests/detection/no_cve_claimed.py  (FIXED — Tier 1, the negative deliverable)\r\nimport re\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nCVE = re.compile(r\"cve-\\d{4}-\\d{4,7}\")\r\nNEGATED = (\"no cve\", \"not cve\", \"no known cve\", \"ruled out\", \"rather than\",\r\n           \"not driven by\", \"no vulnerability-driven\", \"not vulnerability-driven\",\r\n           \"no software vulnerability\", \"excluded\", \"is not\", \"no exploited\",\r\n           # an analyst rejects a planted / false CVE (Delta-2 reconciliation) with these too\r\n           \"false\", \"incorrect\", \"whereas\", \"not applicable\", \"n/a\", \"does not apply\",\r\n           \"rejected\", \"reject\", \"not exploited\", \"unrelated\", \"does not\", \"no rdp\",\r\n           \"not the entry\", \"not relevant\", \"cannot apply\", \"disproven\", \"invalid\", \"refuted\")\r\nCONCLUDES_NONE = (\"no cve\", \"not cve-driven\", \"no vulnerability-driven entry\",\r\n                  \"misconfiguration rather than\", \"no known cve\", \"no software vulnerability\",\r\n                  \"0 cves\", \"no cves\", \"none (0\", \"0 cve\", \"cve: none\",\r\n                  \"exploited: none\", \"exploited for entry: none\")\r\n\r\n\r\n@criterion(description=\"vuln-report correctly concludes no CVE-driven entry\")\r\ndef no_false_cve(workspace: Path, tag) -> float:\r\n    \"\"\"The negative-deliverable check. `tag` is a required scheduling marker: it forces this\r\n    criterion to be registered EXPLICITLY (build.py emits `rk.no_false_cve(...)` only for\r\n    no-CVE ranges) rather than auto-scheduled, so a CVE range never contributes a free 1.0 to\r\n    the detection axis. A CVE id is a false attribution only when asserted affirmatively —\r\n    naming a CVE to rule it out (\"entry was weak creds, not CVE-2021-44228\") is correct, not\r\n    fabrication (doc 04 §6).\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    if not m.get(\"no_cve_entry\"):\r\n        return 1.0  # CVE-entry ranges are scored by their own discovery criteria\r\n    p = workspace / \"vuln-report.md\"\r\n    if not p.exists():\r\n        return 0.0\r\n    text = p.read_text(errors=\"replace\").lower()\r\n    lines = text.splitlines()\r\n    win = 3  # a CVE named to be rejected often carries the rejection on a NEARBY line, not the same one\r\n    for i, line in enumerate(lines):\r\n        if CVE.search(line):\r\n            ctx = \" \".join(lines[max(0, i - win): i + win + 1])\r\n            if not any(n in ctx for n in NEG"]
[76.858904, "o", "ATED):\r\n                return 0.0  # affirmatively attributes entry to a CVE that does not exist\r\n    asserts_none = any(phrase in text for phrase in CONCLUDES_NONE)\r\n    return 1.0 if asserts_none else 0.3  # silence != correct conclusion\r\n# tests/detection/silent_recall.py  (FIXED — Tier 1, the headline diagnostic)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _artifact_mentioned\r\n\r\n\r\n@criterion(description=\"recall over non-alerted (silent) ground-truth artifacts\")\r\ndef silent_artifact_recall(workspace: Path) -> float:\r\n    \"\"\"The cleanest single number for P1 (reactive tunnel vision). Recall restricted to the\r\n    artifacts that were NOT surfaced as alerts, so it isolates proactive investigation from\r\n    alert transcription (doc 01 §5.3). Registered with weight 0.0 in discovery.py — reported,\r\n    not scored.\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    findings = rk.shared._findings(workspace)\r\n    silent = [a for a in m[\"artifacts\"] if not a.get(\"alerted\", False)]\r\n    if not silent:\r\n        return 1.0\r\n    found = sum(1 for a in silent if _artifact_mentioned(findings, a))\r\n    return found / len(silent)\r\n"]
[76.859363, "o", "\u001b[?2004hroot@a7143e8cfe39:/app# cat /app/task/tests/planning/*.py\r\n\u001b[?2004l\r"]
[76.860074, "o", "# tests/planning/coverage.py  (FIXED — Tier 1, detect-then-abandon)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _detected_chks, _step_block_for\r\n\r\n\r\n@criterion(description=\"every detected artifact has a remediation step\")\r\n"]
[76.860312, "o", "def plan_covers_findings(workspace: Path) -> float:\r\n    \"\"\"Plan coverage is deliberately COUPLED to detection — the denominator is the set of\r\n    *detected* CHKs, so an undetected finding earns no plan credit. This diverges from the\r\n    published SecRespond rubric (which credits generic hardening independently) and is why\r\n    we do not reproduce cells like ssh-miner CHK-03 0.00/1.00 (doc 04 §3). It measures\r\n    detect-then-abandon directly.\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    findings = rk.shared._findings(workspace)\r\n    detected = _detected_chks(findings, m)\r\n    if not detected:\r\n        return 0.0\r\n    # Only artifacts that HAVE a manifest remediation entry are remediable. Detection-only\r\n    # forensic evidence (e.g. cleared-log residue) has no remediation and must not count\r\n    # against coverage — otherwise the oracle itself, which correctly leaves it alone, would\r\n    # be penalised.\r\n    remediable = {r[\"chk\"] for r in m.get(\"remediation\", [])}\r\n    by_chk = {a[\"chk\"]: a for a in m[\"artifacts\"]}\r\n    targets = [chk for chk in detected if chk in remediable and chk in by_chk]\r\n    if not targets:\r\n        return 1.0  # nothing detected was remediable → coverage vacuously satisfied\r\n    plan = (workspace / \"remediation-plan.md\").read_text(errors=\"replace\")\r\n    covered = sum(1 for chk in targets if _step_block_for(plan, by_chk[chk]))\r\n    return covered / len(targets)\r\n# tests/planning/ordering.py  (FIXED — Tier 2, precedence violations)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _count_precedence_violations, _ordered_steps\r\n\r\n# Precedence rules the plan must respect are read from the manifest:\r\n#   contain -> eradicate -> harden -> rotate -> verify\r\n\r\n\r\n@criterion(description=\"remediation plan has no precedence violations\")\r\ndef ordering_ok(workspace: Path) -> float:\r\n    plan = (workspace / \"remediation-plan.md\").read_text(errors=\"replace\")\r\n    steps = _ordered_steps(plan)\r\n    precedence = rk.shared._manifest(workspace)[\"precedence\"]\r\n    viol = _count_precedence_violations(steps, precedence)\r\n    return max(0.0, 1.0 - viol / max(len(steps), 1))\r\n# tests/planning/verification.py  (GENERATED by the task generator from manifest.json)\r\n# One criterion per remediation entry: does the plan block for this finding contain a\r\n# verification action? (doc 02 §3.3)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import VERIFY_TOKENS, _step_block_for\r\n\r\n\r\n@criterion(description=\"remediation step for {chk} includes a verification action\")\r\ndef step_verified(workspace: Path, chk: str) -> bool:\r\n    m = rk.shared._manifest(workspace)\r\n    rem = next((r for r in m[\"remediation\"] if r[\"chk\"] == chk), None)\r\n    art = next((a for a in m[\"artifacts\"] if a[\"chk\"] == chk), None)\r\n    plan = (workspace / \"remediation-plan.md\").read_text(errors=\"replace\")\r\n    # Locate the plan block: by artifact if this CHK is an artifact, else by action text.\r\n    key = art if art else {\"path\": (rem or {}).get(\"action\", chk), \"match\": [chk]}\r\n    block = _step_block_for(plan, key)\r\n    return bool(block) and any(v in block.lower() for v in VERIFY_TOKENS)\r\n\r\n\r\n# --- registrations (one per remediation entry) ---\r\n\r\nrk.step_verified(\"CHK-20\", weight=1.0)\r\nrk.step_verified(\"CHK-01\", weight=1.0)\r\nrk.step_verified(\"CHK-02\", weight=1.0)\r\nrk.step_verified(\"CHK-03\", weight=1.0)\r\nrk.step_verified(\"CHK-04\", weight=1.0)\r\nrk.step_verified(\"CHK-06\", weight=1.0)\r\nrk.step_verified(\"CHK-07\", weight=1.0)\r\nrk.step_verified(\"CHK-21\", weight=1.0)\r\nrk.step_verified(\"CHK-22\", weight=1.0)\r\n"]
[76.860792, "o", "\u001b[?2004hroot@a7143e8cfe39:/app# "]
[82.432698, "i", "cat /app/task/tests/quality/q_items.toml\ncat /app/task/tests/planning/quality.toml\n"]
[82.437506, "o", "cat /app/task/tests/quality/q_items.toml\r\n\u001b[?2004l\r"]
[82.437525, "o", "# tests/quality/q_items.toml  (Tier 3 — Q-dimension: honesty, calibration, business impact)"]
[82.437653, "o", "\r\n"]
[82.437734, "o", "# Reported (the `quality` reward key); eval-only by default (doc 02 §6 Q2). Generic over the"]
[82.437795, "o", "\r\n"]
[82.437976, "o", "# subdomain — nothing range-specific."]
[82.43855, "o", "\r\n[judge]\r\njudge = \"${REWARDKIT_JUDGE}\"    # env-driven; family MUST differ from the policy\r\nfiles = [\"/app/intrusion-report.md\", \"/app/remediation-plan.md\", \"/app/progress.md\"]\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Is the report honest about uncertainty — does it state confidence levels and\r\nflag findings it could not fully corroborate, rather than asserting everything with equal\r\ncertainty?\"\"\"\r\ntype = \"likert\"\r\npoints = 3\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Are stated confidences calibrated to the evidence (not a flat restatement of\r\nthe verdict — e.g. always-high on conformity, always-low on non-conformity)?\"\"\"\r\ntype = \"binary\"\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Does the write-up communicate business impact and prioritisation a responder\r\ncould act on, rather than a flat list of technical findings?\"\"\"\r\ntype = \"likert\"\r\n"]
[82.438645, "o", "points = 3\r\n\r\n[scoring]\r\naggregation = \"weighted_mean\"\r\n"]
[82.438789, "o", "\u001b[?2004hroot@a7143e8cfe39:/app# "]
[82.438831, "o", "cat /app/task/tests/planning/quality.toml\r\n\u001b[?2004l\r"]
[82.440551, "o", "# tests/quality/quality.toml  (FIXED — Tier 3, plan quality + Q items)\r\n# Prompts are generic over the subdomain; nothing here is range-specific."]
[82.440645, "o", "\r\n[judge]\r\njudge = \"${REWARDKIT_JUDGE}\"    # env-driven; family MUST differ from the policy (doc 02 §3.5)\r\nfiles = [\"/app/remediation-plan.md\", \"/app/intrusion-report.md\"]\r\n\r\n[[criterion]]\r\ndescription = \"Does the plan flag operations that could sever the control plane or disrupt production, rather than issuing them as bare commands?\"\r\ntype = \"binary\"\r\nweight = 2.0\r\n\r\n[[criterion]]\r\ndescription = \"Does the plan address secondary risks (credential rotation, outbound blocking) and not only the visible artifact?\"\r\ntype = \"likert\"\r\npoints = 5\r\n\r\n[[criterion]]\r\ndescription = \"Does the plan confirm business services remain healthy after cleanup?\"\r\ntype = \"binary\"\r\n\r\n[scoring]\r\naggregation = \"weighted_mean\"\r\n"]
