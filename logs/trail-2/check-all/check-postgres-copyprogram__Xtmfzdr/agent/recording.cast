81782      4 -rw-r--r--   1 502      dialout        83 Aug 16 14:03 /app/task/baselines/alert-transcriber/progress.md\r\n  4982058      4 drwxr-xr-x   2 502      dialout      4096 Aug 16 13:53 /app/task/baselines/noop\r\n  4982092      4 -rw-r--r--   1 502      dialout        99 Aug 16 14:03 /app/task/baselines/noop/baseline-report.md\r\n  4982274      4 -rw-r--r--   1 502      dialout       121 Aug 16 14:03 /app/task/baselines/noop/vuln-report.md\r\n  4982273      4 -rw-r--r--   1 502      dialout       352 Aug 16 14:03 /app/task/baselines/noop/remediation-plan.md\r\n  4982106      4 -rw-r--r--   1 502      dialout       756 Aug 16 14:03 /app/task/baselines/noop/intrusion-report.md\r\n  4982107      4 -rw-r--r--   1 502      dialout        71 Aug 16 14:03 /app/task/baselines/noop/progress.md\r\n  4982275      4 drwxr-xr-x   2 502      dialout      4096 Aug 16 13:53 /app/task/baselines/oracle\r\n  4982276      4 -rw-r--r--   1 502      dialout       217 Aug 16 14:03 /app/task/baselines/oracle/baseline-report.md\r\n  4982280      4 -rw-r--r--   1 502      dialout       376 Aug 16 14:03 /app/task/baselines/oracle/vuln-report.md\r\n  4982279      4 -rw-r--r--   1 502      dialout      1531 Aug 16 14:03 /app/task/baselines/oracle/remediation-plan.md\r\n  4982277      4 -rw-r--r--   1 502      dialout      1168 Aug 16 14:03 /app/task/baselines/oracle/intrusion-report.md\r\n  4982278      4 -rw-r--r--   1 502      dialout       691 Aug 16 14:03 /app/task/baselines/oracle/progress.md\r\n  4982281      4 drwxr-xr-x   3 502      dialout      4096 Aug 16 13:53 /app/task/environment\r\n  4982283      4 -rw-r--r--   1 502      dialout       433 Aug 16 14:03 /app/task/environment/README.md\r\n  4982285      4 -rw-r--r--   1 502      dialout        78 Aug 16 14:28 /app/task/environment/disk.tar.gz.sha256\r\n  4982286      4 drwxr-xr-x   4 502      dialout      4096 Aug 16 14:28 /app/task/environment/sas-mock\r\n  4982288      4 -rw-r--r--   1 502      dialout       141 Aug 16 14:03 /app/task/environment/sas-mock/baseline.json\r\n  4982295      4 drwxr-xr-x   2 502      dialout      4096 Aug 16 14:28 /app/task/environment/sas-mock/handoff\r\n  4982289      4 drwx"]
