ask/baselines/alert-transcriber/remediation-plan.md\r\n/app/task/baselines/alert-transcriber/intrusion-report.md\r\n/app/task/baselines/alert-transcriber/progress.md\r\n/app/task/baselines/noop/baseline-report.md\r\n/app/task/baselines/noop/vuln-report.md\r\n/app/task/baselines/noop/remediation-plan.md\r\n/app/task/baselines/noop/intrusion-report.md\r\n/app/task/baselines/noop/progress.md\r\n/app/task/baselines/oracle/baseline-report.md\r\n/app/task/baselines/oracle/vuln-report.md\r\n/app/task/baselines/oracle/remediation-plan.md\r\n/app/task/baselines/oracle/intrusion-report.md\r\n/app/task/baselines/oracle/progress.md\r\n/app/task/environment/README.md\r\n/app/task/environment/disk.tar.gz.sha256\r\n/app/task/environment/sas-mock/baseline.json\r\n/app/task/environment/sas-mock/handoff/change-ticket.md\r\n/app/task/environment/sas-mock/handoff/findings.schema.json\r\n/app/task/environment/sas-mock/handoff/intake.pdf\r\n/app/task/environment/sas-mock/handoff/findings.partial.json\r\n/app/task/environment/sas-mock/cti/advisory-page-01.png\r\n/app/task/environment/sas-mock/cti/advisory.pdf\r\n/app/task/environment/sas-mock/cti/advisory.txt\r\n/app/task/environment/sas-mock/cti/SOURCES.txt\r\n/app/task/environment/sas-mock/cti/campaign-timeline.png\r\n/app/task/environment/sas-mock/vulns.json\r\n/app/task/environment/sas-mock/alerts.json\r\n/app/task/environment/disk.tar.gz\r\n/app/task/environment/Dockerfile\r\n"]
