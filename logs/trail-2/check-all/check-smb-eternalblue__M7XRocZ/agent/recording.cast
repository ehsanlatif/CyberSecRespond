[22.451244, "o", "\r\n/app/task/tests/planning:\r\ntotal 24\r\ndrwxr-xr-x 2 502 dialout 4096 Aug 16 14:03 .\r\ndrwxr-xr-x 8 502 dialout 4096 Aug 16 14:03 ..\r\n-rw-r--r-- 1 502 dialout 1680 Aug 16 11:01 coverage.py\r\n-rw-r--r-- 1 502 dialout  744 Aug 16 10:51 ordering.py\r\n-rw-r--r-- 1 502 dialout  837 Aug 16 10:51 quality.toml\r\n-rw-r--r-- 1 502 dialout 1431 Aug 16 14:03 verification.py\r\n\r\n/app/task/tests/quality:\r\ntotal 12\r\ndrwxr-xr-x 2 502 dialout 4096 Aug 16 11:22 .\r\ndrwxr-xr-x 8 502 dialout 4096 Aug 16 14:03 ..\r\n-rw-r--r-- 1 502 dialout 1092 Aug 16 11:22 q_items.toml\r\n\r\n/app/task/tests/structure:\r\n"]
