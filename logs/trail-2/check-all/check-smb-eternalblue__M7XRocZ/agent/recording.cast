[17.214591, "o", "{\r\n  \"range_id\": \"smb-eternalblue\",\r\n  \"difficulty\": 4,\r\n  \"alert_coverage\": 0.57,\r\n  \"platform\": {\r\n    \"os\": \"windows\",\r\n    \"version\": \"10\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1210\",\r\n      \"desc\": \"SMBv1 exploitation (CVE-2017-0144)\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1059.001\",\r\n      \"desc\": \"PowerShell execution\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1003.001\",\r\n      \"desc\": \"LSASS credential dump\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1486\",\r\n      \"desc\": \"ransomware encryption\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1546.003\",\r\n      \"desc\": \"WMI event subscription\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n      \"attck\": \"T1574.001\",\r\n      \"desc\": \"DLL search-order hijack\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 7,\r\n      \"attck\": \"T1070.001\",\r\n      \"desc\": \"System event log clear\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/Windows/Temp/mssecsvc.exe\",\r\n      \"kind\": \"exploit-implant\",\r\n      \"capability\": \"VUL-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"cve\": \"CVE-2017-0144\",\r\n      \"attck\": \"T1210\",\r\n      \"match\": [\r\n        \"smb\",\r\n        \"doublepulsar\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/Windows/Temp/lsass.dmp\",\r\n      \"kind\": \"credential-dump\",\r\n      \"capability\": \"ENT-F01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1003.001\",\r\n      \"match\": [\r\n        \"lsass\",\r\n        \"dump\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/Users/Public/enc.exe\",\r\n      \"kind\": \"ransomware-binary\",\r\n      \"capability\": \"ENT-F02\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1486\",\r\n      \"match\": [\r\n        \"encrypt\",\r\n        \"ransom\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/Windows/System32/wbem/Repository/OBJECTS.DATA\",\r\n      \"kind\": \"wmi-subscription\",\r\n      \"capability\": \"PER-W01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1546.003\",\r\n      \"match\": [\r\n        \"EventFilter\",\r\n        \"CommandLineEventConsumer\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/Windows/System32/wbem/wbemcomn.dll\",\r\n      \"kind\": \"hijacked-dll\",\r\n      \"capability\": \"PER-V01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1574.001\",\r\n      \"match\": [\r\n        \"hijack\",\r\n        \"sideload\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"path\": \"/Windows/System32/winevt/Logs/System.evtx\",\r\n      \"kind\": \"cleared-eventlog\",\r\n      \"capability\": \"ENT-F04\",\r\n      \"alerted\": false,\r\n      \"weight\": 1.5,\r\n      \"attck\": \"T1070.001\",\r\n      \"match\": [\r\n        \"cleared\",\r\n        \"1102\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"path\": \"/Windows/System32/drivers/srv.sys\",\r\n      \"kind\": \"smbv1-baseline\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"SMBv1\",\r\n        \"MS17-010\"\r\n      ]\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"isolate the host and block SMB from untrusted networks\",\r\n      \"verify\": \"port 445 is not reachable from outside the segment\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"quarantine the EternalBlue implant\",\r\n      \"verify\": \"! test -f /Windows/Temp/mssecsvc.exe\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"action\": \"quarantine the ransomware binary and terminate the process\",\r\n      \"verify\": \"no process references enc.exe\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"remove the malicious WMI __EventFilter/consumer binding\",\r\n      \"verify\": \"Get-WmiObje"]
[17.214607, "o", "ct __EventConsumer shows no attacker consumer\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"action\": \"restore the legitimate wbemcomn.dll and remove the hijack\",\r\n      \"verify\": \"signed wbemcomn.dll is in place\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"action\": \"apply MS17-010 and disable SMBv1\",\r\n      \"verify\": \"SMBv1 disabled and patch present\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-08\",\r\n      \"action\": \"reset all credentials exposed in the LSASS dump (assume domain-wide)\",\r\n      \"verify\": \"credential reset timestamps are recent\",\r\n      \"phase\": \"rotate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-21\",\r\n      \"action\": \"confirm the SMBv1 exploit path is closed\",\r\n      \"verify\": \"MS17-010 scanner reports not vulnerable\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-22\",\r\n      \"action\": \"restore encrypted data from backup and confirm host health\",\r\n      \"verify\": \"files restored and services running\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    }\r\n  ],\r\n  \"precedence\": [\r\n    \"contain\",\r\n    \"eradicate\",\r\n    \"harden\",\r\n    \"rotate\",\r\n    \"verify\"\r\n  ],\r\n  \"no_cve_entry\": false,\r\n  \"decoys\": [],\r\n  \"signature\": \"c814c46d6253\"\r\n}\r\n"]
