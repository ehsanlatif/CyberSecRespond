[21.836129, "o", "\r\n-rw-r--r-- 1 502 dialout 18012 Aug 16 16:01 criteria.py\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 14:03 detection\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 10:50 grounding\r\n-rw-r--r-- 1 502 dialout  4109 Aug 16 14:03 manifest.json\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 14:03 planning\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 11:22 quality\r\n-rw-r--r-- 1 502 dialout   511 Aug 16 10:51 reward.toml\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 12:19 rewardkit\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 11:26 structure\r\n-rwxr-xr-x 1 502 dialout  1987 Aug 16 14:27 test.sh\r\n"]
