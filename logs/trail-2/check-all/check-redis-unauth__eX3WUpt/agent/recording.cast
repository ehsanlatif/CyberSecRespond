[38.451614, "o", "# tests/reward.toml  (FIXED — aggregate keys; per-dimension keys are never collapsed)\r\n[[reward]]\r\nname = \"detection\"\r\naggregation = \"weighted_mean\"\r\n\r\n[[reward]]\r\nname = \"plan\"\r\naggregation = \"weighted_mean\"\r\n\r\n[[reward]]\r\nname = \"quality\"           # Q-dimension judge items; reported, eval-only by default (doc 02 §6 Q2)\r\naggregation = \"weighted_mean\"\r\n\r\n[[reward]]\r\nname = \"reward\"            # Harbor's parsed score\r\naggregation = \"threshold\"  # both axes >= 0.70 (never a sum of the two — doc 00 non-negotiable #2)\r\n"]
