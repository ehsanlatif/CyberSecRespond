[48.111628, "i", "cat /disk/etc/redis/redis.conf\necho \"=== LOGS ===\"\ncat /disk/var/log/syslog\necho \"=== AUTH LOG ===\"\ncat /disk/var/log/auth.log\necho \"=== KERN LOG ===\"\ncat /disk/var/log/kern.log\necho \"=== WTMP CSV ===\"\ncat /disk/var/log/wtmp.csv\n"]
[48.112022, "o", "cat /disk/etc/redis/redis.conf\r\n\u001b[?2004l\r"]
[48.113021, "o", "# redis.conf (managed)\r\n\r\nRedis protected-mode no; bind 0.0.0.0; no password set\r\n"]
[48.113164, "o", "\u001b[?2004hroot@43839b8f6af0:/app# "]
[48.113213, "o", "echo \"=== LOGS ===\"\r\n\u001b[?2004l\r"]
