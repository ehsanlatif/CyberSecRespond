[105.297379, "i", "python3 -c '\nimport os, glob\nfor path in sorted(glob.glob(\"/disk/**/*\", recursive=True)):\n    if os.path.isfile(path):\n        print(\"=\"*50)\n        print(path)\n        print(\"=\"*50)\n        try:\n            with open(path, \"r\", errors=\"replace\") as f:\n                lines = f.readlines()\n                for i, l in enumerate(lines, 1):\n                    print(f\"{i:3d}: {l}\", end=\"\")\n        except Exception as e:\n            print(\"Error reading:\", e)\n'\n"]
[105.298715, "o", "python3 -c '\r\n\u001b[?2004l\r\u001b[?2004h> import os, glob\r\n\u001b[?2004l\r\u001b[?2004h> for path in sorted(glob.glob(\"/disk/**/*\", recursive=True)):\r\n\u001b[?2004l\r\u001b[?2004h>     if os.path.isfile(path):\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"=\"*50)\r\n\u001b[?2004l\r\u001b[?2004h>         print(path)\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"=\"*50)\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             with open(path, \"r\", errors=\"replace\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>                 lines = f.readlines()\r\n\u001b[?2004l\r\u001b[?2004h>                 for i, l in enumerate(lines, 1):\r\n\u001b[?2004l\r\u001b[?2004h>                     print(f\"{i:3d}: {l}\", end=\"\")\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>             print(\"Error reading:\", e)\r\n\u001b[?2004l\r\u001b[?2004h> '\r\n\u001b[?2004l\r"]
