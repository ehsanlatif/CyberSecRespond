[161.755323, "i", "python3 -c '\nimport glob, gzip, re\nfor path in sorted(glob.glob(\"/disk/**/*\", recursive=True)):\n    if os.path.isfile(path):\n        try:\n            f = gzip.open(path, \"rt\", errors=\"ignore\") if path.endswith(\".gz\") else open(path, \"r\", errors=\"ignore\")\n            for idx, line in enumerate(f, 1):\n                if re.search(r\"198\\.51\\.100|xmrig|docker|cron|systemd|wiped|entrypoint|shell\\.php|jndi|struts\", line, re.I):\n                    # Filter out benign Noise in auth/syslog if necessary\n                    if any(x in line for x in [\"198.51.100.102\", \"xmrig\", \"docker-mon\", \"docker-metrics\", \"entrypoint\", \"wiped\", \"shell.php\", \"jndi\", \"struts\", \"2375\"]):\n                        print(f\"{path}:{idx} -> {line.strip()}\")\n            f.close()\n        except Exception:\n            pass\n'\n"]
