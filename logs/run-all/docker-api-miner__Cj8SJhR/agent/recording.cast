[121.74365, "i", "python3 -c '\nimport os, glob, gzip\nfor path in sorted(glob.glob(\"/disk/**/*\", recursive=True)):\n    if os.path.isfile(path):\n        try:\n            if path.endswith(\".gz\"):\n                f = gzip.open(path, \"rt\", errors=\"ignore\")\n            else:\n                f = open(path, \"r\", errors=\"ignore\")\n            content = f.read()\n            f.close()\n            for term in [\"198.51.100\", \"102\", \"2375\", \"xmrig\", \"docker-mon\", \"metrics\", \"entrypoint\", \"c2\", \"update-docker\", \"evil\"]:\n                if term in content:\n                    print(f\"Match {term} in {path}\")\n        except Exception as e:\n            pass\n'\n"]
