[250.489586, "o", "\r\n  ],\r\n  \"properties\": {\r\n    \"chk\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"path\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"attck\": {\r\n      \"type\": \"string\",\r\n      \"pattern\": \"^T\\\\d{4}(\\\\.\\\\d{3})?$\"\r\n    },\r\n    \"confidence\": {\r\n      \"enum\": [\r\n        \"low\",\r\n        \"medium\",\r\n        \"high\"\r\n      ]\r\n    },\r\n    \"evidence\": {\r\n      \"type\": \"string\",\r\n      \"description\": \"backtick-cited /disk or /sas path\"\r\n    }\r\n  }\r\n}\r\n{\r\n  \"findings\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/Users/Public/svc.exe\",\r\n      \"attck\": \"T1486\",\r\n      \"confidence\": \"high\",\r\n      \"evidence\": \"`/Users/Public/svc.exe`\"\r\n    },\r\n    {\r\n      \"chk\": \"TODO\",\r\n      \"path\": \"TODO\",\r\n      \"attck\": \"TODO\",\r\n      \"confidence\": \"TODO\",\r\n      \"evidence\": \"TODO\"\r\n    }\r\n  ]\r\n}\r\n"]
