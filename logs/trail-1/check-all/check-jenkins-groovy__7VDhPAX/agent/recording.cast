[25.427486, "o", "{\r\n  \"range_id\": \"jenkins-groovy\",\r\n  \"difficulty\": 3,\r\n  \"alert_coverage\": 0.67,\r\n  \"platform\": {\r\n    \"os\": \"ubuntu\",\r\n    \"version\": \"22.04\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1190\",\r\n      \"desc\": \"Jenkins RCE (CVE-2024-23897)\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1059.004\",\r\n"]
[25.427724, "o", "      \"desc\": \"Groovy/shell execution\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1496\",\r\n      \"desc\": \"cryptomining\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1037.004\",\r\n      \"desc\": \"Groovy init hook\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1098.004\",\r\n      \"desc\": \"authorized_keys backdoor\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 7,\r\n      \"attck\": \"T1070.002\",\r\n      \"desc\": \"Jenkins log truncation\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/var/lib/jenkins/jobs/.tmp/config.xml\",\r\n      \"kind\": \"rce-artifact\",\r\n      \"capability\": \"VUL-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"cve\": \"CVE-2024-23897\",\r\n      \"attck\": \"T1190\",\r\n      \"match\": [\r\n        \"jenkins\",\r\n        \"@\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/opt/jenkins/.xmr/xmrig\",\r\n      \"kind\": \"miner-process\",\r\n      \"capability\": \"ENT-P01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1496\",\r\n      \"match\": [\r\n        \"xmrig\",\r\n        \"pool\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/var/lib/jenkins/init.groovy.d/z-backdoor.groovy\",\r\n      \"kind\": \"groovy-init-hook\",\r\n      \"capability\": \"PER-I01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1037.004\",\r\n      \"match\": [\r\n        \"Thread\",\r\n        \"execute\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/var/lib/jenkins/.ssh/authorized_keys\",\r\n      \"kind\": \"ssh-key-backdoor\",\r\n      \"capability\": \"PER-K01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1098.004\",\r\n      \"match\": [\r\n        \"ssh-rsa\",\r\n        \"attacker\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/var/spool/cron/crontabs/jenkins\",\r\n      \"kind\": \"cron\",\r\n      \"capability\": \"PER-S01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1053.003\",\r\n      \"match\": [\r\n        \"xmrig\",\r\n        \"cron\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"path\": \"/var/lib/jenkins/config.xml\",\r\n      \"kind\": \"jenkins-baseline\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"useSecurity\",\r\n        \"false\"\r\n      ]\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"block the mining pool and attacker IP at the egress firewall\",\r\n      \"verify\": \"iptables -L OUTPUT -n | grep <pool-ip>\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"action\": \"quarantine the xmrig miner and terminate the process\",\r\n      \"verify\": \"pgrep -f xmrig returns empty\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"action\": \"remove the malicious Groovy init hook\",\r\n      \"verify\": \"! test -f /var/lib/jenkins/init.groovy.d/z-backdoor.groovy\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"remove the attacker key from the jenkins authorized_keys\",\r\n      \"verify\": \"! grep -q attacker /var/lib/jenkins/.ssh/authorized_keys\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"action\": \"remove the jenkins cron entry\",\r\n      \"verify\": \"! test -f /var/spool/cron/crontabs/jenkins\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"upgrade Jenkins past the CVE-2024-23897 fix and enable security\",\r\n      \"verify\": \"jenkins version is patched and useSecurity=true\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"action\": \"rotate Jenkins admin, agent, and st"]
