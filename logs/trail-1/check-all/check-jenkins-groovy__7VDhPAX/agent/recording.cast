[37.693009, "o", "cat /app/task/tests/criteria.py\r\n\u001b[?2004l\r"]
[37.693501, "o", "# tests/criteria.py\r\nfrom __future__ import annotations\r\n#\r\n# Shared library for the post-compromise DFIR verifier. This file is FIXED — it is identical\r\n# for every range in the subdomain. Nothing here is range-specific; the only per-range input\r\n# is manifest.json (doc 02 §3.0). The @criterion(shared=True) loaders are exposed to the\r\n# tier files as rk.shared.<name>; the plain functions below them are framework-agnostic\r\n# helpers imported directly (`from criteria import _dag, ...`).\r\nimport json\r\nimport os\r\nimport re\r\nfrom pathlib import Path\r\n\r\nfrom rewardkit import criterion\r\n\r\n# Mount locations default to the container paths but are overridable via env, so the runner\r\n# (and selftest) can point them at real or synthesised directories without editing this file.\r\nTESTS_DIR = Path(os.environ.get(\"RK_TESTS\", \"/tests\"))\r\n\r\n# Citations MUST be backtick-delimited: `/abs/path` or `/abs/path:line`. Requiring the\r\n# backticks stops bare slashes in prose (\"and/or\", \"TCP/IP\", \"24/7\") from being parsed as\r\n# paths and then flagged as fabrication. The path class excludes ':' so the optional\r\n# ':line' suffix splits unambiguously (doc 02 §3.3).\r\nCITE = re.compile(r\"`(/[^`\\s:]+)(?::(\\d+))?`\")\r\n\r\n# Read-only evidence mounts the agent is given (doc 02 §2.3). Citations are resolved by\r\n# mount prefix, NOT by blindly stripping the leading '/':\r\n#   - a citation beginning with a mount prefix (\"/sas/alerts.json\") resolves literally under\r\n#     that mount;\r\n#   - any other host-absolute citation (\"/etc/ssh/sshd_config\") is a path *inside the\r\n#     forensic image* and resolves under the primary host root (/disk) — never against the\r\n#     analysis machine's own filesystem.\r\nEVIDENCE_MOUNTS = {\"/sas\": Path(os.environ.get(\"RK_SAS\", \"/sas\")),\r\n                   \"/disk\": Path(os.environ.get(\"RK_DISK\", \"/disk\"))}\r\nHOST_ROOT = \"/disk\"\r\n\r\n# The three report files findings are parsed from. progress.md and remediation-plan.md are\r\n# handled by their own criteria and are not scanned for detection findings.\r\nREPORT_FILES = (\"intrusion-report.md\", \"vuln-report.md\", \"baseline-report.md\")\r\n\r\n# ATT&CK technique id, e.g. T1110 or T1546.004.\r\nATTCK = re.compile(r\"\\bT\\d{4}(?:\\.\\d{3})?\\b\")\r\n\r\n\r\n@criterion(shared=True)\r\ndef _manifest(workspace: Path) -> dict:\r\n    \"\"\"Ground truth for this range (generated corpus) or hand-extracted (SecRespond).\"\"\"\r\n    return json.loads((TESTS_DIR / \"manifest.json\").read_text())\r\n\r\n\r\n@criterion(shared=True)\r\ndef _findings(workspace: Path) -> list:\r\n    \"\"\"Parse (claim, citations) pairs out of the agent's markdown reports.\"\"\"\r\n    out = []\r\n    for name in REPORT_FILES:\r\n        p = workspace / name\r\n        if not p.exists():\r\n            continue\r\n        for line in p.read_text(errors=\"replace\").splitlines():\r\n            cites = CITE.findall(line)\r\n            if cites:\r\n                out.append({\"claim\": line.strip(), \"citations\": cites, \"source\": name})\r\n    return out\r\n\r\n\r\ndef _candidates(path: str) -> list:\r\n    \"\"\"Real filesystem candidate(s) a citation could resolve to, by mount prefix.\"\"\"\r\n    p = \"/\" + path.lstrip(\"/\")\r\n    for prefix, root in EVIDENCE_MOUNTS.items():\r\n        if p == prefix or p.startswith(prefix + \"/\"):\r\n            return [root / p[len(prefix):].lstrip(\"/\")]\r\n    # No mount prefix -> a host path inside the forensic image.\r\n    return [EVIDENCE_MOUNTS[HOST_ROOT] / p.lstrip(\"/\")]\r\n\r\n\r\n@criterion(shared=True)\r\ndef _grounding(workspace: Path):\r\n    \"\"\"Return a classifier path -> {'resolved','plausible','fabricated'} so every criterion\r\n    shares one filesystem view of the evidence mounts (doc 02 §2.3).\"\"\"\r\n\r\n    def classify(path: str) -> str:\r\n        cands = _candidates(path)\r\n        if any(c.exists() for c in cands):\r\n            return \"resolved\"\r\n        if any(c.parent.exists() for c in cands):\r\n            return \"plausible\"          # wrong file/line inside a real directory\r\n        return \"fabricated\"             # parent directory absent under every mount\r\n\r\n    return classify\r\n\r\n\r\n# --------------------------------------------------------------------------------------\r\n#"]
[37.693527, "o", " Framework-agnostic helpers (pure Python; no rewardkit dependency). Imported by the tier\r\n# files. The docs (doc 02/04) leave these as `_helpers`; here they are implemented in full.\r\n# --------------------------------------------------------------------------------------\r\n\r\ndef _haystack(finding: dict) -> str:\r\n    \"\"\"All searchable text of a finding: its claim plus its cited path strings.\"\"\"\r\n    return finding[\"claim\"] + \" \" + \" \".join(c[0] for c in finding[\"citations\"])\r\n\r\n\r\ndef _needles(artifact: dict) -> list:\r\n    \"\"\"Locator needles for finding an artifact's plan block: its path, the path basename, and\r\n    any `match` terms. Used by coverage's block lookup (within-plan, low collision risk).\"\"\"\r\n    path = artifact.get(\"path\", \"\")\r\n    base = path.rstrip(\"/\").split(\"/\")[-1] if path else \"\"\r\n    return [n for n in ([path, base] + list(artifact.get(\"match\") or [])) if n]\r\n\r\n\r\ndef _artifact_mentioned(findings: list, artifact: dict) -> bool:\r\n    \"\"\"An artifact counts as discovered only if a finding cites its full PATH (Δ3 requires\r\n    citations, so a genuine detection names the path) AND — when the artifact has `match`\r\n    discriminators — at least one of them co-occurs. Requiring the path avoids the substring\r\n    collisions that would otherwise inflate silent-recall (e.g. two artifacts sharing a name\r\n    fragment, or two checkpoints sharing one path distinguished only by `match`).\"\"\"\r\n    path = artifact.get(\"path\", \"\")\r\n    match = list(artifact.get(\"match\") or [])\r\n    if not path:\r\n        return False\r\n    for f in findings:\r\n        hay = _haystack(f)\r\n        if path in hay and (not match or any(m in hay for m in match)):\r\n            return True\r\n    return False\r\n\r\n\r\ndef _detected_chks(findings: list, manifest: dict) -> list:\r\n    \"\"\"CHK ids of manifest artifacts the agent actually named in a report.\"\"\"\r\n    return [a[\"chk\"] for a in manifest[\"artifacts\"] if _artifact_mentioned(findings, a)]\r\n\r\n\r\n# ---- attack-chain DAG (doc 02 §3.4) ----\r\n\r\ndef _dag(chain: list) -> dict:\r\n    \"\"\"Build a DAG from manifest['chain']. Nodes = ATT&CK ids; edges = (upstream, node)\r\n    pairs derived from `depends_on` (defaulting to the previous step when absent).\"\"\"\r\n    by_step = {c[\"step\"]: c for c in chain}\r\n    nodes = {c[\"attck\"] for c in chain}\r\n    edges = set()\r\n    for c in chain:\r\n        deps = c.get(\"depends_on\")\r\n        if deps is None and c[\"step\"] > 1 and (c[\"step\"] - 1) in by_step:\r\n            deps = [c[\"step\"] - 1]\r\n        for d in deps or []:\r\n            if d in by_step:\r\n                edges.add((by_step[d][\"attck\"], c[\"attck\"]))\r\n    return {\"nodes\": nodes, \"edges\": edges}\r\n\r\n\r\ndef _chain_section(text: str) -> str:\r\n    \"\"\"Slice the '## Attack Chain' section so incidental ATT&CK ids elsewhere in the report\r\n    (e.g. a technique id in an entities table) are not mistaken for chain nodes. Falls back to\r\n    the whole report when no such heading exists.\"\"\"\r\n    lines = text.splitlines()\r\n    start = next((i + 1 for i, l in enumerate(lines)\r\n                  if l.lstrip().startswith(\"#\") and \"chain\" in l.lower()), None)\r\n    if start is None:\r\n        return text\r\n    end = next((j for j in range(start, len(lines)) if lines[j].lstrip().startswith(\"#\")),\r\n               len(lines))\r\n    return \"\\n\".join(lines[start:end])\r\n\r\n\r\ndef _parse_chain(report_path: Path) -> dict:\r\n    \"\"\"Parse the agent's reconstructed chain from intrusion-report.md.\r\n\r\n    Nodes = ATT&CK ids mentioned. Edges are read from arrow notation on a line, tolerant of\r\n    both linear (`A -> B -> C`) and branching/brace (`A -> {B, C, D}`) forms:\r\n      - a non-brace segment with several ids chains them (a -> b -> c) and connects to\r\n        neighbours via its first/last id;\r\n      - a brace segment `{B, C, D}` treats its ids as siblings — each receives from the\r\n        previous tail and sends to the next head.\r\n    \"\"\"\r\n    nodes, edges = set(), set()\r\n    if not report_path.exists():\r\n        return {\"nodes\": nodes, \"edges\": edges}\r\n    for raw in _chain_section(report_path.read_text(errors=\"replace\")).splitlines():\r\n        line"]
[37.693667, "o", " = raw.replace(\"→\", \"->\")\r\n        ids_all = ATTCK.findall(line)\r\n        nodes.update(ids_all)\r\n        if \"->\" not in line:\r\n            continue\r\n        segs = line.split(\"->\")\r\n        heads, tails = [], []\r\n        for seg in segs:\r\n            ids = ATTCK.findall(seg)\r\n            if not ids:\r\n                heads.append([]); tails.append([]); continue\r\n            if \"{\" in seg:                       # brace set: siblings\r\n                heads.append(ids); tails.append(ids)\r\n            else:                                 # ordered ids chain within the segment\r\n                for a, b in zip(ids, ids[1:]):\r\n                    edges.add((a, b))\r\n                heads.append(ids[:1]); tails.append(ids[-1:])\r\n        for left, right in zip(range(len(segs)), range(1, len(segs))):\r\n            for a in tails[left]:\r\n                for b in heads[right]:\r\n                    edges.add((a, b))\r\n    return {\"nodes\": nodes, \"edges\": edges}\r\n\r\n\r\ndef _ged(pred: dict, gt: dict) -> int:\r\n    \"\"\"Graph edit distance approximated as the symmetric difference of node sets plus the\r\n    symmetric difference of edge sets (deletions + insertions). Deleting a node also deletes\r\n    its incident edges, so both terms are counted (doc 02 §3.4).\"\"\"\r\n    node_diff = len(pred[\"nodes\"] ^ gt[\"nodes\"])\r\n    edge_diff = len(pred[\"edges\"] ^ gt[\"edges\"])\r\n    return node_diff + edge_diff\r\n\r\n\r\n# ---- remediation plan parsing (doc 02 §3.4, §3.3) ----\r\n\r\nVERIFY_TOKENS = (\"verify\", \"confirm\", \"re-run\", \"recheck\", \"revalidate\", \"validate\",\r\n                 \"systemctl status\", \"systemctl is-active\", \"restart\", \"test\", \"check that\",\r\n                 \"expect\", \"returns empty\", \"== 0\")\r\n\r\nPHASE_CUES = {\r\n    \"contain\":   (\"contain\", \"isolate\", \"block\", \"disconnect\", \"cordon\"),\r\n    \"eradicate\": (\"eradicate\", \"remove\", \"delete\", \"kill\", \"terminate\", \"disable\",\r\n                  \"quarantine\", \"clean\", \"revoke\", \"purge\"),\r\n    \"harden\":    (\"harden\", \"permitrootlogin\", \"passwordauthentication\", \"maxauthtries\",\r\n                  \"restrict\", \"reconfigure\", \"bind-address\", \"patch\", \"lock down\"),\r\n    \"rotate\":    (\"rotate\", \"reset password\", \"reset credential\", \"change credential\",\r\n                  \"new key\", \"rekey\", \"re-key\", \"rotate credentials\"),\r\n    \"verify\":    (\"verify\", \"confirm\", \"restart\", \"re-run\", \"recheck\", \"validate\",\r\n                  \"is-active\", \"health\", \"status\", \"http 200\"),\r\n}\r\n\r\n\r\ndef _blocks(plan: str) -> list:\r\n    \"\"\"Split a remediation plan into step blocks. A block starts at a numbered item, a\r\n    bullet, or a header, and runs until the next such marker (sub-bullets included).\"\"\"\r\n    lines = plan.splitlines()\r\n    starts = []\r\n    marker = re.compile(r\"^\\s*(?:#{1,6}\\s|\\d+[.)]\\s|[-*+]\\s)\")\r\n    for i, line in enumerate(lines):\r\n        if marker.match(line):\r\n            starts.append(i)\r\n    if not starts:\r\n        return [plan] if plan.strip() else []\r\n    starts.append(len(lines))\r\n    return [\"\\n\".join(lines[starts[k]:starts[k + 1]]) for k in range(len(starts) - 1)]\r\n\r\n\r\ndef _coarse_blocks(plan: str) -> list:\r\n    \"\"\"Split a plan into step blocks at headers and numbered items ONLY — not at bullets — so\r\n    a step keeps its sub-bullets (e.g. a `- Verify: ...` line stays with its step). Used by\r\n    step lookup; `_blocks` (which also splits at bullets) is used by phase ordering.\"\"\"\r\n    lines = plan.splitlines()\r\n    marker = re.compile(r\"^\\s*(?:#{1,6}\\s|\\d+[.)]\\s)\")\r\n    starts = [i for i, line in enumerate(lines) if marker.match(line)]\r\n    if not starts:\r\n        return [plan] if plan.strip() else []\r\n    starts.append(len(lines))\r\n    return [\"\\n\".join(lines[starts[k]:starts[k + 1]]) for k in range(len(starts) - 1)]\r\n\r\n\r\ndef _step_block_for(plan: str, artifact: dict) -> str:\r\n    \"\"\"Return the first plan step (with its sub-bullets) that references this artifact (by\r\n    path, basename, or a match needle); empty string if none.\"\"\"\r\n    needles = _needles(artifact)\r\n    for block in _coarse_blocks(plan):\r\n        if any(n in block for n in needles):\r\n            return block\r\n    return \"\"\r\n\r\n\r\ndef _phas"]
[37.694388, "o", "e_of(text: str) -> str:\r\n    \"\"\"Best-guess remediation phase for a block of plan text, by keyword cue.\"\"\"\r\n    low = text.lower()\r\n    # Explicit headers like \"P0 — Contain\" win.\r\n    for phase, cues in PHASE_CUES.items():\r\n        if re.search(rf\"\\b{phase}\\b\", low):\r\n            return phase\r\n    best, best_hits = None, 0\r\n    for phase, cues in PHASE_CUES.items():\r\n        hits = sum(1 for c in cues if c in low)\r\n        if hits > best_hits:\r\n            best, best_hits = phase, hits\r\n    return best or \"eradicate\"\r\n\r\n\r\n_HEADER_RE = re.compile(r\"^\\s*#{1,6}\\s\")\r\n_STEP_RE = re.compile(r\"^\\s*\\d+[.)]\\s\")\r\n\r\n\r\ndef _header_phase(text: str) -> str | None:\r\n    low = text.lower()\r\n    for phase in (\"contain\", \"eradicate\", \"harden\", \"rotate\", \"verify\"):\r\n        if phase in low:\r\n            return phase\r\n    return None\r\n\r\n\r\ndef _ordered_steps(plan: str) -> list:\r\n    \"\"\"Phase label per top-level remediation step, in document order (doc 02 §3.4).\r\n\r\n    Prefers the phase of the enclosing header (\"## P1 — Eradicate\"); sub-bullets such as\r\n    \"- Verify: ...\" are NOT steps and must not be phase-labelled (that spuriously injected a\r\n    'verify' step into every section). Falls back to per-step keyword classification when the\r\n    plan has no phase headers.\"\"\"\r\n    phases, current = [], None\r\n    for line in plan.splitlines():\r\n        if _HEADER_RE.match(line):\r\n            p = _header_phase(line)\r\n            if p:\r\n                current = p\r\n            continue\r\n        if _STEP_RE.match(line):\r\n            phases.append(current or _phase_of(line))\r\n    if not phases:  # unstructured plan — fall back to block classification\r\n        return [_phase_of(b) for b in _blocks(plan) if b.strip()]\r\n    return phases\r\n\r\n\r\ndef _count_precedence_violations(steps: list, precedence: list) -> int:\r\n    \"\"\"Count adjacent out-of-order transitions against the precedence order.\"\"\"\r\n    idx = [precedence.index(p) for p in steps if p in precedence]\r\n    return sum(1 for a, b in zip(idx, idx[1:]) if a > b)\r\n\u001b[?2004hroot@41f627e8ffb6:/app# "]
[43.702127, "i", "cat /app/task/tests/detection/attribution.toml /app/task/tests/detection/chain_topology.py /app/task/tests/detection/discovery.py /app/task/tests/detection/no_cve_claimed.py /app/task/tests/detection/silent_recall.py\n"]
[43.702693, "o", "cat /app/task/tests/detection/attribution.toml /app/task/tests/detection/chain_topology.py /app/task/tests/detection/discovery.py /app/task/tests/detection/no_cve_claimed.py /app/task/tests/detection/silent_recall.py\r\n\u001b[?2004l\r"]
[43.703232, "o", "# tests/quality/attribution.toml  (Tier 3 — attribution; T1190 → T1059.004 → {T1496, T1037.004, T1098.004, T1053.003, T1070.002} filled by the generator)\r\n# The prompt is templated over manifest fields, not literal artifacts, so it transfers to\r\n"]
[43.703666, "o", "# any range unchanged (doc 02 §3.5).\r\n[judge]\r\njudge  = \"${REWARDKIT_JUDGE}\"    # env-driven; family MUST differ from the policy\r\nfiles  = [\"/app/intrusion-report.md\", \"/tests/manifest.json\"]\r\nweight = 1.0\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Given the ground-truth attack chain T1190 → T1059.004 → {T1496, T1037.004, T1098.004, T1053.003, T1070.002}, is each attacker artifact\r\ncorrectly attributed to its upstream cause (its depends_on step), rather than to an\r\nunrelated cause or left unattributed? Award only where the report states the causal link\r\nexplicitly. Do not award credit for links the report does not state.\"\"\"\r\ntype = \"binary\"\r\nweight = 1.0\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Does the report distinguish attacker-caused artifacts from coincidental or\r\npre-existing host state? Penalise any attacker attribution of benign artifacts.\"\"\"\r\ntype = \"likert\"\r\npoints = 3\r\n\r\n[scoring]\r\naggregation = \"weighted_mean\"\r\n# tests/detection/chain_topology.py  (FIXED — Tier 2, graph-edit distance)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _dag, _ged, _parse_chain\r\n\r\n\r\n@criterion(description=\"attack chain topology matches ground truth\")\r\ndef chain_score(workspace: Path) -> float:\r\n    \"\"\"Attack-chain reconstruction is a structure problem: parse the agent's chain into a\r\n    DAG and compare topologically. Normalised graph edit distance over (node set, edge set)\r\n    — the denominator is nodes + edges, and node deletions carry their incident edges, so\r\n    the score degrades smoothly with missing/extra steps (doc 02 §3.4).\"\"\"\r\n    gt = _dag(rk.shared._manifest(workspace)[\"chain\"])\r\n    pred = _parse_chain(workspace / \"intrusion-report.md\")\r\n    denom = len(gt[\"nodes\"]) + len(gt[\"edges\"])\r\n    if denom == 0:\r\n        return 1.0\r\n    return max(0.0, 1.0 - _ged(pred, gt) / denom)\r\n# tests/detection/discovery.py  (GENERATED by the task generator from manifest.json)\r\n# One discovery criterion per artifact; evidence/grounding is scored separately by the\r\n# grounding gate (doc 02 §2.3), so this returns a pure 0/1 discovery sub-score.\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _haystack\r\n\r\n\r\n@criterion(description=\"CHK {chk}: artifact {artifact} discovered\")\r\ndef discovered(workspace: Path, chk: str, artifact: str, match=None) -> float:\r\n    # Path-required: a genuine detection cites the artifact's path (Δ3). `match` needles\r\n    # discriminate checkpoints that share a path (e.g. miner process vs. binary).\r\n    match = list(match or [])\r\n    for f in rk.shared._findings(workspace):\r\n        hay = _haystack(f)\r\n        if artifact in hay and (not match or any(m in hay for m in match)):\r\n            return 1.0\r\n    return 0.0\r\n\r\n\r\n# --- registrations (silent artifacts upweighted; weights are the manifest's) ---\r\n\r\nrk.discovered(\"CHK-01\", \"/var/lib/jenkins/jobs/.tmp/config.xml\", match=['jenkins', '@'], weight=1.0)\r\nrk.discovered(\"CHK-02\", \"/opt/jenkins/.xmr/xmrig\", match=['xmrig', 'pool'], weight=1.0)\r\nrk.discovered(\"CHK-03\", \"/var/lib/jenkins/init.groovy.d/z-backdoor.groovy\", match=['Thread', 'execute'], weight=2.0)  # SILENT\r\nrk.discovered(\"CHK-04\", \"/var/lib/jenkins/.ssh/authorized_keys\", match=['ssh-rsa', 'attacker'], weight=2.0)  # SILENT\r\nrk.discovered(\"CHK-05\", \"/var/spool/cron/crontabs/jenkins\", match=['xmrig', 'cron'], weight=1.0)\r\nrk.discovered(\"CHK-06\", \"/var/lib/jenkins/config.xml\", match=['useSecurity', 'false'], weight=1.0)\r\nrk.silent_artifact_recall(weight=0.0)   # reported, not scored — headline diagnostic\r\n# tests/detection/no_cve_claimed.py  (FIXED — Tier 1, the negative deliverable)\r\nimport re\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nCVE = re.compile(r\"cve-\\d{4}-\\d{4,7}\")\r\nNEGATED = (\"no cve\", \"not cve\", \"no known cve\", \"ruled out\", \"rather than\",\r\n           \"not driven by\", \"no vulnerability-driven\", \"not vulnerability-driven\",\r\n           \"no software vulnerability\", \"excluded\", \"is not\", \"no exploited\")\r\nCONCLUDES_NONE = (\"no cve\", \""]
[43.703862, "o", "not cve-driven\", \"no vulnerability-driven entry\",\r\n                  \"misconfiguration rather than\", \"no known cve\", \"no software vulnerability\")\r\n\r\n\r\n@criterion(description=\"vuln-report correctly concludes no CVE-driven entry\")\r\ndef no_false_cve(workspace: Path, tag) -> float:\r\n    \"\"\"The negative-deliverable check. `tag` is a required scheduling marker: it forces this\r\n    criterion to be registered EXPLICITLY (build.py emits `rk.no_false_cve(...)` only for\r\n    no-CVE ranges) rather than auto-scheduled, so a CVE range never contributes a free 1.0 to\r\n    the detection axis. A CVE id is a false attribution only when asserted affirmatively —\r\n    naming a CVE to rule it out (\"entry was weak creds, not CVE-2021-44228\") is correct, not\r\n    fabrication (doc 04 §6).\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    if not m.get(\"no_cve_entry\"):\r\n        return 1.0  # CVE-entry ranges are scored by their own discovery criteria\r\n    p = workspace / \"vuln-report.md\"\r\n    if not p.exists():\r\n        return 0.0\r\n    text = p.read_text(errors=\"replace\").lower()\r\n    for line in text.splitlines():\r\n        if CVE.search(line) and not any(n in line for n in NEGATED):\r\n            return 0.0  # affirmatively attributes entry to a CVE that does not exist\r\n    asserts_none = any(phrase in text for phrase in CONCLUDES_NONE)\r\n    return 1.0 if asserts_none else 0.3  # silence != correct conclusion\r\n# tests/detection/silent_recall.py  (FIXED — Tier 1, the headline diagnostic)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _artifact_mentioned\r\n\r\n\r\n@criterion(description=\"recall over non-alerted (silent) ground-truth artifacts\")\r\ndef silent_artifact_recall(workspace: Path) -> float:\r\n    \"\"\"The cleanest single number for P1 (reactive tunnel vision). Recall restricted to the\r\n    artifacts that were NOT surfaced as alerts, so it isolates proactive investigation from\r\n    alert transcription (doc 01 §5.3). Registered with weight 0.0 in discovery.py — reported,\r\n    not scored.\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    findings = rk.shared._findings(workspace)\r\n    silent = [a for a in m[\"artifacts\"] if not a.get(\"alerted\", False)]\r\n    if not silent:\r\n        return 1.0\r\n    found = sum(1 for a in silent if _artifact_mentioned(findings, a))\r\n    return found / len(silent)\r\n\u001b[?2004hroot@41f627e8ffb6:/app# "]
[58.177985, "i", "cat /app/task/tests/structure/five_files_exist.py /app/task/tests/structure/nonempty_and_parses.py /app/task/tests/structure/required_sections.py\n"]
[58.178651, "o", "cat /app/task/tests/structure/five_files_exist.py /app/task/tests/structure/nonempty_and_parses.py /app/task/tests/structure/required_sections.py\r\n\u001b[?2004l\r"]
[58.179285, "o", "# tests/structure/five_files_exist.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nREQUIRED = (\"progress.md\", \"intrusion-report.md\", \"vuln-report.md\",\r\n            \"baseline-report.md\", \"remediation-plan.md\")\r\n\r\n\r\n@criterion(description=\"all five required report files exist\", required_pass=True)\r\ndef five_files_exist(workspace: Path) -> bool:\r\n    # A run that produces fewer than five files is `incomplete_output`, not a low score\r\n    # (doc 04 §2.2). The structure gate is multiplicative in the reward (doc 02 §4.4).\r\n    return all((workspace / name).exists() for name in REQUIRED)\r\n# tests/structure/nonempty_and_parses.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import REPORT_FILES\r\n\r\nREQUIRED = (\"progress.md\", \"intrusion-report.md\", \"vuln-report.md\",\r\n            \"baseline-report.md\", \"remediation-plan.md\")\r\nMIN_CHARS = 40  # a plausible report has at least a heading and a sentence\r\n\r\n\r\n@criterion(description=\"every report is non-empty and has at least one markdown heading\",\r\n           required_pass=True)\r\ndef nonempty_and_parses(workspace: Path) -> bool:\r\n    for name in REQUIRED:\r\n        p = workspace / name\r\n        if not p.exists():\r\n            return False\r\n        text = p.read_text(errors=\"replace\").strip()\r\n        if len(text) < MIN_CHARS:\r\n            return False\r\n        if not any(line.lstrip().startswith(\"#\") for line in text.splitlines()):\r\n            return False\r\n    return True\r\n"]
[58.179632, "o", "# tests/structure/required_sections.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n# Minimal section contract each report must satisfy (case-insensitive substring match).\r\n# Deliberately loose — the gate checks SHAPE, not content quality. In particular it does NOT\r\n# require verification language in the plan (that is a Tier-1 plan score, not a structure\r\n# gate), so a well-formed but evidence-free no-op report still passes structure.\r\nREQUIRED_SECTIONS = {\r\n    \"intrusion-report.md\": (\"entry\", \"chain\"),        # entry point + attack chain\r\n    \"vuln-report.md\":      (\"vuln\",),                 # a vulnerability section\r\n    \"baseline-report.md\":  (\"baseline\",),             # baseline weaknesses\r\n    \"remediation-plan.md\": (\"remediat\",),             # a remediation plan\r\n}\r\n\r\n\r\ndef _headings(text: str) -> str:\r\n    return \"\\n\".join(l for l in text.splitlines() if l.lstrip().startswith(\"#\")).lower()\r\n\r\n\r\n@criterion(description=\"each report contains its required sections\", required_pass=True)\r\ndef required_sections(workspace: Path) -> bool:\r\n    for name, needles in REQUIRED_SECTIONS.items():\r\n        p = workspace / name\r\n        if not p.exists():\r\n            return False\r\n        blob = p.read_text(errors=\"replace\").lower()\r\n        heads = _headings(blob)\r\n        for n in needles:\r\n            if n not in heads and n not in blob:\r\n                return False\r\n    return True\r\n\u001b[?2004hroot@41f627e8ffb6:/app# "]
[58.269802, "i", "cat /app/task/tests/grounding/citations_resolve.py /app/task/tests/grounding/no_fabrication.py\n"]
[58.270306, "o", "cat /app/task/tests/grounding/citations_resolve.py /app/task/tests/grounding/no_fabrication.py\r\n\u001b[?2004l\r"]
[58.271165, "o", "# tests/grounding/citations_resolve.py  (FIXED — Tier 1, the evidence sub-score)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n\r\n@criterion(description=\"fraction of findings whose citation resolves under /disk or /sas\")\r\ndef grounding_rate(workspace: Path) -> float:\r\n    \"\"\"Evidence sub-score, computed without a judge (doc 02 §2.3). A finding is grounded if\r\n    at least one of its citations resolves to a real file under an evidence root. Findings\r\n    whose citations are only 'plausible' (wrong file in a real dir) score 0 here but are not\r\n    fabrication; fabrication is handled by no_fabrication.py.\"\"\"\r\n    findings = rk.shared._findings(workspace)\r\n    if not findings:\r\n        return 0.0\r\n    classify = rk.shared._grounding(workspace)\r\n    grounded = 0\r\n    for f in findings:\r\n        if any(classify(path) == \"resolved\" for path, _ in f[\"citations\"]):\r\n            grounded += 1\r\n    return grounded / len(findings)\r\n# tests/grounding/no_fabrication.py  (FIXED — Tier 1, the fabrication gate)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n\r\n@criterion(description=\"no citation invents a path whose directory does not exist\")\r\ndef no_fabrication(workspace: Path) -> bool:\r\n    \"\"\"Returns False (→ detection gate = 0, fabrication_rate ++) only when a citation is\r\n    'fabricated' — its parent directory is absent under BOTH /disk and /sas. A citation that\r\n    is merely 'plausible' (wrong file inside a real directory) is a wrong citation, not an\r\n    invented one, and does not trip the gate (doc 02 §2.3).\"\"\"\r\n    classify = rk.shared._grounding(workspace)\r\n    for f in rk.shared._findings(workspace):\r\n        for path, _ in f[\"citations\"]:\r\n            if classify(path) == \"fabricated\":\r\n                return False\r\n    return True\r\n"]
[58.271422, "o", "\u001b[?2004hroot@41f627e8ffb6:/app# "]
[58.371859, "i", "cat /app/task/tests/planning/coverage.py /app/task/tests/planning/ordering.py /app/task/tests/planning/verification.py\n"]
[58.372062, "o", "cat /app/task/tests/planning/coverage.py /app/task/tests/planning/ordering.py /app/task/tests/planning/verification.py\r\n"]
[58.372581, "o", "\u001b[?2004l\r"]
[58.373161, "o", "# tests/planning/coverage.py  (FIXED — Tier 1, detect-then-abandon)"]
[58.373324, "o", "\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _detected_chks, _step_block_for\r\n\r\n\r\n@criterion(description=\"every detected artifact has a remediation step\")\r\ndef plan_covers_findings(workspace: Path) -> float:\r\n    \"\"\"Plan coverage is deliberately COUPLED to detection — the denominator is the set of\r\n    *detected* CHKs, so an undetected finding earns no plan credit. This diverges from the\r\n    published SecRespond rubric (which credits generic hardening independently) and is why\r\n    we do not reproduce cells like ssh-miner CHK-03 0.00/1.00 (doc 04 §3). It measures\r\n    detect-then-abandon directly.\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    findings = rk.shared._findings(workspace)\r\n    detected = _detected_chks(findings, m)\r\n    if not detected:\r\n        return 0.0\r\n    # Only artifacts that HAVE a manifest remediation entry are remediable. Detection-only\r\n    # forensic evidence (e.g. cleared-log residue) has no remediation and must not count\r\n    # against coverage — otherwise the oracle itself, which correctly leaves it alone, would\r\n    # be penalised.\r\n"]
[58.373385, "o", "    remediable = {r[\"chk\"] for r in m.get(\"remediation\", [])}\r\n    by_chk = {a[\"chk\"]: a for a in m[\"artifacts\"]}\r\n    targets = [chk for chk in detected if chk in remediable and chk in by_chk]\r\n    if not targets:\r\n        return 1.0  # nothing detected was remediable → coverage vacuously satisfied\r\n    plan = (workspace / \"remediation-plan.md\").read_text(errors=\"replace\")\r\n    covered = sum(1 for chk in targets if _step_block_for(plan, by_chk[chk]))\r\n    return covered / len(targets)\r\n# tests/planning/ordering.py  (FIXED — Tier 2, precedence violations)\r\nfrom pathlib import Path\r\n\r\n"]
[58.373441, "o", "import rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _count_precedence_violations, _ordered_steps\r\n\r\n# Precedence rules the plan must respect are read from the manifest:\r\n#   contain -> eradicate -> harden -> rotate -> verify\r\n\r\n\r\n@criterion(description=\"remediation plan has no precedence violations\")\r\ndef ordering_ok(workspace: Path) -> float:\r\n    plan = (workspace / \"remediation-plan.md\").read_text(errors=\"replace\")\r\n"]
[58.373516, "o", "    steps = _ordered_steps(plan)\r\n    precedence = rk.shared._manifest(workspace)[\"precedence\"]\r\n    viol = _count_precedence_violations(steps, precedence)\r\n    return max(0.0, 1.0 - viol / max(len(steps), 1))\r\n# tests/planning/verification.py  (GENERATED by the task generator from manifest.json)\r\n# One criterion per remediation entry: does the plan block for this finding contain a\r\n# verification action? (doc 02 §3.3)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\n"]
[58.373575, "o", "from rewardkit import criterion\r\n\r\nfrom criteria import VERIFY_TOKENS, _step_block_for\r\n\r\n\r\n@criterion(description=\"remediation step for {chk} includes a verification action\")\r\ndef step_verified(workspace: Path, chk: str) -> bool:\r\n    m = rk.shared._manifest(workspace)\r\n    rem = next((r for r in m[\"remediation\"] if r[\"chk\"] == chk), None)\r\n    art = next((a for a in m[\"artifacts\"] if a[\"chk\"] == chk), None)\r\n    plan = (workspace / \"remediation-plan.md\").read_text(errors=\"replace\")\r\n    # Locate the plan block: by artifact if this CHK is an artifact, else by action text.\r\n    key = art if art else {\"path\": (rem or {}).get(\"action\", chk), \"match\": [chk]}\r\n    block = _step_block_for(plan, key)\r\n    return bool(block) and any(v in block.lower() for v in VERIFY_TOKENS)\r\n\r\n\r\n# --- registrations (one per remediation entry) ---\r\n\r\nrk.step_verified(\"CHK-20\", weight=1.0)\r\nrk.step_verified(\"CHK-02\", weight=1.0)\r\n"]
[58.373582, "o", "rk.step_verified(\"CHK-03\", weight=1.0)\r\nrk.step_verified(\"CHK-04\", weight=1.0)\r\nrk.step_verified(\"CHK-05\", weight=1.0)\r\nrk.step_verified(\"CHK-01\", weight=1.0)\r\nrk.step_verified(\"CHK-07\", weight=1.0)\r\nrk.step_verified(\"CHK-21\", weight=1.0)\r\nrk.step_verified(\"CHK-22\", weight=1.0)\r\n"]
