[?2004l"""rewardkit — the reward substrate the DFIR verifier is written against.

This is a real, self-contained implementation of the (previously fictional) `harbor-rewardkit`
API the criterion files use: the `@criterion` decorator, the `rk.shared.<name>` namespace of
shared helpers, and the `rk.<name>(...)` registrars for parametrized criteria
(`rk.discovered`, `rk.step_verified`, `rk.silent_artifact_recall`). The scoring/aggregation
loop lives in `runner.py`; the Tier-3 judge adapter in `judge.py`.

Design notes:
- `@criterion(shared=True)` registers a helper on `shared` (callable as `rk.shared.<name>`).
- `@criterion(...)` (non-shared) registers a criterion *definition*. A definition with no
  required parameters beyond `workspace` is auto-scheduled to run once; a definition that
  takes extra required parameters (e.g. `discovered(workspace, chk, artifact)`) is a template
  scheduled explicitly via `rk.<name>(...)`.
- `rk.<name>(...)` schedules one instance of criterion `<name>` with bound args + a weight.
- Instance dedup key is (name, positional-args). An explicit registration overrides an
  auto-scheduled one for the same key (this is how `rk.silent_artifact_recall(weight=0.0)`
  turns the auto-scheduled headline metric into a reported-but-unweighted one).
"""
from __future__ import annotations

import inspect


class _Shared:
    """Namespace object populated by @criterion(shared=True); reached as rk.shared.<name>."""


shared = _Shared()

# name -> {"fn", "description", "required_pass", "group"}
_defs: dict = {}
# (name, args_tuple) -> {"name","args","kwargs","weight","auto","group"}
_instances: dict = {}
_current_group = None


def _reset() -> None:
    """Clear all state (the runner calls this before each run)."""
    global _current_group
    _defs.clear()
    _instances.clear()
    for k in [k for k in vars(shared)]:
        delattr(shared, k)
    _current_group = None


def _set_group(group) -> None:
    global _current_group
    _current_group = group


def _required_extra(fn) -> list:
    """Required positional parameters beyond the leading `workspace` (no default, not *args)."""
    params = list(inspect.signature(fn).parameters.values())[1:]
    return [p for p in params
            if p.default is inspect._empty
            and p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)]


def criterion(_fn=None, *, shared=False, description=None, weight=1.0,
              required_pass=False, **_extra):
    """Register a criterion (or, with shared=True, a shared helper)."""
    def deco(fn):
        if shared:
            setattr(globals()["shared"], fn.__name__, fn)
            return fn
        _defs[fn.__name__] = {
            "fn": fn, "description": description,
            "required_pass": required_pass, "group": _current_group,
        }
        if not _required_extra(fn):          # runnable with only `workspace` → auto-schedule
            _schedule(fn.__name__, (), {}, weight, auto=True)
        return fn
    return deco(_fn) if _fn is not None else deco


def _schedule(name, args, kwargs, weight, auto) -> None:
    key = (name, tuple(args))
    existing = _instances.get(key)
    if existing is not None and not existing["auto"] and auto:
        return                               # never let an auto instance clobber an explicit one
    _instances[key] = {
        "name": name, "args": tuple(args), "kwargs": dict(kwargs),
        "weight": weight, "auto": auto, "group": _current_group,
    }


def __getattr__(name):
    """Any unknown attribute is a registrar: rk.discovered(...), rk.step_verified(...), etc."""
    def register(*args, weight=1.0, **kwargs):
        _schedule(name, args, kwargs, weight, auto=False)
    return register
"""CLI: `python -m rewardkit --tests DIR [--app DIR --disk DIR --sas DIR]`.

Invoked by tests/test.sh inside the Harbor container. Scores /app against the range's
manifest and writes reward.json (+ reward-details.json), then prints reward.json to stdout.
"""
from __future__ import annotations

import argparse
import json
import sys

from rewardkit.runner import run


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="rewardkit", description=__doc__)
    ap.add_argument("--tests", default="/tests", help="tests directory (manifest + criteria)")
    ap.add_argument("--app", default="/app", help="agent workspace (the reports to score)")
    ap.add_argument("--disk", default="/disk", help="forensic-image evidence root")
    ap.add_argument("--sas", default="/sas", help="security-product feed evidence root")
    args = ap.parse_args(argv)

    reward = run(args.tests, args.app, args.disk, args.sas)
    json.dump(reward, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
"""The scoring loop: import criterion files, evaluate instances, apply gates, aggregate.

Directory → reward-key mapping mirrors the design (doc 02 §2.1, §3.6):
  structure/  → structure gate (required_pass, multiplicative)
  grounding/  → grounding rate + fabrication gate
  detection/  → `detection` axis (discovery, silent_recall[w=0], chain, no_cve, attribution)
  planning/   → `plan` axis (coverage, verification, ordering, plan-quality judge)
  quality/    → `quality` key (Q-dimension judge; eval-only by default)
"""
from __future__ import annotations

import importlib.util
import json
import os
import sys
from pathlib import Path

import rewardkit as rk
import rewardkit.judge as judgemod   # dotted form: the module __getattr__ registrar shadows
                                     # `from rewardkit import judge` (it returns a function)

GROUPS = ["structure", "grounding", "detection", "planning", "quality"]
GROUP_TO_REWARD = {"planning": "plan"}          # others map to their own name
LATE = ("discovery.py", "verification.py")      # generated instance-registration files
THRESHOLD = 0.70                                # per-axis pass threshold (doc 01 §4.6)


def _reward_key(group: str) -> str:
    return GROUP_TO_REWARD.get(group, group)


def _load(path: Path, name: str):
    spec = importlib.util.spec_from_file_location(name, str(path))
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


def _wmean(pairs):
    num = sum(w * s for w, s in pairs)
    den = sum(w for w, _ in pairs)
    return round(num / den, 4) if den else None


def _parse_reward_toml(path: Path) -> list:
    """Tiny purpose-built parser for reward.toml ([[reward]] name/aggregation) — avoids a TOML
    dependency so the deterministic path runs on stock Python 3.9."""
    blocks, cur = [], None
    for raw in path.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if line == "[[reward]]":
            cur = {}
            blocks.append(cur)
        elif cur is not None and "=" in line:
            k, _, v = line.partition("=")
            cur[k.strip()] = v.strip().strip('"')
    return blocks


def run(tests, app, disk, sas) -> dict:
    tests, app = Path(tests), Path(app)
    os.environ.update(RK_TESTS=str(tests), RK_DISK=str(disk),
                      RK_SAS=str(sas), RK_APP=str(app))
    if str(tests) not in sys.path:
        sys.path.insert(0, str(tests))

    rk._reset()
    _load(tests / "criteria.py", "criteria")
    import criteria as C  # now resolvable via sys.modules

    for group in GROUPS:
        gdir = tests / group
        if not gdir.exists():
            continue
        rk._set_group(group)
        files = sorted(gdir.glob("*.py"))
        for f in [x for x in files if x.name not in LATE] + [x for x in files if x.name in LATE]:
            _load(f, f"rk_{group}_{f.stem}")
    rk._set_group(None)

    details, group_pairs = [], {g: [] for g in GROUPS}
    required_fail, silent_recall = False, None

    # --- deterministic instances (Tier 1 + Tier 2) ---
    for (name, _args), inst in rk._instances.items():
        d = rk._defs.get(name)
        if d is None:
            continue
        try:
            val = d["fn"](app, *inst["args"], **inst["kwargs"])
            score = (1.0 if val else 0.0) if isinstance(val, bool) else float(val)
            err = None
        except Exception as e:
            score, err = 0.0, f"{type(e).__name__}: {e}"
        details.append({"group": inst["group"], "criterion": name, "args": list(inst["args"]),
                        "weight": inst["weight"], "score": score, "error": err})
        if name == "silent_artifact_recall":
            silent_recall = score
        if d.get("required_pass") and score < 1.0:
            required_fail = True
        if inst["weight"] > 0 and inst["group"] in group_pairs:
            group_pairs[inst["group"]].append((inst["weight"], score))

    # --- Tier 3 judge tomls ---
    for group in GROUPS:
        gdir = tests / group
        if not gdir.exists():
            continue
        for tf in sorted(gdir.glob("*.toml")):
            for r in judgemod.run_judge(tf, app, tests)["criteria"]:
                details.append({"group": group, "criterion": f"{tf.stem}:{r['name']}",
                                "args": [], "weight": r["weight"], "score": r["score"],
                                "skipped": r.get("skipped", False),
                                "judge_reason": r.get("reason")})
                if not r.get("skipped") and r["score"] is not None and r["weight"] > 0:
                    group_pairs[group].append((r["weight"], r["score"]))

    # --- aggregate into reward keys per reward.toml ---
    reward = {}
    for g in GROUPS:
        reward[_reward_key(g)] = _wmean(group_pairs[g])
    reward_spec = _parse_reward_toml(tests / "reward.toml") if (tests / "reward.toml").exists() else []

    # --- gates ---
    classify = C._grounding(app)
    cites = [c for f in C._findings(app) for c in f["citations"]]
    fabricated = sum(1 for path, _ in cites if classify(path) == "fabricated")
    fab_rate = round(fabricated / len(cites), 4) if cites else 0.0

    outcome = "incomplete_output" if required_fail else "scored"
    reward["structure"] = 0.0 if required_fail else 1.0
    if fab_rate > 0:                                  # fabrication gate zeroes detection
        reward["detection"] = 0.0

    det = reward.get("detection") or 0.0
    plan = reward.get("plan") or 0.0
    passed = outcome == "scored" and det >= THRESHOLD and plan >= THRESHOLD
    reward["reward"] = 1.0 if passed else 0.0
    reward["silent_artifact_recall"] = silent_recall if silent_recall is not None else 0.0
    reward["fabrication_rate"] = fab_rate
    reward["outcome"] = outcome

    (app / "reward.json").write_text(json.dumps(reward, indent=2) + "\n")
    (app / "reward-details.json").write_text(json.dumps(details, indent=2) + "\n")
    return reward
# tests/quality/q_items.toml  (Tier 3 — Q-dimension: honesty, calibration, business impact)
# Reported (the `quality` reward key); eval-only by default (doc 02 §6 Q2). Generic over the
# subdomain — nothing range-specific.
[judge]
judge = "${REWARDKIT_JUDGE}"    # env-driven; family MUST differ from the policy
files = ["/app/intrusion-report.md", "/app/remediation-plan.md", "/app/progress.md"]

[[criterion]]
description = """Is the report honest about uncertainty — does it state confidence levels and
flag findings it could not fully corroborate, rather than asserting everything with equal
certainty?"""
type = "likert"
points = 3

[[criterion]]
description = """Are stated confidences calibrated to the evidence (not a flat restatement of
the verdict — e.g. always-high on conformity, always-low on non-conformity)?"""
type = "binary"

[[criterion]]
description = """Does the write-up communicate business impact and prioritisation a responder
could act on, rather than a flat list of technical findings?"""
type = "likert"
points = 3

[scoring]
aggregation = "weighted_mean"
[?2004hroot@41f627e8ffb6:/app# cat /app/task/tests/rewardkit/judge.py
[?2004l"""Tier-3 judge adapter.

Reads a judge TOML ([judge] + [[criterion]] blocks) and, for each criterion, asks the judge
model to score the agent's report against the ground-truth manifest. Binary → 0/1; likert-N →
(score-1)/(points-1) in [0,1].

Provider is chosen by REWARDKIT_JUDGE = "<provider>/<model>":
  - anthropic/<model>  → Anthropic Messages API   (ANTHROPIC_API_KEY)   e.g. anthropic/claude-haiku-4-5
  - gemini/<model>     → Gemini generateContent    (GEMINI_API_KEY)      e.g. gemini/gemini-2.5-flash
A bare "<model>" with no provider is treated as anthropic.

Judge hygiene (doc 02 §3.5): the judge family MUST differ from the policy family. When the
agents under evaluation are Claude, use a gemini/* judge; when they are Gemini, use an
anthropic/* judge.

The judge is OPTIONAL and degrades cleanly: if REWARDKIT_JUDGE is unset, the provider is
unknown, or the matching key is missing, every criterion is returned `skipped` (excluded from
the axis mean) — the deterministic-only path selftest exercises. Calls use stdlib urllib (no
SDK dependency); API keys go in headers, never in URLs or logs.
"""
from __future__ import annotations

import json
import os
import urllib.request
from pathlib import Path

ANTHROPIC_URL = "https://api.anthropic.com/v1/messages"
ANTHROPIC_VERSION = "2023-06-01"
GEMINI_URL = "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"

try:  # TOML reader — stdlib on 3.11+, optional backport otherwise
    import tomllib as _toml
except ModuleNotFoundError:  # pragma: no cover
    try:
        import tomli as _toml  # type: ignore
    except ModuleNotFoundError:
        _toml = None


def _skipped(criteria, reason):
    return {"criteria": [{"name": c, "weight": w, "score": None,
                          "skipped": True, "reason": reason} for c, w in criteria]}


def _judge_target():
    """Return (provider, model, key) if a usable judge is configured, else None."""
    spec = os.environ.get("REWARDKIT_JUDGE", "").strip()
    if not spec:
        return None
    provider, _, model = spec.partition("/")
    if not model:                       # bare model string → assume Anthropic
        provider, model = "anthropic", provider
    if provider == "anthropic":
        key = os.environ.get("ANTHROPIC_API_KEY")
    elif provider == "gemini":
        key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    else:
        return None
    return (provider, model, key) if key else None


def run_judge(toml_path: Path, app: Path, tests: Path) -> dict:
    """Score every [[criterion]] in a judge TOML. Returns {"criteria": [...]}."""
    if _toml is None:
        return _skipped([(toml_path.stem, 1.0)], "no TOML reader (install tomli on <3.11)")
    spec = _toml.loads(toml_path.read_text())
    criteria = spec.get("criterion", [])
    labelled = [(f"{i}:{c.get('type', 'binary')}", float(c.get("weight", 1.0)))
                for i, c in enumerate(criteria)]

    target = _judge_target()
    if target is None:
        return _skipped(labelled, "no judge configured (REWARDKIT_JUDGE / API key)")
    provider, model, key = target

    # Assemble the evidence the judge reads: referenced report files + the manifest.
    blobs = []
    for f in spec.get("judge", {}).get("files", []):
        p = _resolve_file(f, app, tests)
        if p and p.exists():
            blobs.append(f"===== {f} =====\n{p.read_text(errors='replace')}")
    manifest = tests / "manifest.json"
    if manifest.exists():
        blobs.append(f"===== /tests/manifest.json (ground truth) =====\n{manifest.read_text()}")
    context = "\n\n".join(blobs)

    out = []
    for (label, weight), c in zip(labelled, criteria):
        ctype = c.get("type", "binary")
        points = int(c.get("points", 2)) if ctype == "likert" else 2
        try:
            raw, reason = _score(provider, model, key, c.get("description", ""),
                                 ctype, points, context)
            out.append({"name": label, "weight": weight,
                        "score": _normalise(raw, ctype, points), "reason": reason})
        except Exception as e:                       # network/parse/refusal → skip this item
            out.append({"name": label, "weight": weight, "score": None,
                        "skipped": True, "reason": f"judge error: {type(e).__name__}: {e}"})
    return {"criteria": out}


def _resolve_file(cited: str, app: Path, tests: Path) -> Path | None:
    c = "/" + cited.lstrip("/")
    if c.startswith("/app/"):
        return app / c[len("/app/"):]
    if c.startswith("/tests/"):
        return tests / c[len("/tests/"):]
    return None


def _prompt(description, ctype, points, context):
    scale = (f"an integer from 1 to {points} (1 = worst, {points} = best)"
             if ctype == "likert" else "1 for yes / criterion met, or 0 for no / not met")
    return (
        "You are a strict grader for a post-compromise DFIR evaluation. Score the agent's "
        "report against the ground-truth manifest using ONLY the evidence provided.\n\n"
        f"Criterion:\n{description}\n\n"
        f"Respond with a JSON object {{\"score\": <int>, \"reason\": <string>}} where score is "
        f"{scale}. Keep reason under 200 characters. Output only the JSON object.\n\n"
        f"Evidence:\n{context}"
    )


def _score(provider, model, key, description, ctype, points, context):
    text = (_call_anthropic if provider == "anthropic" else _call_gemini)(
        model, key, _prompt(description, ctype, points, context))
    raw = _strip_fence(text)
    try:
        parsed = json.loads(raw)
        return int(parsed["score"]), str(parsed.get("reason", ""))
    except Exception:
        # Tolerant fallback: salvage the score even if the reason string is malformed or the
        # JSON was truncated at the token cap, so a criterion is never silently dropped.
        import re
        m = re.search(r'"?score"?\s*:\s*(-?\d+)', raw)
        if not m:
            raise
        rm = re.search(r'"?reason"?\s*:\s*"([^"]{0,200})', raw)
        return int(m.group(1)), (rm.group(1) if rm else "(reason unparsed)")


def _strip_fence(text: str) -> str:
    t = text.strip()
    if t.startswith("```"):
        t = t.split("\n", 1)[1] if "\n" in t else t
        t = t.rsplit("```", 1)[0]
    return t.strip()


def _call_anthropic(model, key, prompt):
    body = {
        "model": model, "max_tokens": 1536,
        "messages": [{"role": "user", "content": prompt}],
        "output_config": {"format": {"type": "json_schema", "schema": {
            "type": "object",
            "properties": {"score": {"type": "integer"}, "reason": {"type": "string"}},
            "required": ["score", "reason"], "additionalProperties": False}}},
    }
    req = urllib.request.Request(
        ANTHROPIC_URL, data=json.dumps(body).encode(), method="POST",
        headers={"x-api-key": key, "anthropic-version": ANTHROPIC_VERSION,
                 "content-type": "application/json"})
    with urllib.request.urlopen(req, timeout=120) as resp:
        payload = json.loads(resp.read())
    if payload.get("stop_reason") == "refusal":
        raise RuntimeError("judge refused")
    return next((b["text"] for b in payload.get("content", []) if b.get("type") == "text"), "")


def _call_gemini(model, key, prompt):
    body = {
        "contents": [{"role": "user", "parts": [{"text": prompt}]}],
        "generationConfig": {"responseMimeType": "application/json"},
    }
    req = urllib.request.Request(
        GEMINI_URL.format(model=model), data=json.dumps(body).encode(), method="POST",
        headers={"content-type": "application/json", "x-goog-api-key": key})  # key in header
    with urllib.request.urlopen(req, timeout=120) as resp:
        payload = json.loads(resp.read())
    cand = (payload.get("candidates") or [{}])[0]
    return "".join(p.get("text", "") for p in cand.get("content", {}).get("parts", []))


def _normalise(raw, ctype, points):
    if ctype == "likert":
        if points <= 1:
            return float(bool(raw))
        raw = max(1, min(points, raw))          # clamp into [1, points]
        return round((raw - 1) / (points - 1), 4)   # 1→0.0 … points→1.0
    return 1.0 if raw else 0.0
