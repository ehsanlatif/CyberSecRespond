[32.896031, "o", "tests/rewardkit/judge.py\r\ntests/rewardkit/__main__.py\r\ntests/rewardkit/__init__.py\r\ntests/rewardkit/runner.py\r\ntests/criteria.py\r\n"]
[32.896504, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[37.66365, "i", "cat tests/rewardkit/runner.py\n"]
[37.665043, "o", "cat tests/rewardkit/runner.py\r\n\u001b[?2004l\r"]
[37.665634, "o", "\"\"\"The scoring loop: import criterion files, evaluate instances, apply gates, aggregate."]
[37.665747, "o", "\r\n\r\nDirectory → reward-key mapping mirrors the design (doc 02 §2.1, §3.6):\r\n  structure/  → structure gate (required_pass, multiplicative)\r\n  grounding/  → grounding rate + fabrication gate\r\n  detection/  → `detection` axis (discovery, silent_recall[w=0], chain, no_cve, attribution)\r\n  planning/   → `plan` axis (coverage, verification, ordering, plan-quality judge)\r\n  quality/    → `quality` key (Q-dimension judge; eval-only by default)\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport importlib.util\r\nimport json\r\n"]
[37.665803, "o", "import os\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nimport rewardkit.judge as judgemod   # dotted form: the module __getattr__ registrar shadows\r\n                                     # `from rewardkit import judge` (it returns a function)\r\n\r\nGROUPS = [\"structure\", \"grounding\", \"detection\", \"planning\", \"quality\"]\r\nGROUP_TO_REWARD = {\"planning\": \"plan\"}          # others map to their own name\r\nLATE = (\"discovery.py\", \"verification.py\")      # generated instance-registration files\r\nTHRESHOLD = 0.70                                # per-axis pass threshold (doc 01 §4.6)\r\n\r\n\r\ndef _reward_key(group: str) -> str:\r\n    return GROUP_TO_REWARD.get(group, group)\r\n\r\n\r\ndef _load(path: Path, name: str):\r\n    spec = importlib.util.spec_from_file_location(name, str(path))\r\n    mod = importlib.util.module_from_spec(spec)\r\n    sys.modules[name] = mod\r\n    spec.loader.exec_module(mod)\r\n    return mod"]
[37.665977, "o", "\r\n\r\n\r\ndef _wmean(pairs):\r\n    num = sum(w * s for w, s in pairs)\r\n    den = sum(w for w, _ in pairs)\r\n    return round(num / den, 4) if den else None\r\n\r\n\r\ndef _parse_reward_toml(path: Path) -> list:\r\n    \"\"\"Tiny purpose-built parser for reward.toml ([[reward]] name/aggregation) — avoids a TOML\r\n    dependency so the deterministic path runs on stock Python 3.9.\"\"\"\r\n    blocks, cur = [], None\r\n    for raw in path.read_text().splitlines():\r\n        line = raw.split(\"#\", 1)[0].strip()\r\n        if line == \"[[reward]]\":\r\n            cur = {}\r\n            blocks.append(cur)"]
[37.666052, "o", "\r\n        elif cur is not None and \"=\" in line:\r\n            k, _, v = line.partition(\"=\")\r\n            cur[k.strip()] = v.strip().strip('\"')\r\n    return blocks\r\n\r\n\r\ndef run(tests, app, disk, sas) -> dict:\r\n    tests, app = Path(tests), Path(app)\r\n    os.environ.update(RK_TESTS=str(tests), RK_DISK=str(disk),\r\n                      RK_SAS=str(sas), RK_APP=str(app))\r\n    if str(tests) not in sys.path:\r\n        sys.path.insert(0, str(tests))\r\n\r\n    rk._reset()\r\n    _load(tests / \"criteria.py\", \"criteria\")\r\n    import criteria as C  # now resolvable via sys.modules\r\n\r\n    for group in GROUPS:\r\n        gdir = tests / group\r\n        if not gdir.exists():\r\n            continue\r\n        rk._set_group(group)\r\n        files = sorted(gdir.glob(\"*.py\"))\r\n        for f in [x for x in files if x.name not in LATE] + [x for x in files if x.name in LATE]:\r\n            _load(f, f\"rk_{group}_{f.stem}\")\r\n    rk._set_group(None)\r\n\r\n    details, group_pairs = [], {g: [] for g in GROUPS}\r\n    required_fail, silent_recall = False, None\r\n\r\n    # --- deterministic instances (Tier 1 + Tier 2) ---\r\n    for (name, _args), inst in rk._instances.items():\r\n        d = rk._defs.get(name)\r\n        if d is None:\r\n            continue\r\n        try:\r\n            val = d[\"fn\"](app, *inst[\"args\"], **inst[\"kwargs\"])\r\n            score = (1.0 if val else 0.0) if isinstance(val, bool) else float(val)\r\n            err = None\r\n        except Exception as e:\r\n            score, err = 0.0, f\"{type(e).__name__}: {e}\"\r\n        details.append({\"group\": inst[\"group\"], \"criterion\": name, \"args\": list(inst[\"args\"]),\r\n                        \"weight\": inst[\"weight\"], \"score\": score, \"error\": err})\r\n        if name == \"silent_artifact_recall\":\r\n            silent_recall = score\r\n        if d.get(\"required_pass\") and score < 1.0:\r\n            required_fail = True\r\n        if inst[\"weight\"] > 0 and inst[\"group\"] in group_pairs:\r\n            group_pairs[inst[\"group\"]].append((inst[\"weight\"], score))\r\n\r\n    # --- Tier 3 judge tomls ---\r\n    for group in GROUPS:\r\n        gdir = tests / group\r\n        if not gdir.exists():\r\n            continue\r\n        for tf in sorted(gdir.glob(\"*.toml\")):\r\n            for r in judgemod.run_judge(tf, app, tests)[\"criteria\"]:\r\n                details.append({\"group\": group, \"criterion\": f\"{tf.stem}:{r['name']}\",\r\n                                \"args\": [], \"weight\": r[\"weight\"], \"score\": r[\"score\"],\r\n                                \"skipped\": r.get(\"skipped\", False),\r\n                                \"judge_reason\": r.get(\"reason\")})\r\n                if not r.get(\"skipped\") and r[\"score\"] is not None and r[\"weight\"] > 0:\r\n                    group_pairs[group].append((r[\"weight\"], r[\"score\"]))\r\n\r\n    # --- aggregate into reward keys per reward.toml ---\r\n    reward = {}\r\n    for g in GROUPS:\r\n        reward[_reward_key(g)] = _wmean(group_pairs[g])\r\n    reward_spec = _parse_reward_toml(tests / \"reward.toml\") if (tests / \"reward.toml\").exists() else []\r\n\r\n    # --- gates ---\r\n    classify = C._grounding(app)\r\n    cites = [c for f in C._findings(app) for c in f[\"citations\"]]\r\n    fabricated = sum(1 for path, _ in cites if classify(path) == \"fabricated\")\r\n    fab_rate = round(fabricated / len(cites), 4) if cites else 0.0\r\n\r\n    outcome = \"incomplete_output\" if required_fail else \"scored\"\r\n    reward[\"structure\"] = 0.0 if required_fail else 1.0\r\n    if fab_rate > 0:                                  # fabrication gate zeroes detection\r\n        reward[\"detection\"] = 0.0\r\n\r\n    det = reward.get(\"detection\") or 0.0\r\n    plan = reward.get(\"plan\") or 0.0\r\n    passed = outcome == \"scored\" and det >= THRESHOLD and plan >= THRESHOLD\r\n    reward[\"reward\"] = 1.0 if passed else 0.0\r\n    reward[\"silent_artifact_recall\"] = silent_recall if silent_recall is not None else 0.0\r\n    reward[\"fabrication_rate\"] = fab_rate"]
[37.666063, "o", "\r\n    reward[\"outcome\"] = outcome\r\n\r\n    (app / \"reward.json\").write_text(json.dumps(reward, indent=2) + \"\\n\")\r\n    (app / \"reward-details.json\").write_text(json.dumps(details, indent=2) + \"\\n\")\r\n    return reward\r\n"]
[37.666287, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[37.765708, "i", "cat tests/rewardkit/judge.py\n"]
[37.766028, "o", "cat tests/rewardkit/judge.py\r\n\u001b[?2004l\r"]
[37.766957, "o", "\"\"\"Tier-3 judge adapter.\r\n\r\nReads a judge TOML ([judge] + [[criterion]] blocks) and, for each criterion, asks the judge\r\nmodel to score the agent's report against the ground-truth manifest. Binary → 0/1; likert-N →\r\n(score-1)/(points-1) in [0,1].\r\n\r\nProvider is chosen by REWARDKIT_JUDGE = \"<provider>/<model>\":\r\n  - anthropic/<model>  → Anthropic Messages API   (ANTHROPIC_API_KEY)   e.g. anthropic/claude-haiku-4-5\r\n  - gemini/<model>     → Gemini generateContent    (GEMINI_API_KEY)      e.g. gemini/gemini-2.5-flash\r\nA bare \"<model>\" with no provider is treated as anthropic.\r\n\r\nJudge hygiene (doc 02 §3.5): the judge family MUST differ from the policy family. When the\r\nagents under evaluation are Claude, use a gemini/* judge; when they are Gemini, use an\r\nanthropic/* judge.\r\n\r\nThe judge is OPTIONAL and degrades cleanly: if REWARDKIT_JUDGE is unset, the provider is\r\nunknown, or the matching key is missing, every criterion is returned `skipped` (excluded from\r\nthe axis mean) — the deterministic-only path selftest exercises. Calls use stdlib urllib (no\r\nSDK dependency); API keys go in headers, never in URLs or logs.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport os\r\nimport urllib.request\r\nfrom pathlib import Path\r\n\r\nANTHROPIC_URL = \"https://api.anthropic.com/v1/messages\"\r\nANTHROPIC_VERSION = \"2023-06-01\"\r\nGEMINI_URL = \"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent\"\r\n\r\ntry:  # TOML reader — stdlib on 3.11+, optional backport otherwise\r\n    import tomllib as _toml\r\nexcept ModuleNotFoundError:  # pragma: no cover\r\n    try:\r\n        import tomli as _toml  # type: ignore\r\n    except ModuleNotFoundError:\r\n        _toml = None\r\n\r\n\r\ndef _skipped(criteria, reason):\r\n    return {\"criteria\": [{\"name\": c, \"weight\": w, \"score\": None,\r\n                          \"skipped\": True, \"reason\": reason} for c, w in criteria]}\r\n\r\n\r\ndef _judge_target():\r\n    \"\"\"Return (provider, model, key) if a usable judge is configured, else None.\"\"\"\r\n    spec = os.environ.get(\"REWARDKIT_JUDGE\", \"\").strip()\r\n    if not spec:\r\n        return None\r\n    provider, _, model = spec.partition(\"/\")\r\n    if not model:                       # bare model string → assume Anthropic"]
[37.767145, "o", "\r\n        provider, model = \"anthropic\", provider\r\n    if provider == \"anthropic\":\r\n        key = os.environ.get(\"ANTHROPIC_API_KEY\")\r\n    elif provider == \"gemini\":\r\n        key = os.environ.get(\"GEMINI_API_KEY\") or os.environ.get(\"GOOGLE_API_KEY\")\r\n    else:\r\n        return None\r\n    return (provider, model, key) if key else None\r\n\r\n\r\ndef run_judge(toml_path: Path, app: Path, tests: Path) -> dict:\r\n    \"\"\"Score every [[criterion]] in a judge TOML. Returns {\"criteria\": [...]}.\"\"\"\r\n    if _toml is None:\r\n        return _skipped([(toml_path.stem, 1.0)], \"no TOML reader (install tomli on <3.11)\")\r\n    spec = _toml.loads(toml_path.read_text())\r\n    criteria = spec.get(\"criterion\", [])\r\n    labelled = [(f\"{i}:{c.get('type', 'binary')}\", float(c.get(\"weight\", 1.0)))\r\n                for i, c in enumerate(criteria)]\r\n\r\n    target = _judge_target()\r\n    if target is None:\r\n        return _skipped(labelled, \"no judge configured (REWARDKIT_JUDGE / API key)\")\r\n    provider, model, key = target\r\n\r\n    # Assemble the evidence the judge reads: referenced report files + the manifest.\r\n    blobs = []\r\n    for f in spec.get(\"judge\", {}).get(\"files\", []):\r\n        p = _resolve_file(f, app, tests)\r\n        if p and p.exists():\r\n            blobs.append(f\"===== {f} =====\\n{p.read_text(errors='replace')}\")\r\n    manifest = tests / \"manifest.json\"\r\n    if manifest.exists():\r\n        blobs.append(f\"===== /tests/manifest.json (ground truth) =====\\n{manifest.read_text()}\")\r\n    context = \"\\n\\n\".join(blobs)\r\n\r\n    out = []\r\n    for (label, weight), c in zip(labelled, criteria):\r\n        ctype = c.get(\"type\", \"binary\")\r\n        points = int(c.get(\"points\", 2)) if ctype == \"likert\" else 2\r\n        try:\r\n            raw, reason = _score(provider, model, key, c.get(\"description\", \"\"),\r\n                                 ctype, points, context)\r\n            out.append({\"name\": label, \"weight\": weight,\r\n                        \"score\": _normalise(raw, ctype, points), \"reason\": reason})\r\n        except Exception as e:                       # network/parse/refusal → skip this item\r\n            out.append({\"name\": label, \"weight\": weight, \"score\": None,\r\n                        \"skipped\": True, \"reason\": f\"judge error: {type(e).__name__}: {e}\"})\r\n    return {\"criteria\": out}\r\n\r\n\r\ndef _resolve_file(cited: str, app: Path, tests: Path) -> Path | None:\r\n    c = \"/\" + cited.lstrip(\"/\")\r\n    if c.startswith(\"/app/\"):\r\n        return app / c[len(\"/app/\"):]\r\n    if c.startswith(\"/tests/\"):\r\n        return tests / c[len(\"/tests/\"):]\r\n    return None\r\n\r\n\r\ndef _prompt(description, ctype, points, context):\r\n    scale = (f\"an integer from 1 to {points} (1 = worst, {points} = best)\"\r\n             if ctype == \"likert\" else \"1 for yes / criterion met, or 0 for no / not met\")\r\n    return (\r\n        \"You are a strict grader for a post-compromise DFIR evaluation. Score the agent's \"\r\n        \"report against the ground-truth manifest using ONLY the evidence provided.\\n\\n\"\r\n        f\"Criterion:\\n{description}\\n\\n\"\r\n        f\"Respond with a JSON object {{\\\"score\\\": <int>, \\\"reason\\\": <string>}} where score is \"\r\n        f\"{scale}. Keep reason under 200 characters. Output only the JSON object.\\n\\n\"\r\n        f\"Evidence:\\n{context}\"\r\n    )\r\n\r\n\r\ndef _score(provider, model, key, description, ctype, points, context):\r\n    text = (_call_anthropic if provider == \"anthropic\" else _call_gemini)(\r\n        model, key, _prompt(description, ctype, points, context))\r\n    raw = _strip_fence(text)\r\n    try:\r\n        parsed = json.loads(raw)\r\n        return int(parsed[\"score\"]), str(parsed.get(\"reason\", \"\"))\r\n    except Exception:\r\n        # Tolerant fallback: salvage the score even if the reason string is malformed or the\r\n        # JSON was truncated at the token cap, so a criterion is never silently dropped.\r\n        import re\r\n        m = re.search(r'\"?score\"?\\s*:\\s*(-?\\d+)', raw)\r\n        if not m:\r\n            raise\r\n        rm = re.search(r'\"?reason\"?\\s*:\\s*\"([^\"]{0,200})', raw)\r\n        return int(m.group(1)), (rm.group(1) if rm else \"(reason unparsed)\")\r\n\r\n\r\ndef _strip_fence(text: str"]
[37.767174, "o", ") -> str:\r\n    t = text.strip()\r\n    if t.startswith(\"```\"):\r\n        t = t.split(\"\\n\", 1)[1] if \"\\n\" in t else t\r\n        t = t.rsplit(\"```\", 1)[0]\r\n    return t.strip()\r\n\r\n\r\ndef _call_anthropic(model, key, prompt):\r\n    body = {\r\n        \"model\": model, \"max_tokens\": 1536,\r\n        \"messages\": [{\"role\": \"user\", \"content\": prompt}],\r\n        \"output_config\": {\"format\": {\"type\": \"json_schema\", \"schema\": {\r\n            \"type\": \"object\",\r\n            \"properties\": {\"score\": {\"type\": \"integer\"}, \"reason\": {\"type\": \"string\"}},\r\n            \"required\": [\"score\", \"reason\"], \"additionalProperties\": False}}},\r\n    }\r\n    req = urllib.request.Request(\r\n        ANTHROPIC_URL, data=json.dumps(body).encode(), method=\"POST\",\r\n        headers={\"x-api-key\": key, \"anthropic-version\": ANTHROPIC_VERSION,\r\n                 \"content-type\": \"application/json\"})\r\n    with urllib.request.urlopen(req, timeout=120) as resp:\r\n        payload = json.loads(resp.read())\r\n    if payload.get(\"stop_reason\") == \"refusal\":\r\n        raise RuntimeError(\"judge refused\")\r\n    return next((b[\"text\"] for b in payload.get(\"content\", []) if b.get(\"type\") == \"text\"), \"\")\r\n\r\n\r\ndef _call_gemini(model, key, prompt):\r\n    body = {\r\n        \"contents\": [{\"role\": \"user\", \"parts\": [{\"text\": prompt}]}],\r\n        \"generationConfig\": {\"responseMimeType\": \"application/json\"},\r\n    }\r\n    req = urllib.request.Request(\r\n        GEMINI_URL.format(model=model), data=json.dumps(body).encode(), method=\"POST\",\r\n        headers={\"content-type\": \"application/json\", \"x-goog-api-key\": key})  # key in header\r\n    with urllib.request.urlopen(req, timeout=120) as resp:\r\n        payload = json.loads(resp.read())\r\n    cand = (payload.get(\"candidates\") or [{}])[0]\r\n    return \"\".join(p.get(\"text\", \"\") for p in cand.get(\"content\", {}).get(\"parts\", []))\r\n\r\n\r\ndef _normalise(raw, ctype, points):\r\n    if ctype == \"likert\":\r\n        if points <= 1:\r\n            return float(bool(raw))\r\n        raw = max(1, min(points, raw))          # clamp into [1, points]\r\n        return round((raw - 1) / (points - 1), 4)   # 1→0.0 … points→1.0\r\n    return 1.0 if raw else 0.0\r\n\u001b[?2004h"]
