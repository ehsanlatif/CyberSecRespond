[21.215287, "o", "\r\n      \"attck\": \"T1486\",\r\n      \"desc\": \"ransomware encryption\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1546.003\",\r\n      \"desc\": \"WMI event subscription\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {"]
[21.215379, "o", "\r\n      \"step\": 6,\r\n      \"attck\": \"T1574.001\",\r\n      \"desc\": \"DLL search-order hijack\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 7,\r\n"]
[21.215566, "o", "      \"attck\": \"T1070.001\",\r\n      \"desc\": \"System event log clear\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n"]
[21.215613, "o", "    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/Windows/Temp/mssecsvc.exe\",\r\n      \"kind\": \"exploit-implant\",\r\n      \"capability\": \"VUL-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"cve\": \"CVE-2017-0144\",\r\n      \"attck\": \"T1210\",\r\n      \"match\": [\r\n        \"smb\",\r\n        \"doublepulsar\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/Windows/Temp/lsass.dmp\",\r\n      \"kind\": \"credential-dump\",\r\n      \"capability\": \"ENT-F01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1003.001\",\r\n      \"match\": [\r\n        \"lsass\",\r\n        \"dump\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/Users/Public/enc.exe\",\r\n      \"kind\": \"ransomware-binary\",\r\n      \"capability\": \"ENT-F02\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1486\",\r\n      \"match\": [\r\n        \"encrypt\",\r\n        \"ransom\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/Windows/System32/wbem/Repository/OBJECTS.DATA\",\r\n      \"kind\": \"wmi-subscription\",\r\n      \"capability\": \"PER-W01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1546.003\",\r\n      \"match\": [\r\n        \"EventFilter\",\r\n        \"CommandLineEventConsumer\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/Windows/System32/wbem/wbemcomn.dll\",\r\n      \"kind\": \"hijacked-dll\",\r\n      \"capability\": \"PER-V01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1574.001\",\r\n      \"match\": [\r\n        \"hijack\",\r\n        \"sideload\"\r\n      ]\r\n"]
[21.215651, "o", "    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"path\": \"/Windows/System32/winevt/Logs/System.evtx\",\r\n      \"kind\": \"cleared-eventlog\",\r\n      \"capability\": \"ENT-F04\",\r\n      \"alerted\": false,\r\n      \"weight\": 1.5,\r\n      \"attck\": \"T1070.001\",\r\n      \"match\": [\r\n        \"cleared\",\r\n        \"1102\"\r\n      ]\r\n"]
