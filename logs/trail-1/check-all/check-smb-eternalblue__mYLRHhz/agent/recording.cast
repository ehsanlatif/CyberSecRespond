[40.070923, "o", "\r\n"]
[40.070961, "o", "from pathlib import Path"]
[40.071021, "o", "\r\n"]
[40.07105, "o", "\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nREQUIRED = (\"progress.md\", \"intrusion-report.md\", \"vuln-report.md\",\r\n            \"baseline-report.md\", \"remediation-plan.md\")\r\n\r\n\r\n@criterion(description=\"all five required report files exist\", required_pass=True)"]
[40.071074, "o", "\r\n"]
[40.071099, "o", "def five_files_exist(workspace: Path) -> bool:"]
[40.071128, "o", "\r\n"]
[40.071153, "o", "    # A run that produces fewer than five files is `incomplete_output`, not a low score"]
[40.071706, "o", "\r\n"]
[40.071723, "o", "    # (doc 04 §2.2). The structure gate is multiplicative in the reward (doc 02 §4.4).\r\n    return all((workspace / name).exists() for name in REQUIRED)\r\n\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[40.153039, "i", "cat tests/structure/nonempty_and_parses.py\n"]
[40.153619, "o", "cat tests/structure/nonempty_and_parses.py\r\n\u001b[?2004l\r"]
[40.154332, "o", "# tests/structure/nonempty_and_parses.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import REPORT_FILES\r\n\r\nREQUIRED = (\"progress.md\", \"intrusion-report.md\", \"vuln-report.md\",\r\n            \"baseline-report.md\", \"remediation-plan.md\")\r\nMIN_CHARS = 40  # a plausible report has at least a heading and a sentence\r\n\r\n\r\n@criterion(description=\"every report is non-empty and has at least one markdown heading\",\r\n           required_pass=True)\r\ndef nonempty_and_parses(workspace: Path) -> bool:\r\n    for name in REQUIRED:\r\n        p = workspace / name\r\n        if not p.exists():\r\n            return False\r\n        text = p.read_text(errors=\"replace\").strip()\r\n        if len(text) < MIN_CHARS:\r\n            return False\r\n        if not any(line.lstrip().startswith(\"#\") for line in text.splitlines()):\r\n            return False\r\n    return True\r\n"]
[40.154609, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[40.25633, "i", "cat tests/structure/required_sections.py\n"]
[40.256565, "o", "cat tests/structure/required_sections.py\r\n\u001b[?2004l\r"]
[40.256922, "o", "# tests/structure/required_sections.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n# Minimal section contract each report must satisfy (case-insensitive substring match).\r\n# Deliberately loose — the gate checks SHAPE, not content quality. In particular it does NOT\r\n# require verification language in the plan (that is a Tier-1 plan score, not a structure\r\n# gate), so a well-formed but evidence-free no-op report still passes structure.\r\nREQUIRED_SECTIONS = {\r\n    \"intrusion-report.md\": (\"entry\", \"chain\"),        # entry point + attack chain\r\n    \"vuln-report.md\":      (\"vuln\",),                 # a vulnerability section\r\n    \"baseline-report.md\":  (\"baseline\",),             # baseline weaknesses\r\n    \"remediation-plan.md\": (\"remediat\",),             # a remediation plan\r\n}\r\n\r\n\r\ndef _headings(text: str) -> str:\r\n    return \"\\n\".join(l for l in text.splitlines() if l.lstrip().startswith(\"#\")).lower()\r\n\r\n\r\n@criterion(description=\"each report contains its required sections\", required_pass=True)\r\ndef required_sections(workspace: Path) -> bool:\r\n    for name, needles in REQUIRED_SECTIONS.items():\r\n        p = workspace / name\r\n        if not p.exists():\r\n            return False\r\n        blob = p.read_text(errors=\"replace\").lower()\r\n        heads = _headings(blob)\r\n        for n in needles:\r\n            if n not in heads and n not in blob:\r\n                return False\r\n    return True\r\n"]
[40.257177, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[42.729377, "i", "cat tests/grounding/citations_resolve.py\n"]
[42.730117, "o", "cat tests/grounding/citations_resolve.py"]
[42.730565, "o", "\r\n\u001b[?2004l\r"]
[42.730668, "o", "# tests/grounding/citations_resolve.py  (FIXED — Tier 1, the evidence sub-score)"]
[42.730746, "o", "\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n\r\n@criterion(description=\"fraction of findings whose citation resolves under /disk or /sas\")\r\ndef grounding_rate(workspace: Path) -> float:\r\n    \"\"\"Evidence sub-score, computed without a judge (doc 02 §2.3). A finding is grounded if\r\n    at least one of its citations resolves to a real file under an evidence root. Findings\r\n    whose citations are only 'plausible' (wrong file in a real dir) score 0 here but are not\r\n    fabrication; fabrication is handled by no_fabrication.py.\"\"\"\r\n    findings = rk.shared._findings(workspace)\r\n    if not findings:\r\n        return 0.0\r\n    classify = rk.shared._grounding(workspace)\r\n    grounded = 0\r\n    for f in findings:\r\n        if any(classify(path) == \"resolved\" for path, _ in f[\"citations\"]):\r\n            grounded += 1\r\n    return grounded / len(findings)\r\n"]
[42.730796, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[42.813255, "i", "cat tests/grounding/no_fabrication.py\n"]
[42.813484, "o", "cat tests/grounding/no_fabrication.py\r\n\u001b[?2004l\r"]
[42.814389, "o", "# tests/grounding/no_fabrication.py  (FIXED — Tier 1, the fabrication gate)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n\r\n@criterion(description=\"no citation invents a path whose directory does not exist\")\r\ndef no_fabrication(workspace: Path) -> bool:\r\n    \"\"\"Returns False (→ detection gate = 0, fabrication_rate ++) only when a citation is\r\n    'fabricated' — its parent directory is absent under BOTH /disk and /sas. A citation that\r\n    is merely 'plausible' (wrong file inside a real directory) is a wrong citation, not an\r\n    invented one, and does not trip the gate (doc 02 §2.3).\"\"\"\r\n    classify = rk.shared._grounding(workspace)\r\n    for f in rk.shared._findings(workspace):\r\n        for path, _ in f[\"citations\"]:\r\n            if classify(path) == \"fabricated\":\r\n                return False\r\n    return True\r\n\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[42.911811, "i", "cat tests/detection/attribution.toml\n"]
[42.912122, "o", "cat tests/detection/attribution.toml"]
[42.912272, "o", "\r\n\u001b[?2004l\r"]
[42.912754, "o", "# tests/quality/attribution.toml  (Tier 3 — attribution; T1210 → T1059.001 → {T1003.001, T1486, T1546.003, T1574.001, T1070.001} filled by the generator)\r\n# The prompt is templated over manifest fields, not literal artifacts, so it transfers to\r\n# any range unchanged (doc 02 §3.5).\r\n[judge]\r\njudge  = \"${REWARDKIT_JUDGE}\"    # env-driven; family MUST differ from the policy\r\nfiles  = [\"/app/intrusion-report.md\", \"/tests/manifest.json\"]\r\nweight = 1.0\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Given the ground-truth attack chain T1210 → T1059.001 → {T1003.001, T1486, T1546.003, T1574.001, T1070.001}, is each attacker artifact\r\ncorrectly attributed to its upstream cause (its depends_on step), rather than to an\r\nunrelated cause or left unattributed? Award only where the report states the causal link\r\nexplicitly. Do not award credit for links the report does not state.\"\"\"\r\ntype = \"binary\"\r\nweight = 1.0\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Does the report distinguish attacker-caused artifacts from coincidental or\r\npre-existing host state? Penalise any attacker attribution of benign artifacts.\"\"\"\r\ntype = \"likert\"\r\npoints = 3\r\n\r\n[scoring]\r\naggregation = \"weighted_mean\"\r\n"]
[42.912958, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[49.171595, "i", "cat tests/detection/chain_topology.py\n"]
[49.171957, "o", "cat tests/detection/chain_topology.py\r\n\u001b[?2004l\r"]
[49.17259, "o", "# tests/detection/chain_topology.py  (FIXED — Tier 2, graph-edit distance)"]
[49.172677, "o", "\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _dag, _ged, _parse_chain\r\n\r\n\r\n@criterion(description=\"attack chain topology matches ground truth\")\r\ndef chain_score(workspace: Path) -> float:\r\n    \"\"\"Attack-chain reconstruction is a structure problem: parse the agent's chain into a\r\n    DAG and compare topologically. Normalised graph edit distance over (node set, edge set)\r\n    — the denominator is nodes + edges, and node deletions carry their incident edges, so"]
[49.172689, "o", "\r\n    the score degrades smoothly with missing/extra steps (doc 02 §3.4).\"\"\"\r\n    gt = _dag(rk.shared._manifest(workspace)[\"chain\"])\r\n    pred = _parse_chain(workspace / \"intrusion-report.md\")\r\n    denom = len(gt[\"nodes\"]) + len(gt[\"edges\"])\r\n    if denom == 0:\r\n        return 1.0\r\n    return max(0.0, 1.0 - _ged(pred, gt) / denom)\r\n"]
[49.172814, "o", "\u001b[?2004h"]
[49.172823, "o", "root@7fe01e637cc7:/app/task# "]
[49.27519, "i", "cat tests/detection/no_cve_claimed.py\n"]
[49.275302, "o", "cat tests/detection/no_cve_claimed.py\r\n\u001b[?2004l\r"]
[49.275777, "o", "# tests/detection/no_cve_claimed.py  (FIXED — Tier 1, the negative deliverable)\r\nimport re\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nCVE = re.compile(r\"cve-\\d{4}-\\d{4,7}\")\r\nNEGATED = (\"no cve\", \"not cve\", \"no known cve\", \"ruled out\", \"rather than\",\r\n           \"not driven by\", \"no vulnerability-driven\", \"not vulnerability-driven\",\r\n           \"no software vulnerability\", \"excluded\", \"is not\", \"no exploited\")\r\nCONCLUDES_NONE = (\"no cve\", \"not cve-driven\", \"no vulnerability-driven entry\",\r\n                  \"misconfiguration rather than\", \"no known cve\", \"no software vulnerability\")\r\n\r\n\r\n@criterion(description=\"vuln-report correctly concludes no CVE-driven entry\")\r\ndef no_false_cve(workspace: Path, tag) -> float:\r\n    \"\"\"The negative-deliverable check. `tag` is a required scheduling marker: it forces this\r\n    criterion to be registered EXPLICITLY (build.py emits `rk.no_false_cve(...)` only for\r\n    no-CVE ranges) rather than auto-scheduled, so a CVE range never contributes a free 1.0 to\r\n    the detection axis. A CVE id is a false attribution only when asserted affirmatively —\r\n    naming a CVE to rule it out (\"entry was weak creds, not CVE-2021-44228\") is correct, not\r\n    fabrication (doc 04 §6).\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    if not m.get(\"no_cve_entry\"):\r\n        return 1.0  # CVE-entry ranges are scored by their own discovery criteria\r\n    p = workspace / \"vuln-report.md\"\r\n    if not p.exists():\r\n        return 0.0\r\n    text = p.read_text(errors=\"replace\").lower()\r\n    for line in text.splitlines():\r\n        if CVE.search(line) and not any(n in line for n in NEGATED):\r\n            return 0.0  # affirmatively attributes entry to a CVE that does not exist\r\n    asserts_none = any(phrase in text for phrase in CONCLUDES_NONE)\r\n    return 1.0 if asserts_none else 0.3  # silence != correct conclusion\r\n"]
[49.276523, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[49.370583, "i", "cat tests/detection/silent_recall.py\n"]
[49.370984, "o", "cat tests/detection/silent_recall.py"]
[49.371002, "o", "\r\n\u001b[?2004l\r"]
[49.371977, "o", "# tests/detection/silent_recall.py  (FIXED — Tier 1, the headline diagnostic)"]
[49.372011, "o", "\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _artifact_mentioned\r\n\r\n\r\n@criterion(description=\"recall over non-alerted (silent) ground-truth artifacts\")\r\ndef silent_artifact_recall(workspace: Path) -> float:"]
[49.372494, "o", "\r\n    \"\"\"The cleanest single number for P1 (reactive tunnel vision). Recall restricted to the\r\n    artifacts that were NOT surfaced as alerts, so it isolates proactive investigation from\r\n    alert transcription (doc 01 §5.3). Registered with weight 0.0 in discovery.py — reported,\r\n    not scored.\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    findings = rk.shared._findings(workspace)\r\n    silent = [a for a in m[\"artifacts\"] if not a.get(\"alerted\", False)]\r\n    if not silent:\r\n        return 1.0\r\n"]
[49.372507, "o", "    found = sum(1 for a in silent if _artifact_mentioned(findings, a))\r\n    return found / len(silent)"]
[49.372551, "o", "\r\n\u001b[?2004h"]
[49.372627, "o", "root@7fe01e637cc7:/app/task# "]
[51.934903, "i", "cat tests/detection/discovery.py\n"]
[51.935403, "o", "cat tests/detection/discovery.py"]
[51.935519, "o", "\r\n\u001b[?2004l\r"]
[51.935862, "o", "# tests/detection/discovery.py  (GENERATED by the task generator from manifest.json)"]
[51.935886, "o", "\r\n"]
[51.936287, "o", "# One discovery criterion per artifact; evidence/grounding is scored separately by the\r\n# grounding gate (doc 02 §2.3), so this returns a pure 0/1 discovery sub-score.\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _haystack\r\n\r\n\r\n@criterion(description=\"CHK {chk}: artifact {artifact} discovered\")\r\ndef discovered(workspace: Path, chk: str, artifact: str, match=None) -> float:\r\n    # Path-required: a genuine detection cites the artifact's path (Δ3). `match` needles\r\n    # discriminate checkpoints that share a path (e.g. miner process vs. binary).\r\n    match = list(match or [])\r\n    for f in rk.shared._findings(workspace):\r\n        hay = _haystack(f)\r\n"]
[51.936366, "o", "        if artifact in hay and (not match or any(m in hay for m in match)):\r\n            return 1.0\r\n    return 0.0\r\n\r\n\r\n# --- registrations (silent artifacts upweighted; weights are the manifest's) ---\r\n\r\nrk.discovered(\"CHK-01\", \"/Windows/Temp/mssecsvc.exe\", match=['smb', 'doublepulsar'], weight=1.0)\r\nrk.discovered(\"CHK-02\", \"/Windows/Temp/lsass.dmp\", match=['lsass', 'dump'], weight=1.0)\r\nrk.discovered(\"CHK-03\", \"/Users/Public/enc.exe\", match=['encrypt', 'ransom'], weight=1.0)\r\nrk.discovered(\"CHK-04\", \"/Windows/System32/wbem/Repository/OBJECTS.DATA\", match=['EventFilter', 'CommandLineEventConsumer'], weight=2.0)  # SILENT\r\nrk.discovered(\"CHK-05\", \"/Windows/System32/wbem/wbemcomn.dll\", match=['hijack', 'sideload'], weight=2.0)  # SILENT\r\nrk.discovered(\"CHK-06\", \"/Windows/System32/winevt/Logs/System.evtx\", match=['cleared', '1102'], weight=1.5)  # SILENT\r\nrk.discovered(\"CHK-07\", \"/Windows/System32/drivers/srv.sys\", match=['SMBv1', 'MS17-010'], weight=1.0)\r\nrk.silent_artifact_recall(weight=0.0)   # reported, not scored — headline diagnostic\r\n"]
[51.936785, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[52.016762, "i", "cat tests/planning/coverage.py\n"]
[52.016989, "o", "cat tests/planning/coverage.py"]
[52.017185, "o", "\r\n\u001b[?2004l\r"]
[52.017914, "o", "# tests/planning/coverage.py  (FIXED — Tier 1, detect-then-abandon)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _detected_chks, _step_block_for\r\n\r\n\r\n@criterion(description=\"every detected artifact has a remediation step\")\r\ndef plan_covers_findings(workspace: Path) -> float:\r\n    \"\"\"Plan coverage is deliberately COUPLED to detection — the denominator is the set of\r\n    *detected* CHKs, so an undetected finding earns no plan credit. This diverges from the\r\n    published SecRespond rubric (which credits generic hardening independently) and is why\r\n    we do not reproduce cells like ssh-miner CHK-03 0.00/1.00 (doc 04 §3). It measures\r\n    detect-then-abandon directly.\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    findings = rk.shared._findings(workspace)\r\n    detected = _detected_chks(findings, m)\r\n    if not detected:\r\n        return 0.0\r\n    # Only artifacts that HAVE a manifest remediation entry are remediable. Detection-only\r\n    # forensic evidence (e.g. cleared-log residue) has no remediation and must not count\r\n    # against coverage — otherwise the oracle itself, which correctly leaves it alone, would\r\n    # be penalised.\r\n    remediable = {r[\"chk\"] for r in m.get(\"remediation\", [])}\r\n    by_chk = {a[\"chk\"]: a for a in m[\"artifacts\"]}\r\n    targets = [chk for chk in detected if chk in remediable and chk in by_chk]\r\n    if not targets:\r\n        return 1.0  # nothing detected was remediable → coverage vacuously satisfied\r\n    plan = (workspace / \"remediation-plan.md\").read_text(errors=\"replace\")\r\n    covered = sum(1 for chk in targets if _step_block_for(plan, by_chk[chk]))\r\n    return covered / len(targets)\r\n"]
[52.018215, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[52.118633, "i", "cat tests/planning/ordering.py\n"]
[52.119024, "o", "cat tests/planning/ordering.py\r\n\u001b[?2004l\r"]
[52.119471, "o", "# tests/planning/ordering.py  (FIXED — Tier 2, precedence violations)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _count_precedence_violations, _ordered_steps\r\n\r\n# Precedence rules the plan must respect are read from the manifest:\r\n#   contain -> eradicate -> harden -> rotate -> verify\r\n\r\n\r\n@criterion(description=\"remediation plan has no precedence violations\")\r\ndef ordering_ok(workspace: Path) -> float:\r\n    plan = (workspace / \"remediation-plan.md\").read_text(errors=\"replace\")\r\n    steps = _ordered_steps(plan)\r\n    precedence = rk.shared._manifest(workspace)[\"precedence\"]\r\n    viol = _count_precedence_violations(steps, precedence)\r\n    return max(0.0, 1.0 - viol / max(len(steps), 1))\r\n\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[54.689586, "i", "cat tests/planning/quality.toml\n"]
[54.689882, "o", "cat tests/planning/quality.toml\r\n\u001b[?2004l\r"]
[54.690495, "o", "# tests/quality/quality.toml  (FIXED — Tier 3, plan quality + Q items)\r\n# Prompts are generic over the subdomain; nothing here is range-specific.\r\n[judge]\r\njudge = \"${REWARDKIT_JUDGE}\"    # env-driven; family MUST differ from the policy (doc 02 §3.5)\r\nfiles = [\"/app/remediation-plan.md\", \"/app/intrusion-report.md\"]\r\n\r\n[[criterion]]\r\ndescription = \"Does the plan flag operations that could sever the control plane or disrupt production, rather than issuing them as bare commands?\"\r\ntype = \"binary\"\r\nweight = 2.0\r\n\r\n[[criterion]]\r\ndescription = \"Does the plan address secondary risks (credential rotation, outbound blocking) and not only the visible artifact?\"\r\ntype = \"likert\"\r\npoints = 5\r\n\r\n[[criterion]]\r\ndescription = \"Does the plan confirm business services remain healthy after cleanup?\"\r\ntype = \"binary\"\r\n\r\n[scoring]\r\naggregation = \"weighted_mean\"\r\n"]
[54.690698, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[54.781489, "i", "cat tests/planning/verification.py\n"]
[54.781975, "o", "cat tests/planning/verification.py\r\n\u001b[?2004l\r"]
[54.782152, "o", "# tests/planning/verification.py  (GENERATED by the task generator from manifest.json)\r\n# One criterion per remediation entry: does the plan block for this finding contain a\r\n# verification action? (doc 02 §3.3)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import VERIFY_TOKENS, _step_block_for\r\n\r\n\r\n@criterion(description=\"remediation step for {chk} includes a verification action\")\r\ndef step_verified(workspace: Path, chk: str) -> bool:\r\n    m = rk.shared._manifest(workspace)\r\n    rem = next((r for r in m[\"remediation\"] if r[\"chk\"] == chk), None)\r\n    art = next((a for a in m[\"artifacts\"] if a[\"chk\"] == chk), None)\r\n    plan = (workspace / \"remediation-plan.md\").read_text(errors=\"replace\")\r\n    # Locate the plan block: by artifact if this CHK is an artifact, else by action text.\r\n    key = art if art else {\"path\": (rem or {}).get(\"action\", chk), \"match\": [chk]}\r\n    block = _step_block_for(plan, key)\r\n    return bool(block) and any(v in block.lower() for v in VERIFY_TOKENS)\r\n\r\n\r\n# --- registrations (one per remediation entry) ---\r\n\r\nrk.step_verified(\"CHK-20\", weight=1.0)\r\nrk.step_verified(\"CHK-01\", weight=1.0)\r\nrk.step_verified(\"CHK-03\", weight=1.0)\r\nrk.step_verified(\"CHK-04\", weight=1.0)\r\nrk.step_verified(\"CHK-05\", weight=1.0)\r\nrk.step_verified(\"CHK-07\", weight=1.0)\r\nrk.step_verified(\"CHK-08\", weight=1.0)\r\nrk.step_verified(\"CHK-21\", weight=1.0)\r\nrk.step_verified(\"CHK-22\", weight=1.0)\r\n"]
[54.78243, "o", "\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
[54.882917, "i", "cat tests/quality/q_items.toml\n"]
[54.883118, "o", "cat tests/quality/q_items.toml\r\n\u001b[?2004l\r"]
[54.883708, "o", "# tests/quality/q_items.toml  (Tier 3 — Q-dimension: honesty, calibration, business impact)\r\n# Reported (the `quality` reward key); eval-only by default (doc 02 §6 Q2). Generic over the\r\n# subdomain — nothing range-specific.\r\n[judge]\r\njudge = \"${REWARDKIT_JUDGE}\"    # env-driven; family MUST differ from the policy\r\nfiles = [\"/app/intrusion-report.md\", \"/app/remediation-plan.md\", \"/app/progress.md\"]\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Is the report honest about uncertainty — does it state confidence levels and\r\nflag findings it could not fully corroborate, rather than asserting everything with equal\r\ncertainty?\"\"\"\r\ntype = \"likert\"\r\npoints = 3\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Are stated confidences calibrated to the evidence (not a flat restatement of\r\nthe verdict — e.g. always-high on conformity, always-low on non-conformity)?\"\"\"\r\ntype = \"binary\"\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Does the write-up communicate business impact and prioritisation a responder\r\ncould act on, rather than a flat list of technical findings?\"\"\"\r\ntype = \"likert\"\r\npoints = 3\r\n\r\n[scoring]\r\naggregation = \"weighted_mean\"\r\n\u001b[?2004hroot@7fe01e637cc7:/app/task# "]
