[26.151046, "o", "{\r\n  \"range_id\": \"rdp-ransomware\",\r\n  \"difficulty\": 3,\r\n  \"alert_coverage\": 0.67,\r\n  \"platform\": {\r\n    \"os\": \"windows\",\r\n    \"version\": \"server-2022\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1110\",\r\n      \"desc\": \"RDP brute force\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1021.001\",\r\n      \"desc\": \"RDP logon\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1059.001\",\r\n      \"desc\": \"PowerShell execution\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1486\",\r\n      \"desc\": \"ransomware encryption\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1053.005\",\r\n      \"desc\": \"scheduled task persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n      \"attck\": \"T1547.001\",\r\n      \"desc\": \"Run key persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 7,\r\n      \"attck\": \"T1543.003\",\r\n      \"desc\": \"malicious service\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 8,\r\n      \"attck\": \"T1070.001\",\r\n      \"desc\": \"Windows event log clear\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/Users/Public/svc.exe\",\r\n      \"kind\": \"ransomware-binary\",\r\n      \"capability\": \"ENT-F02\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1486\",\r\n      \"match\": [\r\n        \"encrypt\",\r\n        \"locked\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/Windows/System32/Tasks/UpdateHelper\",\r\n      \"kind\": \"scheduled-task\",\r\n      \"capability\": \"PER-S01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1053.005\",\r\n      \"match\": [\r\n        \"schtasks\",\r\n        \"svc.exe\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/Windows/System32/config/SOFTWARE\",\r\n      \"kind\": \"run-key\",\r\n      \"capability\": \"PER-R01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1547.001\",\r\n      \"match\": [\r\n        \"Run\",\r\n        \"svc\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/Windows/System32/svc-helper.sys\",\r\n      \"kind\": \"malicious-service\",\r\n      \"capability\": \"PER-V01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1543.003\",\r\n      \"match\": [\r\n        \"service\",\r\n        \"helper\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/Windows/System32/winevt/Logs/Security.evtx\",\r\n      \"kind\": \"cleared-eventlog\",\r\n      \"capability\": \"ENT-F04\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1070.001\",\r\n      \"match\": [\r\n        \"cleared\",\r\n        \"1102\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"path\": \"/Windows/System32/config/RDP-Tcp.reg\",\r\n      \"kind\": \"rdp-baseline\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"UserAuthentication\",\r\n        \"0\"\r\n      ]\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"isolate the host from the network and block the attacker IP\",\r\n      \"verify\": \"host shows no inbound RDP from <ip>\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"quarantine svc.exe and terminate the ransomware process\",\r\n      \"verify\": \"no running process references svc.exe\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"action\": \"delete the UpdateHelper scheduled task\",\r\n      \"verify\": \"schtasks /query has no UpdateHelper\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"action\": \"remove the malicious Run-key value\",\r\n      \"verify\": \"reg query ...\\\\Run has no svc value\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"stop and remove the svc-helper service\",\r\n      \"verify\": \"sc query svc-helper returns not found\",\r\n  "]
[26.15117, "o", "    \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"action\": \"enable NLA and restrict RDP to VPN/allowlisted sources\",\r\n      \"verify\": \"UserAuthentication == 1 and RDP is firewalled\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"action\": \"reset all local and domain credentials used on this host\",\r\n      \"verify\": \"credential reset timestamps are recent\",\r\n      \"phase\": \"rotate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-21\",\r\n      \"action\": \"confirm RDP no longer accepts unauthenticated sessions\",\r\n      \"verify\": \"RDP probe is refused without NLA\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-22\",\r\n      \"action\": \"restore encrypted data from backup and confirm services healthy\",\r\n      \"verify\": \"critical services running and files restored\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    }\r\n  ],\r\n  \"precedence\": [\r\n    \"contain\",\r\n    \"eradicate\",\r\n    \"harden\",\r\n    \"rotate\",\r\n    \"verify\"\r\n  ],\r\n  \"no_cve_entry\": true,\r\n  \"decoys\": [],\r\n  \"signature\": \"0e4435cc95c5\"\r\n}\r\n"]
