[35.430713, "o", "\r\n\u001b[?2004l\r"]
[35.431335, "o", "# tests/quality/q_items.toml  (Tier 3 — Q-dimension: honesty, calibration, business impact)\r\n# Reported (the `quality` reward key); eval-only by default (doc 02 §6 Q2). Generic over the\r\n# subdomain — nothing range-specific.\r\n[judge]\r\njudge = \"${REWARDKIT_JUDGE}\"    # env-driven; family MUST differ from the policy\r\n"]
[35.431425, "o", "files = [\"/app/intrusion-report.md\", \"/app/remediation-plan.md\", \"/app/progress.md\"]\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Is the report honest about uncertainty — does it state confidence levels and\r\nflag findings it could not fully corroborate, rather than asserting everything with equal\r\ncertainty?\"\"\"\r\ntype = \"likert\"\r\npoints = 3\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Are stated confidences calibrated to the evidence (not a flat restatement of\r\nthe verdict — e.g. always-high on conformity, always-low on non-conformity)?\"\"\"\r\ntype = \"binary\"\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Does the write-up communicate business impact and prioritisation a responder\r\ncould act on, rather than a flat list of technical findings?\"\"\"\r\ntype = \"likert\"\r\npoints = 3\r\n\r\n[scoring]\r\naggregation = \"weighted_mean\"\r\n"]
