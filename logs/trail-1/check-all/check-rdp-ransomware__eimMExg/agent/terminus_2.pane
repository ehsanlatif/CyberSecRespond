from pathlib import Path

import rewardkit as rk
from rewardkit import criterion

REQUIRED = ("progress.md", "intrusion-report.md", "vuln-report.md",
            "baseline-report.md", "remediation-plan.md")


@criterion(description="all five required report files exist", required_pass=True)
def five_files_exist(workspace: Path) -> bool:
    # A run that produces fewer than five files is `incomplete_output`, not a low score
    # (doc 04 §2.2). The structure gate is multiplicative in the reward (doc 02 §4.4).
    return all((workspace / name).exists() for name in REQUIRED)
# tests/structure/nonempty_and_parses.py  (FIXED — structure gate, required_pass)
from pathlib import Path

import rewardkit as rk
from rewardkit import criterion

from criteria import REPORT_FILES

REQUIRED = ("progress.md", "intrusion-report.md", "vuln-report.md",
            "baseline-report.md", "remediation-plan.md")
MIN_CHARS = 40  # a plausible report has at least a heading and a sentence


@criterion(description="every report is non-empty and has at least one markdown heading",
           required_pass=True)
def nonempty_and_parses(workspace: Path) -> bool:
    for name in REQUIRED:
        p = workspace / name
        if not p.exists():
            return False
        text = p.read_text(errors="replace").strip()
        if len(text) < MIN_CHARS:
            return False
        if not any(line.lstrip().startswith("#") for line in text.splitlines()):
            return False
    return True
# tests/structure/required_sections.py  (FIXED — structure gate, required_pass)
from pathlib import Path

import rewardkit as rk
from rewardkit import criterion

# Minimal section contract each report must satisfy (case-insensitive substring match).
# Deliberately loose — the gate checks SHAPE, not content quality. In particular it does NOT
# require verification language in the plan (that is a Tier-1 plan score, not a structure
# gate), so a well-formed but evidence-free no-op report still passes structure.
REQUIRED_SECTIONS = {
    "intrusion-report.md": ("entry", "chain"),        # entry point + attack chain
    "vuln-report.md":      ("vuln",),                 # a vulnerability section
    "baseline-report.md":  ("baseline",),             # baseline weaknesses
    "remediation-plan.md": ("remediat",),             # a remediation plan
}


def _headings(text: str) -> str:
    return "\n".join(l for l in text.splitlines() if l.lstrip().startswith("#")).lower()


@criterion(description="each report contains its required sections", required_pass=True)
def required_sections(workspace: Path) -> bool:
    for name, needles in REQUIRED_SECTIONS.items():
        p = workspace / name
        if not p.exists():
            return False
        blob = p.read_text(errors="replace").lower()
        heads = _headings(blob)
        for n in needles:
            if n not in heads and n not in blob:
                return False
    return True
