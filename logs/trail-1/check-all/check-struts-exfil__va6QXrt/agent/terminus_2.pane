[?2004lschema_version = "1.4"

[task]
name        = "dfir-eval/struts-exfil"
version     = "1.0.0"
description = "Post-compromise forensics: RHEL 9 app server breached via Apache Struts2 OGNL RCE, data staged and exfiltrated, SSH-key and cron persistence, selective auth-log wipe."
authors     = [{ name = "DFIR Synthetic Corpus" }]
keywords    = ["security", "dfir", "incident-response", "long-horizon"]

[metadata]
