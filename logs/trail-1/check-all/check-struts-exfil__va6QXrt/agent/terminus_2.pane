# tests/detection/chain_topology.py  (FIXED — Tier 2, graph-edit distance)
from pathlib import Path

import rewardkit as rk
from rewardkit import criterion

from criteria import _dag, _ged, _parse_chain


@criterion(description="attack chain topology matches ground truth")
def chain_score(workspace: Path) -> float:
    """Attack-chain reconstruction is a structure problem: parse the agent's chain into a
    DAG and compare topologically. Normalised graph edit distance over (node set, edge set)
    — the denominator is nodes + edges, and node deletions carry their incident edges, so
    the score degrades smoothly with missing/extra steps (doc 02 §3.4)."""
    gt = _dag(rk.shared._manifest(workspace)["chain"])
    pred = _parse_chain(workspace / "intrusion-report.md")
    denom = len(gt["nodes"]) + len(gt["edges"])
    if denom == 0:
        return 1.0
    return max(0.0, 1.0 - _ged(pred, gt) / denom)
# tests/detection/discovery.py  (GENERATED by the task generator from manifest.json)
# One discovery criterion per artifact; evidence/grounding is scored separately by the
# grounding gate (doc 02 §2.3), so this returns a pure 0/1 discovery sub-score.
from pathlib import Path

import rewardkit as rk
from rewardkit import criterion

from criteria import _haystack


@criterion(description="CHK {chk}: artifact {artifact} discovered")
def discovered(workspace: Path, chk: str, artifact: str, match=None) -> float:
    # Path-required: a genuine detection cites the artifact's path (Δ3). `match` needles
    # discriminate checkpoints that share a path (e.g. miner process vs. binary).
    match = list(match or [])
    for f in rk.shared._findings(workspace):
        hay = _haystack(f)
        if artifact in hay and (not match or any(m in hay for m in match)):
            return 1.0
    return 0.0


# --- registrations (silent artifacts upweighted; weights are the manifest's) ---

rk.discovered("CHK-01", "/opt/tomcat/webapps/ROOT/static/upload.jsp", match=['jsp', 'ognl'], weight=1.0)
rk.discovered("CHK-02", "/tmp/.cache/dump.tar.gz", match=['tar', 'dump'], weight=1.0)
rk.discovered("CHK-03", "/root/.ssh/authorized_keys", match=['ssh-ed25519', 'attacker'], weight=2.0)  # SILENT
rk.discovered("CHK-04", "/var/spool/cron/tomcat", match=['curl', 'beacon'], weight=1.0)
rk.discovered("CHK-05", "/opt/tomcat/lib/struts2-core.jar", match=['struts2', '2.5'], weight=1.0)
rk.discovered("CHK-06", "/var/log/tomcat/access-exfil.log", match=['POST', 'exfil'], weight=1.5)  # SILENT
rk.silent_artifact_recall(weight=0.0)   # reported, not scored — headline diagnostic
# tests/detection/no_cve_claimed.py  (FIXED — Tier 1, the negative deliverable)
import re
from pathlib import Path

import rewardkit as rk
from rewardkit import criterion

CVE = re.compile(r"cve-\d{4}-\d{4,7}")
NEGATED = ("no cve", "not cve", "no known cve", "ruled out", "rather than",
           "not driven by", "no vulnerability-driven", "not vulnerability-driven",
           "no software vulnerability", "excluded", "is not", "no exploited")
CONCLUDES_NONE = ("no cve", "not cve-driven", "no vulnerability-driven entry",
                  "misconfiguration rather than", "no known cve", "no software vulnerability")


@criterion(description="vuln-report correctly concludes no CVE-driven entry")
def no_false_cve(workspace: Path, tag) -> float:
    """The negative-deliverable check. `tag` is a required scheduling marker: it forces this
    criterion to be registered EXPLICITLY (build.py emits `rk.no_false_cve(...)` only for
    no-CVE ranges) rather than auto-scheduled, so a CVE range never contributes a free 1.0 to
    the detection axis. A CVE id is a false attribution only when asserted affirmatively —
    naming a CVE to rule it out ("entry was weak creds, not CVE-2021-44228") is correct, not
    fabrication (doc 04 §6)."""
    m = rk.shared._manifest(workspace)
    if not m.get("no_cve_entry"):
        return 1.0  # CVE-entry ranges are scored by their own discovery criteria
    p = workspace / "vuln-report.md"
    if not p.exists():
        return 0.0
    text = p.read_text(errors="replace").lower()
    for line in text.splitlines():
        if CVE.search(line) and not any(n in line for n in NEGATED):
            return 0.0  # affirmatively attributes entry to a CVE that does not exist
    asserts_none = any(phrase in text for phrase in CONCLUDES_NONE)
    return 1.0 if asserts_none else 0.3  # silence != correct conclusion
# tests/detection/silent_recall.py  (FIXED — Tier 1, the headline diagnostic)
from pathlib import Path

import rewardkit as rk
from rewardkit import criterion

from criteria import _artifact_mentioned


@criterion(description="recall over non-alerted (silent) ground-truth artifacts")
def silent_artifact_recall(workspace: Path) -> float:
    """The cleanest single number for P1 (reactive tunnel vision). Recall restricted to the
    artifacts that were NOT surfaced as alerts, so it isolates proactive investigation from
    alert transcription (doc 01 §5.3). Registered with weight 0.0 in discovery.py — reported,
    not scored."""
    m = rk.shared._manifest(workspace)
    findings = rk.shared._findings(workspace)
    silent = [a for a in m["artifacts"] if not a.get("alerted", False)]
    if not silent:
        return 1.0
    found = sum(1 for a in silent if _artifact_mentioned(findings, a))
    return found / len(silent)
