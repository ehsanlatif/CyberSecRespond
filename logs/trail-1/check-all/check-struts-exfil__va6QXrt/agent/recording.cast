[22.714025, "o", "ass\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-22\",\r\n      \"action\": \"restart tomcat and confirm service health\",\r\n      \"verify\": \"systemctl is-active tomcat and HTTP 200 on /\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    }\r\n  ],\r\n  \"precedence\": [\r\n    \"contain\",\r\n    \"eradicate\",\r\n    \"harden\",\r\n    \"rotate\",\r\n    \"verify\"\r\n  ],\r\n  \"no_cve_entry\": false,\r\n  \"decoys\": [\r\n    {\r\n      \"path\": \"/tmp/.cache/backup.tar.gz\",\r\n      \"looks_malicious\": true,\r\n      \"benign\": true\r\n    }\r\n  ],\r\n  \"signature\": \"e40b218944d0\"\r\n}\r\n\u001b[?2004hroot@69151b65274e:/app# "]
