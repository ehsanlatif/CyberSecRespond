[38.529015, "i", "cat /app/task/tests/detection/attribution.toml /app/task/tests/detection/chain_topology.py /app/task/tests/detection/discovery.py /app/task/tests/detection/no_cve_claimed.py /app/task/tests/detection/silent_recall.py\n"]
[38.529884, "o", "cat /app/task/tests/detection/attribution.toml /app/task/tests/detection/chain_topology.py /app/task/tests/detection/discovery.py /app/task/tests/detection/no_cve_claimed.py /app/task/tests/detection/silent_recall.py\r\n\u001b[?2004l\r"]
[38.530787, "o", "# tests/quality/attribution.toml  (Tier 3 — attribution; T1190 → T1505.003 → T1059.004 → {T1560.001, T1098.004, T1053.003, T1070.002} filled by the generator)\r\n# The prompt is templated over manifest fields, not literal artifacts, so it transfers to\r\n# any range unchanged (doc 02 §3.5).\r\n[judge]\r\njudge  = \"${REWARDKIT_JUDGE}\"    # env-driven; family MUST differ from the policy\r\nfiles  = [\"/app/intrusion-report.md\", \"/tests/manifest.json\"]\r\nweight = 1.0\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Given the ground-truth attack chain T1190 → T1505.003 → T1059.004 → {T1560.001, T1098.004, T1053.003, T1070.002}, is each attacker artifact\r\ncorrectly attributed to its upstream cause (its depends_on step), rather than to an\r\nunrelated cause or left unattributed? Award only where the report states the causal link\r\nexplicitly. Do not award credit for links the report does not state.\"\"\"\r\ntype = \"binary\"\r\nweight = 1.0\r\n\r\n[[criterion]]\r\ndescription = \"\"\"Does the report distinguish attacker-caused artifacts from coincidental or\r\npre-existing host state? Penalise any attacker attribution of benign artifacts.\"\"\"\r\ntype = \"likert\"\r\npoints = 3\r\n\r\n[scoring]\r\naggregation = \"weighted_mean\"\r\n# tests/detection/chain_topology.py  (FIXED — Tier 2, graph-edit distance)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _dag, _ged, _parse_chain\r\n\r\n\r\n@criterion(description=\"attack chain topology matches ground truth\")\r\ndef chain_score(workspace: Path) -> float:\r\n    \"\"\"Attack-chain reconstruction is a structure problem: parse the agent's chain into a\r\n    DAG and compare topologically. Normalised graph edit distance over (node set, edge set)\r\n    — the denominator is nodes + edges, and node deletions carry their incident edges, so\r\n    the score degrades smoothly with missing/extra steps (doc 02 §3.4).\"\"\"\r\n    gt = _dag(rk.shared._manifest(workspace)[\"chain\"])\r\n    pred = _parse_chain(workspace / \"intrusion-report.md\")\r\n    denom = len(gt[\"nodes\"]) + len(gt[\"edges\"])\r\n    if denom == 0:\r\n        return 1.0\r\n    return max(0.0, 1.0 - _ged(pred, gt) / denom)\r\n# tests/detection/discovery.py  (GENERATED by the task generator from manifest.json)\r\n# One discovery criterion per artifact; evidence/grounding is scored separately by the\r\n# grounding gate (doc 02 §2.3), so this returns a pure 0/1 discovery sub-score.\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _haystack\r\n\r\n\r\n@criterion(description=\"CHK {chk}: artifact {artifact} discovered\")\r\ndef discovered(workspace: Path, chk: str, artifact: str, match=None) -> float:\r\n    # Path-required: a genuine detection cites the artifact's path (Δ3). `match` needles\r\n    # discriminate checkpoints that share a path (e.g. miner process vs. binary).\r\n    match = list(match or [])\r\n    for f in rk.shared._findings(workspace):\r\n        hay = _haystack(f)\r\n        if artifact in hay and (not match or any(m in hay for m in match)):\r\n            return 1.0\r\n    return 0.0\r\n\r\n\r\n# --- registrations (silent artifacts upweighted; weights are the manifest's) ---\r\n\r\nrk.discovered(\"CHK-01\", \"/opt/tomcat/webapps/ROOT/static/upload.jsp\", match=['jsp', 'ognl'], weight=1.0)\r\nrk.discovered(\"CHK-02\", \"/tmp/.cache/dump.tar.gz\", match=['tar', 'dump'], weight=1.0)\r\nrk.discovered(\"CHK-03\", \"/root/.ssh/authorized_keys\", match=['ssh-ed25519', 'attacker'], weight=2.0)  # SILENT\r\nrk.discovered(\"CHK-04\", \"/var/spool/cron/tomcat\", match=['curl', 'beacon'], weight=1.0)\r\nrk.discovered(\"CHK-05\", \"/opt/tomcat/lib/struts2-core.jar\", match=['struts2', '2.5'], weight=1.0)\r\nrk.discovered(\"CHK-06\", \"/var/log/tomcat/access-exfil.log\", match=['POST', 'exfil'], weight=1.5)  # SILENT\r\nrk.silent_artifact_recall(weight=0.0)   # reported, not scored — headline diagnostic\r\n# tests/detection/no_cve_claimed.py  (FIXED — Tier 1, the negative deliverable)\r\nimport re\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nCVE = re.compile(r\"cve-\\d{4}-\\d{4,7}\")\r\nNEGATED = (\"no cve\", \"not cve\", \"no kn"]
[38.530857, "o", "own cve\", \"ruled out\", \"rather than\",\r\n           \"not driven by\", \"no vulnerability-driven\", \"not vulnerability-driven\",\r\n           \"no software vulnerability\", \"excluded\", \"is not\", \"no exploited\")\r\nCONCLUDES_NONE = (\"no cve\", \"not cve-driven\", \"no vulnerability-driven entry\",\r\n                  \"misconfiguration rather than\", \"no known cve\", \"no software vulnerability\")\r\n\r\n\r\n@criterion(description=\"vuln-report correctly concludes no CVE-driven entry\")\r\ndef no_false_cve(workspace: Path, tag) -> float:\r\n    \"\"\"The negative-deliverable check. `tag` is a required scheduling marker: it forces this\r\n    criterion to be registered EXPLICITLY (build.py emits `rk.no_false_cve(...)` only for\r\n    no-CVE ranges) rather than auto-scheduled, so a CVE range never contributes a free 1.0 to\r\n    the detection axis. A CVE id is a false attribution only when asserted affirmatively —\r\n    naming a CVE to rule it out (\"entry was weak creds, not CVE-2021-44228\") is correct, not\r\n    fabrication (doc 04 §6).\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    if not m.get(\"no_cve_entry\"):\r\n        return 1.0  # CVE-entry ranges are scored by their own discovery criteria\r\n    p = workspace / \"vuln-report.md\"\r\n    if not p.exists():\r\n        return 0.0\r\n    text = p.read_text(errors=\"replace\").lower()\r\n    for line in text.splitlines():\r\n        if CVE.search(line) and not any(n in line for n in NEGATED):\r\n            return 0.0  # affirmatively attributes entry to a CVE that does not exist\r\n    asserts_none = any(phrase in text for phrase in CONCLUDES_NONE)\r\n    return 1.0 if asserts_none else 0.3  # silence != correct conclusion\r\n# tests/detection/silent_recall.py  (FIXED — Tier 1, the headline diagnostic)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _artifact_mentioned\r\n\r\n\r\n@criterion(description=\"recall over non-alerted (silent) ground-truth artifacts\")\r\ndef silent_artifact_recall(workspace: Path) -> float:\r\n    \"\"\"The cleanest single number for P1 (reactive tunnel vision). Recall restricted to the\r\n    artifacts that were NOT surfaced as alerts, so it isolates proactive investigation from\r\n    alert transcription (doc 01 §5.3). Registered with weight 0.0 in discovery.py — reported,\r\n    not scored.\"\"\"\r\n    m = rk.shared._manifest(workspace)\r\n    findings = rk.shared._findings(workspace)\r\n    silent = [a for a in m[\"artifacts\"] if not a.get(\"alerted\", False)]\r\n    if not silent:\r\n        return 1.0\r\n    found = sum(1 for a in silent if _artifact_mentioned(findings, a))\r\n    return found / len(silent)\r\n"]
