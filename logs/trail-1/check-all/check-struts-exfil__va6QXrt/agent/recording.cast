[22.713953, "o", "\r\n      \"attck\": \"T1048\",\r\n      \"desc\": \"exfiltrate over HTTPS\",\r\n      \"depends_on\": [\r\n        4\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n      \"attck\": \"T1098.004\",\r\n      \"desc\": \"authorized_keys backdoor\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 7,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 8,\r\n      \"attck\": \"T1070.002\",\r\n      \"desc\": \"selective auth-log wipe\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/opt/tomcat/webapps/ROOT/static/upload.jsp\",\r\n      \"kind\": \"webshell\",\r\n      \"capability\": \"VUL-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"cve\": \"CVE-2023-50164\",\r\n      \"attck\": \"T1190\",\r\n      \"match\": [\r\n        \"jsp\",\r\n        \"ognl\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/tmp/.cache/dump.tar.gz\",\r\n      \"kind\": \"exfil-archive\",\r\n      \"capability\": \"ENT-F01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1560.001\",\r\n      \"match\": [\r\n        \"tar\",\r\n        \"dump\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/root/.ssh/authorized_keys\",\r\n      \"kind\": \"ssh-key-backdoor\",\r\n      \"capability\": \"PER-K01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1098.004\",\r\n      \"match\": [\r\n        \"ssh-ed25519\",\r\n        \"attacker\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/var/spool/cron/tomcat\",\r\n      \"kind\": \"cron\",\r\n      \"capability\": \"PER-S01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1053.003\",\r\n      \"match\": [\r\n        \"curl\",\r\n        \"beacon\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/opt/tomcat/lib/struts2-core.jar\",\r\n      \"kind\": \"vulnerable-lib\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"struts2\",\r\n        \"2.5\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"path\": \"/var/log/tomcat/access-exfil.log\",\r\n      \"kind\": \"exfil-endpoint\",\r\n      \"capability\": \"ENT-N01\",\r\n      \"alerted\": false,\r\n      \"weight\": 1.5,\r\n      \"attck\": \"T1048\",\r\n      \"match\": [\r\n        \"POST\",\r\n        \"exfil\"\r\n      ]\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"block the exfil destination and attacker IP at the egress firewall\",\r\n      \"verify\": \"iptables -L OUTPUT -n | grep <ip>\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"quarantine upload.jsp and its drop directory\",\r\n      \"verify\": \"! test -f /opt/tomcat/webapps/ROOT/static/upload.jsp\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"action\": \"remove the staged exfil archive\",\r\n      \"verify\": \"! test -f /tmp/.cache/dump.tar.gz\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"action\": \"remove the attacker key from /root/.ssh/authorized_keys\",\r\n      \"verify\": \"! grep -q attacker /root/.ssh/authorized_keys\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"remove the tomcat cron entry\",\r\n      \"verify\": \"! test -f /var/spool/cron/tomcat\",\r\