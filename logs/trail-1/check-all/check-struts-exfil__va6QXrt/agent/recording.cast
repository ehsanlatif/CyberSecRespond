[48.020834, "o", "cat /app/task/task.toml\r\n\u001b[?2004l\r"]
[48.021762, "o", "schema_version = \"1.4\"\r\n\r\n[task]\r\nname        = \"dfir-eval/struts-exfil\"\r\nversion     = \"1.0.0\"\r\ndescription = \"Post-compromise forensics: RHEL 9 app server breached via Apache Struts2 OGNL RCE, data staged and exfiltrated, SSH-key and cron persistence, selective auth-log wipe.\"\r\nauthors     = [{ name = \"DFIR Synthetic Corpus\" }]\r\nkeywords    = [\"security\", \"dfir\", \"incident-response\", \"long-horizon\"]\r\n\r\n[metadata]\r\nauthor_name  = \"DFIR Synthetic Corpus\"\r\nauthor_email = \"\"\r\ndifficulty   = \"hard\"\r\ncategory     = \"security\"\r\ntags         = [\"security\", \"dfir\", \"incident-response\", \"long-horizon\"]\r\n\r\n[agent]\r\ntimeout_sec = 3600.0\r\n\r\n[verifier]\r\ntimeout_sec = 900.0\r\n\r\n[verifier.env]\r\n# Tier-3 LLM judge (OPTIONAL). ${VAR:-} = empty default, so a missing var does NOT block the\r\n# run (Harbor would treat a bare ${VAR} as required) — the judge degrades to Tier 1+2. To\r\n# enable it: export REWARDKIT_JUDGE=anthropic/claude-opus-5 and ANTHROPIC_API_KEY before running.\r\nANTHROPIC_API_KEY = \"${ANTHROPIC_API_KEY:-}\"\r\nREWARDKIT_JUDGE   = \"${REWARDKIT_JUDGE:-}\"\r\n\r\n[environment]\r\n# Analysis machine is Linux regardless of the victim OS in the forensic image at /disk.\r\nos                = \"linux\"\r\nbuild_timeout_sec = 900.0\r\n"]
