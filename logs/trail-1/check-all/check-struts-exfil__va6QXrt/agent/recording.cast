[23.200237, "o", "\r\n\u001b[?2004l\r"]
[23.20068, "o", "# environment/disk.tar.gz is produced by build_disk.py\r\n\r\nRun `python3 build_disk.py tasks/<range>` after generation to synthesise the forensic image here (+ sha256) and augment `sas-mock/` with the CTI/handoff materials. The Docker build (context = this directory) bakes it read-only at `/disk`; `sas-mock/` is baked at `/sas`.\r\n\r\nEvery path cited in `tests/manifest.json` must exist inside the image (QA gate: manifest ↔ disk 100%).\r\n"]
[23.20085, "o", "\u001b[?2004h"]
[23.200977, "o", "root@69151b65274e:/app# "]
[29.462586, "i", "cat /app/task/tests/rewardkit/__init__.py /app/task/tests/rewardkit/runner.py\n"]
[29.463228, "o", "cat /app/task/tests/rewardkit/__init__.py /app/task/tests/rewardkit/runner.py"]
[29.463287, "o", "\r\n\u001b[?2004l\r"]
[29.464143, "o", "\"\"\"rewardkit — the reward substrate the DFIR verifier is written against."]
[29.464189, "o", "\r\n\r\nThis is a real, self-contained implementation of the (previously fictional) `harbor-rewardkit`\r\nAPI the criterion files use: the `@criterion` decorator, the `rk.shared.<name>` namespace of\r\nshared helpers, and the `rk.<name>(...)` registrars for parametrized criteria\r\n(`rk.discovered`, `rk.step_verified`, `rk.silent_artifact_recall`). The scoring/aggregation\r\nloop lives in `runner.py`; the Tier-3 judge adapter in `judge.py`.\r\n\r\nDesign notes:\r\n- `@criterion(shared=True)` registers a helper on `shared` (callable as `rk.shared.<name>`).\r\n- `@criterion(...)` (non-shared) registers a criterion *definition*. A definition with no\r\n  required parameters beyond `workspace` is auto-scheduled to run once; a definition that\r\n  takes extra required parameters (e.g. `discovered(workspace, chk, artifact)`) is a template\r\n  scheduled explicitly via `rk.<name>(...)`.\r\n- `rk.<name>(...)` schedules one instance of criterion `<name>` with bound args + a weight.\r\n- Instance dedup key is (name, positional-args). An explicit registration overrides an\r\n  auto-scheduled one for the same key (this is how `rk.silent_artifact_recall(weight=0.0)`\r\n  turns the auto-scheduled headline metric into a reported-but-unweighted one).\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport inspect\r\n\r\n\r\nclass _Shared:\r\n    \"\"\"Namespace object populated by @criterion(shared=True); reached as rk.shared.<name>.\"\"\"\r\n"]
[29.464563, "o", "\r\n\r\nshared = _Shared()\r\n\r\n# name -> {\"fn\", \"description\", \"required_pass\", \"group\"}\r\n_defs: dict = {}\r\n# (name, args_tuple) -> {\"name\",\"args\",\"kwargs\",\"weight\",\"auto\",\"group\"}\r\n_instances: dict = {}\r\n_current_group = None\r\n\r\n\r\ndef _reset() -> None:\r\n    \"\"\"Clear all state (the runner calls this before each run).\"\"\"\r\n    global _current_group"]
[29.464583, "o", "\r\n    _defs.clear()\r\n    _instances.clear()\r\n    for k in [k for k in vars(shared)]:\r\n        delattr(shared, k)\r\n    _current_group = None\r\n\r\n\r\ndef _set_group(group) -> None:\r\n    global _current_group\r\n    _current_group = group\r\n\r\n\r\ndef _required_extra(fn) -> list:\r\n    \"\"\"Required positional parameters beyond the leading `workspace` (no default, not *args).\"\"\"\r\n    params = list(inspect.signature(fn).parameters.values())[1:]\r\n    return [p for p in params\r\n            if p.default is inspect._empty\r\n            and p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)]\r\n\r\n\r\ndef criterion(_fn=None, *, shared=False, description=None, weight=1.0,\r\n              required_pass=False, **_extra):\r\n    \"\"\"Register a criterion (or, with shared=True, a shared helper).\"\"\"\r\n    def deco(fn):\r\n        if shared:\r\n            setattr(globals()[\"shared\"], fn.__name__, fn)\r\n            return fn\r\n        _defs[fn.__name__] = {\r\n            \"fn\": fn, \"description\": description,\r\n            \"required_pass\": required_pass, \"group\": _current_group,\r\n        }\r\n        if not _required_extra(fn):          # runnable with only `workspace` → auto-schedule\r\n            _schedule(fn.__name__, (), {}, weight, auto=True)\r\n        return fn\r\n    return deco(_fn) if _fn is not None else deco\r\n\r\n\r\ndef _schedule(name, args, kwargs, weight, auto) -> None:\r\n    key = (name, tuple(args))\r\n    existing = _instances.get(key)\r\n    if existing is not None and not existing[\"auto\"] and auto:\r\n        return                               # never let an auto instance clobber an explicit one\r\n    _instances[key] = {\r\n        \"name\": name, \"args\": tuple(args), \"kwargs\": dict(kwargs),\r\n        \"weight\": weight, \"auto\": auto, \"group\": _current_group,\r\n    }\r\n\r\n\r\ndef __getattr__(name):\r\n    \"\"\"Any unknown attribute is a registrar: rk.discovered(...), rk.step_verified(...), etc.\"\"\"\r\n    def register(*args, weight=1.0, **kwargs):\r\n        _schedule(name, args, kwargs, weight, auto=False)\r\n    return register\r\n\"\"\"The scoring loop: import criterion files, evaluate instances, apply gates, aggregate.\r\n\r\nDirectory → reward-key mapping mirrors the design (doc 02 §2.1, §3.6):\r\n  structure/  → structure gate (required_pass, multiplicative)\r\n  grounding/  → grounding rate + fabrication gate\r\n  detection/  → `detection` axis (discovery, silent_recall[w=0], chain, no_cve, attribution)\r\n  planning/   → `plan` axis (coverage, verification, ordering, plan-quality judge)\r\n  quality/    → `quality` key (Q-dimension judge; eval-only by default)\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport importlib.util\r\nimport json\r\nimport os\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nimport rewardkit.judge as judgemod   # dotted form: the module __getattr__ registrar shadows\r\n                                     # `from rewardkit import judge` (it returns a function)\r\n\r\nGROUPS = [\"structure\", \"grounding\", \"detection\", \"planning\", \"quality\"]\r\nGROUP_TO_REWARD = {\"planning\": \"plan\"}          # others map to their own name\r\nLATE = (\"discovery.py\", \"verification.py\")      # generated instance-registration files\r\nTHRESHOLD = 0.70                                # per-axis pass threshold (doc 01 §4.6)\r\n\r\n\r\ndef _reward_key(group: str) -> str:\r\n    return GROUP_TO_REWARD.get(group, group)\r\n\r\n\r\ndef _load(path: Path, name: str):\r\n    spec = importlib.util.spec_from_file_location(name, str(path))\r\n    mod = importlib.util.module_from_spec(spec)\r\n    sys.modules[name] = mod\r\n    spec.loader.exec_module(mod)\r\n    return mod\r\n\r\n\r\ndef _wmean(pairs):\r\n    num = sum(w * s for w, s in pairs)\r\n    den = sum(w for w, _ in pairs)\r\n    return round(num / den, 4) if den else None\r\n\r\n\r\ndef _parse_reward_toml(path: Path) -> list:\r\n    \"\"\"Tiny purpose-built parser for reward.toml ([[reward]] name/aggregation) — avoids a TOML\r\n    dependency so the deterministic path runs on stock Python 3.9.\"\"\"\r\n    blocks, cur = [], None\r\n    for raw in path.read_text().splitlines():\r\n        line = raw.split(\"#\", 1)[0].strip()\r\n        if line == \"[[reward]]\":\r\n            cur = {}\r\n      "]
[29.464711, "o", "      blocks.append(cur)\r\n        elif cur is not None and \"=\" in line:\r\n            k, _, v = line.partition(\"=\")\r\n            cur[k.strip()] = v.strip().strip('\"')\r\n    return blocks\r\n\r\n\r\ndef run(tests, app, disk, sas) -> dict:\r\n    tests, app = Path(tests), Path(app)\r\n    os.environ.update(RK_TESTS=str(tests), RK_DISK=str(disk),\r\n                      RK_SAS=str(sas), RK_APP=str(app))\r\n    if str(tests) not in sys.path:\r\n        sys.path.insert(0, str(tests))\r\n\r\n    rk._reset()\r\n    _load(tests / \"criteria.py\", \"criteria\")\r\n    import criteria as C  # now resolvable via sys.modules\r\n\r\n    for group in GROUPS:\r\n        gdir = tests / group\r\n        if not gdir.exists():\r\n            continue\r\n        rk._set_group(group)\r\n        files = sorted(gdir.glob(\"*.py\"))\r\n        for f in [x for x in files if x.name not in LATE] + [x for x in files if x.name in LATE]:\r\n            _load(f, f\"rk_{group}_{f.stem}\")\r\n    rk._set_group(None)\r\n\r\n    details, group_pairs = [], {g: [] for g in GROUPS}\r\n    required_fail, silent_recall = False, None\r\n\r\n    # --- deterministic instances (Tier 1 + Tier 2) ---\r\n    for (name, _args), inst in rk._instances.items():\r\n        d = rk._defs.get(name)\r\n        if d is None:\r\n            continue\r\n        try:\r\n            val = d[\"fn\"](app, *inst[\"args\"], **inst[\"kwargs\"])\r\n            score = (1.0 if val else 0.0) if isinstance(val, bool) else float(val)\r\n            err = None\r\n        except Exception as e:\r\n            score, err = 0.0, f\"{type(e).__name__}: {e}\"\r\n        details.append({\"group\": inst[\"group\"], \"criterion\": name, \"args\": list(inst[\"args\"]),\r\n                        \"weight\": inst[\"weight\"], \"score\": score, \"error\": err})\r\n        if name == \"silent_artifact_recall\":\r\n            silent_recall = score\r\n        if d.get(\"required_pass\") and score < 1.0:\r\n            required_fail = True\r\n        if inst[\"weight\"] > 0 and inst[\"group\"] in group_pairs:\r\n            group_pairs[inst[\"group\"]].append((inst[\"weight\"], score))\r\n\r\n    # --- Tier 3 judge tomls ---\r\n    for group in GROUPS:\r\n        gdir = tests / group\r\n        if not gdir.exists():\r\n            continue\r\n        for tf in sorted(gdir.glob(\"*.toml\")):\r\n            for r in judgemod.run_judge(tf, app, tests)[\"criteria\"]:\r\n                details.append({\"group\": group, \"criterion\": f\"{tf.stem}:{r['name']}\",\r\n                                \"args\": [], \"weight\": r[\"weight\"], \"score\": r[\"score\"],\r\n                                \"skipped\": r.get(\"skipped\", False),\r\n                                \"judge_reason\": r.get(\"reason\")})\r\n                if not r.get(\"skipped\") and r[\"score\"] is not None and r[\"weight\"] > 0:\r\n                    group_pairs[group].append((r[\"weight\"], r[\"score\"]))\r\n\r\n    # --- aggregate into reward keys per reward.toml ---\r\n    reward = {}\r\n    for g in GROUPS:\r\n        reward[_reward_key(g)] = _wmean(group_pairs[g])\r\n    reward_spec = _parse_reward_toml(tests / \"reward.toml\") if (tests / \"reward.toml\").exists() else []\r\n\r\n    # --- gates ---\r\n    classify = C._grounding(app)\r\n    cites = [c for f in C._findings(app) for c in f[\"citations\"]]\r\n    fabricated = sum(1 for path, _ in cites if classify(path) == \"fabricated\")\r\n    fab_rate = round(fabricated / len(cites), 4) if cites else 0.0\r\n\r\n    outcome = \"incomplete_output\" if required_fail else \"scored\"\r\n    reward[\"structure\"] = 0.0 if required_fail else 1.0\r\n    if fab_rate > 0:                                  # fabrication gate zeroes detection\r\n        reward[\"detection\"] = 0.0\r\n\r\n    det = reward.get(\"detection\") or 0.0\r\n    plan = reward.get(\"plan\") or 0.0\r\n    passed = outcome == \"scored\" and det >= THRESHOLD and plan >= THRESHOLD\r\n    reward[\"reward\"] = 1.0 if passed else 0.0\r\n    reward[\"silent_artifact_recall\"] = silent_recall if silent_recall is not None else 0.0\r\n    reward[\"fabrication_rate\"] = fab_rate\r\n    reward[\"outcome\"] = outcome\r\n\r\n    (app / \"reward.json\").write_text(json.dumps(reward, indent=2) + \"\\n\")\r\n    (app / \"reward-details.json\").write_text(json.dumps(details, indent=2) + \"\\n\")\r\n    return reward\r\n\u001b[?2004hroot@69"]
