[87.902089, "o", "33-EVIDENCE_MOUNTS = {\"/sas\": Path(os.environ.get(\"RK_SAS\", \"/sas\")),\r\n34-                   \"/disk\": Path(os.environ.get(\"RK_DISK\", \"/disk\"))}\r\n35-HOST_ROOT = \"/disk\"\r\n36-\r\n37-# The three report files findings are parsed from. progress.md and remediation-plan.md are\r\n38-# handled by their own criteria and are not scanned for detection findings.\r\n39-REPORT_FILES = (\"intrusion-report.md\", \"vuln-report.md\", \"baseline-report.md\")\r\n40-\r\n41-# ATT&CK technique id, e.g. T1110 or T1546.004.\r\n42-ATTCK = re.compile(r\"\\bT\\d{4}(?:\\.\\d{3})?\\b\")\r\n43-\r\n44-\r\n45-@criterion(shared=True)\r\n46-def _manifest(workspace: Path) -> dict:\r\n47-    \"\"\"Ground truth for this range (generated corpus) or hand-extracted (SecRespond).\"\"\"\r\n48-    return json.loads((TESTS_DIR / \"manifest.json\").read_text())\r\n49-\r\n50-\r\n51-@criterion(shared=True)\r\n52:def _findings(workspace: Path) -> list:\r\n53-    \"\"\"Parse (claim, citations) pairs out of the agent's markdown reports.\"\"\""]
[87.902217, "o", "\r\n54-    out = []\r\n55-    for name in REPORT_FILES:\r\n56-        p = workspace / name\r\n57-        if not p.exists():\r\n58-            continue\r\n59-        for line in p.read_text(errors=\"replace\").splitlines():\r\n60-            cites = CITE.findall(line)\r\n61-            if cites:\r\n62-                out.append({\"claim\": line.strip(), \"citations\": cites, \"source\": name})\r\n63-    return out\r\n64-\r\n65-\r\n66-def _candidates(path: str) -> list:\r\n67-    \"\"\"Real filesystem candidate(s) a citation could resolve to, by mount prefix.\"\"\"\r\n68-    p = \"/\" + path.lstrip(\"/\")\r\n69-    for prefix, root in EVIDENCE_MOUNTS.items():\r\n70-        if p == prefix or p.startswith(prefix + \"/\"):\r\n71-            return [root / p[len(prefix):].lstrip(\"/\")]\r\n72-    # No mount prefix -> a host path inside the forensic image.\r\n"]
