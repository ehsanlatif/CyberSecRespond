[104.145076, "o", "\r\n"]
[104.145131, "o", "15-\r\n16-# Mount locations default to the container paths but are overridable via env, so the runner\r\n17-# (and selftest) can point them at real or synthesised directories without editing this file.\r\n18-TESTS_DIR = Path(os.environ.get(\"RK_TESTS\", \"/tests\"))\r\n19-\r\n20-# Citations MUST be backtick-delimited: `/abs/path` or `/abs/path:line`. Requiring the\r\n21-# backticks stops bare slashes in prose (\"and/or\", \"TCP/IP\", \"24/7\") from being parsed as\r\n22-# paths and then flagged as fabrication. The path class excludes ':' so the optional\r\n23-# ':line' suffix splits unambiguously (doc 02 §3.3).\r\n24:CITE = re.compile(r\"`(/[^`\\s:]+)(?::(\\d+))?`\")\r\n25-\r\n26-# Read-only evidence mounts the agent is given (doc 02 §2.3). Citations are resolved by\r\n27-# mount prefix, NOT by blindly stripping the leading '/':\r\n28-#   - a citation beginning with a mount prefix (\"/sas/alerts.json\") resolves literally under\r\n29-#     that mount;\r\n30-#   - any other host-absolute citation (\"/etc/ssh/sshd_config\") is a path *inside the\r\n31-#     forensic image* and resolves under the primary host root (/disk) — never against the"]
[104.145419, "o", "\r\n32-#     analysis machine's own filesystem.\r\n33-EVIDENCE_MOUNTS = {\"/sas\": Path(os.environ.get(\"RK_SAS\", \"/sas\")),\r\n34-                   \"/disk\": Path(os.environ.get(\"RK_DISK\", \"/disk\"))}\r\n--\r\n50-\r\n51-@criterion(shared=True)"]
[104.145515, "o", "\r\n52-def _findings(workspace: Path) -> list:\r\n53-    \"\"\"Parse (claim, citations) pairs out of the agent's markdown reports.\"\"\"\r\n54-    out = []\r\n55-    for name in REPORT_FILES:\r\n56-        p = workspace / name\r\n57-        if not p.exists():\r\n58-            continue\r\n59-        for line in p.read_text(errors=\"replace\").splitlines():\r\n60:            cites = CITE.findall(line)\r\n61-            if cites:\r\n62-                out.append({\"claim\": line.strip(), \"citations\": cites, \"source\": name})\r\n63-    return out\r\n64-\r\n65-\r\n66-def _candidates(path: str) -> list:\r\n67-    \"\"\"Real filesystem candidate(s) a citation could resolve to, by mount prefix.\"\"\"\r\n68-    p = \"/\" + path.lstrip(\"/\")\r\n69-    for prefix, root in EVIDENCE_MOUNTS.items():\r\n70-        if p == prefix or p.startswith(prefix + \"/\"):\r\n\u001b[?2004hroot@98ca416e1de0:/app# "]
