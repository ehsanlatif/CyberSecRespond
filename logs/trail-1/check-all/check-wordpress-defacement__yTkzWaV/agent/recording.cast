[25.84191, "o", "{\r\n  \"range_id\": \"wordpress-defacement\",\r\n  \"difficulty\": 2,\r\n  \"alert_coverage\": 0.6,\r\n  \"platform\": {\r\n    \"os\": \"ubuntu\",\r\n    \"version\": \"20.04\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1190\",\r\n"]
[25.841938, "o", "      \"desc\": \"WordPress plugin RCE (CVE-2022-1609)\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1505.003\",\r\n      \"desc\": \"PHP webshell planted\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1491.001\",\r\n      \"desc\": \"site defacement\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1505.003\",\r\n      \"desc\": \".htaccess redirect\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/var/www/html/wp-content/plugins/contact/inc.php\",\r\n      \"kind\": \"php-webshell\",\r\n      \"capability\": \"VUL-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"cve\": \"CVE-2022-1609\",\r\n      \"attck\": \"T1190\",\r\n      \"match\": [\r\n        \"eval\",\r\n        \"base64_decode\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/var/www/html/index.html\",\r\n      \"kind\": \"defaced-page\",\r\n      \"capability\": \"ENT-F01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1491.001\",\r\n      \"match\": [\r\n        \"hacked\",\r\n        \"defaced\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/var/spool/cron/crontabs/www-data\",\r\n      \"kind\": \"cron\",\r\n      \"capability\": \"PER-S01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1053.003\",\r\n      \"match\": [\r\n        \"wget\",\r\n        \"php\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/var/www/html/.htaccess\",\r\n      \"kind\": \"htaccess-redirect\",\r\n      \"capability\": \"PER-W01\",\r\n      \"alerted\": false,\r\n      \"weight\": 1.5,\r\n      \"attck\": \"T1505.003\",\r\n      \"match\": [\r\n        \"RewriteRule\",\r\n        \"redirect\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/var/www/html/wp-config.php\",\r\n      \"kind\": \"wordpress-baseline\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"DB_PASSWORD\",\r\n        \"weak\"\r\n      ]\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"block the attacker IP inbound and take the site into maintenance\",\r\n      \"verify\": \"attacker IP is blocked at the web edge\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"quarantine the PHP webshell in the contact plugin\",\r\n      \"verify\": \"! test -f /var/www/html/wp-content/plugins/contact/inc.php\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"action\": \"restore the legitimate index page from backup\",\r\n      \"verify\": \"index page no longer contains defacement markers\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"action\": \"remove the www-data cron entry\",\r\n      \"verify\": \"! test -f /var/spool/cron/crontabs/www-data\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"remove the malicious .htaccess redirect\",\r\n      \"verify\": \"! grep -q RewriteRule /var/www/html/.htaccess\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01b\",\r\n      \"action\": \"update the vulnerable plugin past the CVE-2022-1609 fix\",\r\n      \"verify\": \"plugin version is patched\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"action\": \"rotate the WordPress DB and admin credentials\",\r\n      \"verify\": \"credential rotation timestamps are recent\",\r\n      \"phase\": \"rotate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-22\",\r\n      \"action\": \"restart the web stack and confirm the site serves the real homepage\",\r\n      \"verify\": \"systemctl is-active apache2 and HTTP 200 on /\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    }\r\n  ],\r\n  \"precedence\": [\r\n    \"contain\",\r\n    \"eradicate\",\r\n    \"harden\",\r\n    \"rotate\",\r\n    \"verify\"\r"]
