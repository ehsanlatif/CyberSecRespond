[?2004l# tests/criteria.py
from __future__ import annotations
#
# Shared library for the post-compromise DFIR verifier. This file is FIXED — it is identical
# for every range in the subdomain. Nothing here is range-specific; the only per-range input
# is manifest.json (doc 02 §3.0). The @criterion(shared=True) loaders are exposed to the
# tier files as rk.shared.<name>; the plain functions below them are framework-agnostic
# helpers imported directly (`from criteria import _dag, ...`).
import json
import os
import re
from pathlib import Path

from rewardkit import criterion

# Mount locations default to the container paths but are overridable via env, so the runner
# (and selftest) can point them at real or synthesised directories without editing this file.
TESTS_DIR = Path(os.environ.get("RK_TESTS", "/tests"))

# Citations MUST be backtick-delimited: `/abs/path` or `/abs/path:line`. Requiring the
# backticks stops bare slashes in prose ("and/or", "TCP/IP", "24/7") from being parsed as
# paths and then flagged as fabrication. The path class excludes ':' so the optional
# ':line' suffix splits unambiguously (doc 02 §3.3).
CITE = re.compile(r"`(/[^`\s:]+)(?::(\d+))?`")

# Read-only evidence mounts the agent is given (doc 02 §2.3). Citations are resolved by
# mount prefix, NOT by blindly stripping the leading '/':
#   - a citation beginning with a mount prefix ("/sas/alerts.json") resolves literally under
#     that mount;
#   - any other host-absolute citation ("/etc/ssh/sshd_config") is a path *inside the
#     forensic image* and resolves under the primary host root (/disk) — never against the
#     analysis machine's own filesystem.
EVIDENCE_MOUNTS = {"/sas": Path(os.environ.get("RK_SAS", "/sas")),
                   "/disk": Path(os.environ.get("RK_DISK", "/disk"))}
HOST_ROOT = "/disk"

# The three report files findings are parsed from. progress.md and remediation-plan.md are
# handled by their own criteria and are not scanned for detection findings.
REPORT_FILES = ("intrusion-report.md", "vuln-report.md", "baseline-report.md")

# ATT&CK technique id, e.g. T1110 or T1546.004.
ATTCK = re.compile(r"\bT\d{4}(?:\.\d{3})?\b")


@criterion(shared=True)
def _manifest(workspace: Path) -> dict:
    """Ground truth for this range (generated corpus) or hand-extracted (SecRespond)."""
    return json.loads((TESTS_DIR / "manifest.json").read_text())


@criterion(shared=True)
def _findings(workspace: Path) -> list:
    """Parse (claim, citations) pairs out of the agent's markdown reports."""
    out = []
    for name in REPORT_FILES:
        p = workspace / name
        if not p.exists():
            continue
        for line in p.read_text(errors="replace").splitlines():
            cites = CITE.findall(line)
            if cites:
                out.append({"claim": line.strip(), "citations": cites, "source": name})
    return out


def _candidates(path: str) -> list:
    """Real filesystem candidate(s) a citation could resolve to, by mount prefix."""
    p = "/" + path.lstrip("/")
    for prefix, root in EVIDENCE_MOUNTS.items():
        if p == prefix or p.startswith(prefix + "/"):
            return [root / p[len(prefix):].lstrip("/")]
    # No mount prefix -> a host path inside the forensic image.
    return [EVIDENCE_MOUNTS[HOST_ROOT] / p.lstrip("/")]


@criterion(shared=True)
def _grounding(workspace: Path):
    """Return a classifier path -> {'resolved','plausible','fabricated'} so every criterion
    shares one filesystem view of the evidence mounts (doc 02 §2.3)."""

    def classify(path: str) -> str:
        cands = _candidates(path)
        if any(c.exists() for c in cands):
            return "resolved"
        if any(c.parent.exists() for c in cands):
            return "plausible"          # wrong file/line inside a real directory
        return "fabricated"             # parent directory absent under every mount

    return classify


# --------------------------------------------------------------------------------------
# Framework-agnostic helpers (pure Python; no rewardkit dependency). Imported by the tier
# files. The docs (doc 02/04) leave these as `_helpers`; here they are implemented in full.
# --------------------------------------------------------------------------------------

def _haystack(finding: dict) -> str:
    """All searchable text of a finding: its claim plus its cited path strings."""
    return finding["claim"] + " " + " ".join(c[0] for c in finding["citations"])


def _needles(artifact: dict) -> list:
    """Locator needles for finding an artifact's plan block: its path, the path basename, and
    any `match` terms. Used by coverage's block lookup (within-plan, low collision risk)."""
    path = artifact.get("path", "")
    base = path.rstrip("/").split("/")[-1] if path else ""
    return [n for n in ([path, base] + list(artifact.get("match") or [])) if n]


def _artifact_mentioned(findings: list, artifact: dict) -> bool:
    """An artifact counts as discovered only if a finding cites its full PATH (Δ3 requires
    citations, so a genuine detection names the path) AND — when the artifact has `match`
    discriminators — at least one of them co-occurs. Requiring the path avoids the substring
    collisions that would otherwise inflate silent-recall (e.g. two artifacts sharing a name
    fragment, or two checkpoints sharing one path distinguished only by `match`)."""
    path = artifact.get("path", "")
    match = list(artifact.get("match") or [])
    if not path:
        return False
    for f in findings:
        hay = _haystack(f)
        if path in hay and (not match or any(m in hay for m in match)):
            return True
    return False


def _detected_chks(findings: list, manifest: dict) -> list:
    """CHK ids of manifest artifacts the agent actually named in a report."""
    return [a["chk"] for a in manifest["artifacts"] if _artifact_mentioned(findings, a)]


# ---- attack-chain DAG (doc 02 §3.4) ----

def _dag(chain: list) -> dict:
    """Build a DAG from manifest['chain']. Nodes = ATT&CK ids; edges = (upstream, node)
    pairs derived from `depends_on` (defaulting to the previous step when absent)."""
    by_step = {c["step"]: c for c in chain}
    nodes = {c["attck"] for c in chain}
    edges = set()
    for c in chain:
        deps = c.get("depends_on")
        if deps is None and c["step"] > 1 and (c["step"] - 1) in by_step:
            deps = [c["step"] - 1]
        for d in deps or []:
            if d in by_step:
                edges.add((by_step[d]["attck"], c["attck"]))
    return {"nodes": nodes, "edges": edges}


def _chain_section(text: str) -> str:
    """Slice the '## Attack Chain' section so incidental ATT&CK ids elsewhere in the report
    (e.g. a technique id in an entities table) are not mistaken for chain nodes. Falls back to
    the whole report when no such heading exists."""
    lines = text.splitlines()
    start = next((i + 1 for i, l in enumerate(lines)
                  if l.lstrip().startswith("#") and "chain" in l.lower()), None)
    if start is None:
        return text
    end = next((j for j in range(start, len(lines)) if lines[j].lstrip().startswith("#")),
               len(lines))
    return "\n".join(lines[start:end])


def _parse_chain(report_path: Path) -> dict:
    """Parse the agent's reconstructed chain from intrusion-report.md.

    Nodes = ATT&CK ids mentioned. Edges are read from arrow notation on a line, tolerant of
    both linear (`A -> B -> C`) and branching/brace (`A -> {B, C, D}`) forms:
      - a non-brace segment with several ids chains them (a -> b -> c) and connects to
        neighbours via its first/last id;
      - a brace segment `{B, C, D}` treats its ids as siblings — each receives from the
        previous tail and sends to the next head.
    """
    nodes, edges = set(), set()
    if not report_path.exists():
        return {"nodes": nodes, "edges": edges}
    for raw in _chain_section(report_path.read_text(errors="replace")).splitlines():
        line = raw.replace("→", "->")
        ids_all = ATTCK.findall(line)
        nodes.update(ids_all)
        if "->" not in line:
            continue
        segs = line.split("->")
        heads, tails = [], []
        for seg in segs:
            ids = ATTCK.findall(seg)
            if not ids:
                heads.append([]); tails.append([]); continue
            if "{" in seg:                       # brace set: siblings
                heads.append(ids); tails.append(ids)
            else:                                 # ordered ids chain within the segment
                for a, b in zip(ids, ids[1:]):
                    edges.add((a, b))
                heads.append(ids[:1]); tails.append(ids[-1:])
        for left, right in zip(range(len(segs)), range(1, len(segs))):
            for a in tails[left]:
                for b in heads[right]:
                    edges.add((a, b))
    return {"nodes": nodes, "edges": edges}


def _ged(pred: dict, gt: dict) -> int:
    """Graph edit distance approximated as the symmetric difference of node sets plus the
    symmetric difference of edge sets (deletions + insertions). Deleting a node also deletes
    its incident edges, so both terms are counted (doc 02 §3.4)."""
    node_diff = len(pred["nodes"] ^ gt["nodes"])
    edge_diff = len(pred["edges"] ^ gt["edges"])
    return node_diff + edge_diff


# ---- remediation plan parsing (doc 02 §3.4, §3.3) ----

VERIFY_TOKENS = ("verify", "confirm", "re-run", "recheck", "revalidate", "validate",
                 "systemctl status", "systemctl is-active", "restart", "test", "check that",
                 "expect", "returns empty", "== 0")

PHASE_CUES = {
    "contain":   ("contain", "isolate", "block", "disconnect", "cordon"),
    "eradicate": ("eradicate", "remove", "delete", "kill", "terminate", "disable",
                  "quarantine", "clean", "revoke", "purge"),
    "harden":    ("harden", "permitrootlogin", "passwordauthentication", "maxauthtries",
                  "restrict", "reconfigure", "bind-address", "patch", "lock down"),
    "rotate":    ("rotate", "reset password", "reset credential", "change credential",
                  "new key", "rekey", "re-key", "rotate credentials"),
    "verify":    ("verify", "confirm", "restart", "re-run", "recheck", "validate",
                  "is-active", "health", "status", "http 200"),
}


def _blocks(plan: str) -> list:
    """Split a remediation plan into step blocks. A block starts at a numbered item, a
    bullet, or a header, and runs until the next such marker (sub-bullets included)."""
    lines = plan.splitlines()
    starts = []
    marker = re.compile(r"^\s*(?:#{1,6}\s|\d+[.)]\s|[-*+]\s)")
    for i, line in enumerate(lines):
        if marker.match(line):
            starts.append(i)
    if not starts:
        return [plan] if plan.strip() else []
    starts.append(len(lines))
    return ["\n".join(lines[starts[k]:starts[k + 1]]) for k in range(len(starts) - 1)]


def _coarse_blocks(plan: str) -> list:
    """Split a plan into step blocks at headers and numbered items ONLY — not at bullets — so
    a step keeps its sub-bullets (e.g. a `- Verify: ...` line stays with its step). Used by
    step lookup; `_blocks` (which also splits at bullets) is used by phase ordering."""
    lines = plan.splitlines()
    marker = re.compile(r"^\s*(?:#{1,6}\s|\d+[.)]\s)")
    starts = [i for i, line in enumerate(lines) if marker.match(line)]
    if not starts:
        return [plan] if plan.strip() else []
    starts.append(len(lines))
    return ["\n".join(lines[starts[k]:starts[k + 1]]) for k in range(len(starts) - 1)]


def _step_block_for(plan: str, artifact: dict) -> str:
    """Return the first plan step (with its sub-bullets) that references this artifact (by
    path, basename, or a match needle); empty string if none."""
    needles = _needles(artifact)
    for block in _coarse_blocks(plan):
        if any(n in block for n in needles):
            return block
    return ""


def _phase_of(text: str) -> str:
    """Best-guess remediation phase for a block of plan text, by keyword cue."""
    low = text.lower()
    # Explicit headers like "P0 — Contain" win.
    for phase, cues in PHASE_CUES.items():
        if re.search(rf"\b{phase}\b", low):
            return phase
    best, best_hits = None, 0
    for phase, cues in PHASE_CUES.items():
        hits = sum(1 for c in cues if c in low)
        if hits > best_hits:
            best, best_hits = phase, hits
    return best or "eradicate"


_HEADER_RE = re.compile(r"^\s*#{1,6}\s")
_STEP_RE = re.compile(r"^\s*\d+[.)]\s")


def _header_phase(text: str) -> str | None:
    low = text.lower()
    for phase in ("contain", "eradicate", "harden", "rotate", "verify"):
        if phase in low:
            return phase
    return None


def _ordered_steps(plan: str) -> list:
    """Phase label per top-level remediation step, in document order (doc 02 §3.4).

    Prefers the phase of the enclosing header ("## P1 — Eradicate"); sub-bullets such as
    "- Verify: ..." are NOT steps and must not be phase-labelled (that spuriously injected a
    'verify' step into every section). Falls back to per-step keyword classification when the
    plan has no phase headers."""
    phases, current = [], None
    for line in plan.splitlines():
        if _HEADER_RE.match(line):
            p = _header_phase(line)
            if p:
                current = p
            continue
        if _STEP_RE.match(line):
            phases.append(current or _phase_of(line))
    if not phases:  # unstructured plan — fall back to block classification
        return [_phase_of(b) for b in _blocks(plan) if b.strip()]
    return phases


def _count_precedence_violations(steps: list, precedence: list) -> int:
    """Count adjacent out-of-order transitions against the precedence order."""
    idx = [precedence.index(p) for p in steps if p in precedence]
    return sum(1 for a, b in zip(idx, idx[1:]) if a > b)
[?2004hroot@0beeee014efd:/app# cat /app/task/tests/rewardkit/runner.py
[?2004l"""The scoring loop: import criterion files, evaluate instances, apply gates, aggregate.

Directory → reward-key mapping mirrors the design (doc 02 §2.1, §3.6):
  structure/  → structure gate (required_pass, multiplicative)
  grounding/  → grounding rate + fabrication gate
  detection/  → `detection` axis (discovery, silent_recall[w=0], chain, no_cve, attribution)
  planning/   → `plan` axis (coverage, verification, ordering, plan-quality judge)
  quality/    → `quality` key (Q-dimension judge; eval-only by default)
"""
from __future__ import annotations

import importlib.util
import json
import os
import sys
from pathlib import Path

import rewardkit as rk
import rewardkit.judge as judgemod   # dotted form: the module __getattr__ registrar shadows
                                     # `from rewardkit import judge` (it returns a function)

GROUPS = ["structure", "grounding", "detection", "planning", "quality"]
GROUP_TO_REWARD = {"planning": "plan"}          # others map to their own name
LATE = ("discovery.py", "verification.py")      # generated instance-registration files
THRESHOLD = 0.70                                # per-axis pass threshold (doc 01 §4.6)


def _reward_key(group: str) -> str:
    return GROUP_TO_REWARD.get(group, group)


def _load(path: Path, name: str):
    spec = importlib.util.spec_from_file_location(name, str(path))
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


def _wmean(pairs):
    num = sum(w * s for w, s in pairs)
    den = sum(w for w, _ in pairs)
    return round(num / den, 4) if den else None


def _parse_reward_toml(path: Path) -> list:
    """Tiny purpose-built parser for reward.toml ([[reward]] name/aggregation) — avoids a TOML
    dependency so the deterministic path runs on stock Python 3.9."""
    blocks, cur = [], None
    for raw in path.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if line == "[[reward]]":
            cur = {}
            blocks.append(cur)
        elif cur is not None and "=" in line:
            k, _, v = line.partition("=")
            cur[k.strip()] = v.strip().strip('"')
    return blocks


def run(tests, app, disk, sas) -> dict:
    tests, app = Path(tests), Path(app)
    os.environ.update(RK_TESTS=str(tests), RK_DISK=str(disk),
                      RK_SAS=str(sas), RK_APP=str(app))
    if str(tests) not in sys.path:
        sys.path.insert(0, str(tests))

    rk._reset()
    _load(tests / "criteria.py", "criteria")
    import criteria as C  # now resolvable via sys.modules

    for group in GROUPS:
        gdir = tests / group
        if not gdir.exists():
            continue
        rk._set_group(group)
        files = sorted(gdir.glob("*.py"))
        for f in [x for x in files if x.name not in LATE] + [x for x in files if x.name in LATE]:
            _load(f, f"rk_{group}_{f.stem}")
    rk._set_group(None)

    details, group_pairs = [], {g: [] for g in GROUPS}
    required_fail, silent_recall = False, None

    # --- deterministic instances (Tier 1 + Tier 2) ---
    for (name, _args), inst in rk._instances.items():
        d = rk._defs.get(name)
        if d is None:
            continue
        try:
            val = d["fn"](app, *inst["args"], **inst["kwargs"])
            score = (1.0 if val else 0.0) if isinstance(val, bool) else float(val)
            err = None
        except Exception as e:
            score, err = 0.0, f"{type(e).__name__}: {e}"
        details.append({"group": inst["group"], "criterion": name, "args": list(inst["args"]),
                        "weight": inst["weight"], "score": score, "error": err})
        if name == "silent_artifact_recall":
            silent_recall = score
        if d.get("required_pass") and score < 1.0:
            required_fail = True
        if inst["weight"] > 0 and inst["group"] in group_pairs:
            group_pairs[inst["group"]].append((inst["weight"], score))

    # --- Tier 3 judge tomls ---
    for group in GROUPS:
        gdir = tests / group
        if not gdir.exists():
            continue
        for tf in sorted(gdir.glob("*.toml")):
            for r in judgemod.run_judge(tf, app, tests)["criteria"]:
                details.append({"group": group, "criterion": f"{tf.stem}:{r['name']}",
                                "args": [], "weight": r["weight"], "score": r["score"],
                                "skipped": r.get("skipped", False),
                                "judge_reason": r.get("reason")})
                if not r.get("skipped") and r["score"] is not None and r["weight"] > 0:
                    group_pairs[group].append((r["weight"], r["score"]))

    # --- aggregate into reward keys per reward.toml ---
    reward = {}
    for g in GROUPS:
        reward[_reward_key(g)] = _wmean(group_pairs[g])
    reward_spec = _parse_reward_toml(tests / "reward.toml") if (tests / "reward.toml").exists() else []

    # --- gates ---
    classify = C._grounding(app)
    cites = [c for f in C._findings(app) for c in f["citations"]]
    fabricated = sum(1 for path, _ in cites if classify(path) == "fabricated")
    fab_rate = round(fabricated / len(cites), 4) if cites else 0.0

    outcome = "incomplete_output" if required_fail else "scored"
    reward["structure"] = 0.0 if required_fail else 1.0
    if fab_rate > 0:                                  # fabrication gate zeroes detection
        reward["detection"] = 0.0

    det = reward.get("detection") or 0.0
    plan = reward.get("plan") or 0.0
    passed = outcome == "scored" and det >= THRESHOLD and plan >= THRESHOLD
    reward["reward"] = 1.0 if passed else 0.0
    reward["silent_artifact_recall"] = silent_recall if silent_recall is not None else 0.0
    reward["fabrication_rate"] = fab_rate
    reward["outcome"] = outcome

    (app / "reward.json").write_text(json.dumps(reward, indent=2) + "\n")
    (app / "reward-details.json").write_text(json.dumps(details, indent=2) + "\n")
    return reward
[?2004hroot@0beeee014efd:/app# cat /app/task/tests/rewardkit/judge.py
[?2004l"""Tier-3 judge adapter.

Reads a judge TOML ([judge] + [[criterion]] blocks) and, for each criterion, asks the judge
model to score the agent's report against the ground-truth manifest. Binary → 0/1; likert-N →
(score-1)/(points-1) in [0,1].

Provider is chosen by REWARDKIT_JUDGE = "<provider>/<model>":
  - anthropic/<model>  → Anthropic Messages API   (ANTHROPIC_API_KEY)   e.g. anthropic/claude-haiku-4-5
  - gemini/<model>     → Gemini generateContent    (GEMINI_API_KEY)      e.g. gemini/gemini-2.5-flash
A bare "<model>" with no provider is treated as anthropic.

Judge hygiene (doc 02 §3.5): the judge family MUST differ from the policy family. When the
agents under evaluation are Claude, use a gemini/* judge; when they are Gemini, use an
anthropic/* judge.

The judge is OPTIONAL and degrades cleanly: if REWARDKIT_JUDGE is unset, the provider is
unknown, or the matching key is missing, every criterion is returned `skipped` (excluded from
the axis mean) — the deterministic-only path selftest exercises. Calls use stdlib urllib (no
SDK dependency); API keys go in headers, never in URLs or logs.
"""
from __future__ import annotations

import json
import os
import urllib.request
from pathlib import Path

ANTHROPIC_URL = "https://api.anthropic.com/v1/messages"
ANTHROPIC_VERSION = "2023-06-01"
GEMINI_URL = "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"

try:  # TOML reader — stdlib on 3.11+, optional backport otherwise
    import tomllib as _toml
except ModuleNotFoundError:  # pragma: no cover
    try:
        import tomli as _toml  # type: ignore
    except ModuleNotFoundError:
        _toml = None


def _skipped(criteria, reason):
    return {"criteria": [{"name": c, "weight": w, "score": None,
                          "skipped": True, "reason": reason} for c, w in criteria]}


def _judge_target():
    """Return (provider, model, key) if a usable judge is configured, else None."""
    spec = os.environ.get("REWARDKIT_JUDGE", "").strip()
    if not spec:
        return None
    provider, _, model = spec.partition("/")
    if not model:                       # bare model string → assume Anthropic
        provider, model = "anthropic", provider
    if provider == "anthropic":
        key = os.environ.get("ANTHROPIC_API_KEY")
    elif provider == "gemini":
        key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    else:
        return None
    return (provider, model, key) if key else None


def run_judge(toml_path: Path, app: Path, tests: Path) -> dict:
    """Score every [[criterion]] in a judge TOML. Returns {"criteria": [...]}."""
    if _toml is None:
        return _skipped([(toml_path.stem, 1.0)], "no TOML reader (install tomli on <3.11)")
    spec = _toml.loads(toml_path.read_text())
    criteria = spec.get("criterion", [])
    labelled = [(f"{i}:{c.get('type', 'binary')}", float(c.get("weight", 1.0)))
                for i, c in enumerate(criteria)]

    target = _judge_target()
    if target is None:
        return _skipped(labelled, "no judge configured (REWARDKIT_JUDGE / API key)")
    provider, model, key = target

    # Assemble the evidence the judge reads: referenced report files + the manifest.
    blobs = []
    for f in spec.get("judge", {}).get("files", []):
        p = _resolve_file(f, app, tests)
        if p and p.exists():
            blobs.append(f"===== {f} =====\n{p.read_text(errors='replace')}")
    manifest = tests / "manifest.json"
    if manifest.exists():
        blobs.append(f"===== /tests/manifest.json (ground truth) =====\n{manifest.read_text()}")
    context = "\n\n".join(blobs)

    out = []
    for (label, weight), c in zip(labelled, criteria):
        ctype = c.get("type", "binary")
        points = int(c.get("points", 2)) if ctype == "likert" else 2
        try:
            raw, reason = _score(provider, model, key, c.get("description", ""),
                                 ctype, points, context)
            out.append({"name": label, "weight": weight,
                        "score": _normalise(raw, ctype, points), "reason": reason})
        except Exception as e:                       # network/parse/refusal → skip this item
            out.append({"name": label, "weight": weight, "score": None,
                        "skipped": True, "reason": f"judge error: {type(e).__name__}: {e}"})
    return {"criteria": out}


def _resolve_file(cited: str, app: Path, tests: Path) -> Path | None:
    c = "/" + cited.lstrip("/")
    if c.startswith("/app/"):
        return app / c[len("/app/"):]
    if c.startswith("/tests/"):
        return tests / c[len("/tests/"):]
    return None


def _prompt(description, ctype, points, context):
    scale = (f"an integer from 1 to {points} (1 = worst, {points} = best)"
             if ctype == "likert" else "1 for yes / criterion met, or 0 for no / not met")
    return (
        "You are a strict grader for a post-compromise DFIR evaluation. Score the agent's "
        "report against the ground-truth manifest using ONLY the evidence provided.\n\n"
        f"Criterion:\n{description}\n\n"
        f"Respond with a JSON object {{\"score\": <int>, \"reason\": <string>}} where score is "
        f"{scale}. Keep reason under 200 characters. Output only the JSON object.\n\n"
        f"Evidence:\n{context}"
    )


def _score(provider, model, key, description, ctype, points, context):
    text = (_call_anthropic if provider == "anthropic" else _call_gemini)(
        model, key, _prompt(description, ctype, points, context))
    raw = _strip_fence(text)
    try:
        parsed = json.loads(raw)
        return int(parsed["score"]), str(parsed.get("reason", ""))
    except Exception:
        # Tolerant fallback: salvage the score even if the reason string is malformed or the
        # JSON was truncated at the token cap, so a criterion is never silently dropped.
        import re
        m = re.search(r'"?score"?\s*:\s*(-?\d+)', raw)
        if not m:
            raise
        rm = re.search(r'"?reason"?\s*:\s*"([^"]{0,200})', raw)
        return int(m.group(1)), (rm.group(1) if rm else "(reason unparsed)")


def _strip_fence(text: str) -> str:
    t = text.strip()
    if t.startswith("```"):
        t = t.split("\n", 1)[1] if "\n" in t else t
        t = t.rsplit("```", 1)[0]
    return t.strip()


def _call_anthropic(model, key, prompt):
    body = {
        "model": model, "max_tokens": 1536,
        "messages": [{"role": "user", "content": prompt}],
        "output_config": {"format": {"type": "json_schema", "schema": {
            "type": "object",
            "properties": {"score": {"type": "integer"}, "reason": {"type": "string"}},
            "required": ["score", "reason"], "additionalProperties": False}}},
    }
    req = urllib.request.Request(
        ANTHROPIC_URL, data=json.dumps(body).encode(), method="POST",
        headers={"x-api-key": key, "anthropic-version": ANTHROPIC_VERSION,
                 "content-type": "application/json"})
    with urllib.request.urlopen(req, timeout=120) as resp:
        payload = json.loads(resp.read())
    if payload.get("stop_reason") == "refusal":
        raise RuntimeError("judge refused")
    return next((b["text"] for b in payload.get("content", []) if b.get("type") == "text"), "")


def _call_gemini(model, key, prompt):
    body = {
        "contents": [{"role": "user", "parts": [{"text": prompt}]}],
        "generationConfig": {"responseMimeType": "application/json"},
    }
    req = urllib.request.Request(
        GEMINI_URL.format(model=model), data=json.dumps(body).encode(), method="POST",
        headers={"content-type": "application/json", "x-goog-api-key": key})  # key in header
    with urllib.request.urlopen(req, timeout=120) as resp:
        payload = json.loads(resp.read())
    cand = (payload.get("candidates") or [{}])[0]
    return "".join(p.get("text", "") for p in cand.get("content", {}).get("parts", []))


def _normalise(raw, ctype, points):
    if ctype == "likert":
        if points <= 1:
            return float(bool(raw))
        raw = max(1, min(points, raw))          # clamp into [1, points]
        return round((raw - 1) / (points - 1), 4)   # 1→0.0 … points→1.0
    return 1.0 if raw else 0.0
