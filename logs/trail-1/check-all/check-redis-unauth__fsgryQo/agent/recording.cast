[45.330014, "o", "{\r\n  \"structure\": 1.0,\r\n  \"grounding\": 0.0,\r\n  \"detection\": 0.0,\r\n  \"plan\": 1.0,\r\n  \"quality\": null,\r\n  \"reward\": 0.0,\r\n  \"silent_artifact_recall\": 1.0,\r\n  \"fabrication_rate\": 1.0,\r\n  \"outcome\": \"scored\"\r\n}\r\n"]
[45.333713, "o", "\u001b[?2004hroot@0beeee014efd:/app/task/tests# "]
