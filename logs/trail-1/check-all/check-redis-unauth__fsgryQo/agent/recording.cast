[21.800473, "o", "{\r\n  \"range_id\": \"redis-unauth\",\r\n  \"difficulty\": 2,\r\n  \"alert_coverage\": 0.6,\r\n  \"platform\": {\r\n    \"os\": \"debian\",\r\n    \"version\": \"12\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1133\",\r\n      \"desc\": \"unauthenticated Redis access (external service)\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1059.004\",\r\n      \"desc\": \"shell execution via CONFIG SET\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1496\",\r\n      \"desc\": \"cryptomining\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1574.006\",\r\n      \"desc\": \"LD_PRELOAD hijack\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/tmp/.redis/kdevtmpfsi\",\r\n      \"kind\": \"miner-process\",\r\n      \"capability\": \"ENT-P01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1496\",\r\n      \"match\": [\r\n        \"miner\",\r\n        \"pool\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/var/spool/cron/crontabs/root\",\r\n      \"kind\": \"cron\",\r\n      \"capability\": \"PER-S01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1053.003\",\r\n      \"match\": [\r\n        \"curl\",\r\n        \"redis\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/etc/ld.so.preload\",\r\n      \"kind\": \"ld-preload-hook\",\r\n      \"capability\": \"PER-I01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1574.006\",\r\n      \"match\": [\r\n        \"preload\",\r\n        \".so\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/tmp/.redis/exp.so\",\r\n      \"kind\": \"loadable-module\",\r\n      \"capability\": \"ENT-F02\",\r\n      \"alerted\": false,\r\n      \"weight\": 1.5,\r\n      \"attck\": \"T1059.004\",\r\n      \"match\": [\r\n        \"module\",\r\n        \"exp.so\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/etc/redis/redis.conf\",\r\n      \"kind\": \"redis-baseline\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"0.0.0.0\",\r\n        \"protected-mode\"\r\n      ]\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"firewall the Redis port to localhost and block the attacker IP\",\r\n      \"verify\": \"ss -ltn shows redis bound to 127.0.0.1 only\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"quarantine the miner binary and terminate the process\",\r\n      \"verify\": \"pgrep -f kdevtmpfsi returns empty\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"action\": \"remove the injected root cron entry\",\r\n      \"verify\": \"grep -c redis /var/spool/cron/crontabs/root == 0\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"action\": \"remove the LD_PRELOAD hook from /etc/ld.so.preload\",\r\n      \"verify\": \"! test -s /etc/ld.so.preload\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"remove the attacker Redis module\",\r\n      \"verify\": \"! test -f /tmp/.redis/exp.so\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"action\": \"bind Redis to localhost, enable protected-mode and require auth\",\r\n      \"verify\": \"redis-cli CONFIG GET requirepass is set\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"action\": \"rotate any credentials reachable from the compromised host\",\r\n      \"verify\": \"credential rotation timestamps are recent\",\r\n      \"phase\": \"rotate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-22\",\r\n      \"action\": \"restart redis and confirm the host has no miner activity\",\r\n      \"verify\": \"systemctl is-active redis and CPU baseline normal\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"servic"]
[21.80059, "o", "e\"\r\n    }\r\n  ],\r\n  \"precedence\": [\r\n    \"contain\",\r\n    \"eradicate\",\r\n    \"harden\",\r\n    \"rotate\",\r\n    \"verify\"\r\n  ],\r\n  \"no_cve_entry\": true,\r\n  \"decoys\": [],\r\n  \"signature\": \"31c7d95fb9f3\"\r\n}\r\n"]
