[51.013531, "i", "cat /app/task/tests/detection/chain_topology.py\n"]
[51.014397, "o", "cat /app/task/tests/detection/chain_topology.py\r\n\u001b[?2004l\r"]
[51.014961, "o", "# tests/detection/chain_topology.py  (FIXED — Tier 2, graph-edit distance)"]
[51.015014, "o", "\r\n"]
[51.015067, "o", "from pathlib import Path"]
[51.015165, "o", "\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _dag, _ged, _parse_chain\r\n\r\n\r\n@criterion(description=\"attack chain topology matches ground truth\")\r\ndef chain_score(workspace: Path) -> float:\r\n    \"\"\"Attack-chain reconstruction is a structure problem: parse the agent's chain into a\r\n    DAG and compare topologically. Normalised graph edit distance over (node set, edge set)\r\n    — the denominator is nodes + edges, and node deletions carry their incident edges, so\r\n"]
[51.015178, "o", "    the score degrades smoothly with missing/extra steps (doc 02 §3.4).\"\"\"\r\n    gt = _dag(rk.shared._manifest(workspace)[\"chain\"])\r\n    pred = _parse_chain(workspace / \"intrusion-report.md\")\r\n    denom = len(gt[\"nodes\"]) + len(gt[\"edges\"])\r\n    if denom == 0:\r\n        return 1.0\r\n    return max(0.0, 1.0 - _ged(pred, gt) / denom)\r\n"]
[51.015291, "o", "\u001b[?2004h"]
[51.015342, "o", "root@0beeee014efd:/app/task/tests# "]
[51.120605, "i", "cat /app/task/tests/detection/discovery.py\n"]
[51.121519, "o", "cat /app/task/tests/detection/discovery.py\r\n"]
[51.121673, "o", "\u001b[?2004l\r"]
[51.122304, "o", "# tests/detection/discovery.py  (GENERATED by the task generator from manifest.json)\r\n# One discovery criterion per artifact; evidence/grounding is scored separately by the\r\n# grounding gate (doc 02 §2.3), so this returns a pure 0/1 discovery sub-score.\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _haystack\r\n\r\n\r\n@criterion(description=\"CHK {chk}: artifact {artifact} discovered\")\r\ndef discovered(workspace: Path, chk: str, artifact: str, match=None) -> float:\r\n    # Path-required: a genuine detection cites the artifact's path (Δ3). `match` needles\r\n    # discriminate checkpoints that share a path (e.g. miner process vs. binary).\r\n    match = list(match or [])\r\n    for f in rk.shared._findings(workspace):\r\n        hay = _haystack(f)\r\n        if artifact in hay and (not match or any(m in hay for m in match)):\r\n            return 1.0\r\n    return 0.0\r\n\r\n\r\n# --- registrations (silent artifacts upweighted; weights are the manifest's) ---\r\n\r\nrk.discovered(\"CHK-01\", \"/tmp/.redis/kdevtmpfsi\", match=['miner', 'pool'], weight=1.0)\r\nrk.discovered(\"CHK-02\", \"/var/spool/cron/crontabs/root\", match=['curl', 'redis'], weight=1.0)\r\nrk.discovered(\"CHK-03\", \"/etc/ld.so.preload\", match=['preload', '.so'], weight=2.0)  # SILENT\r\nrk.discovered(\"CHK-04\", \"/tmp/.redis/exp.so\", match=['module', 'exp.so'], weight=1.5)  # SILENT\r\nrk.discovered(\"CHK-05\", \"/etc/redis/redis.conf\", match=['0.0.0.0', 'protected-mode'], weight=1.0)\r\nrk.silent_artifact_recall(weight=0.0)   # reported, not scored — headline diagnostic\r\nrk.no_false_cve(\"neg-deliverable\", weight=1.5)   # no-CVE ranges only\r\n"]
[51.122523, "o", "\u001b[?2004hroot@0beeee014efd:/app/task/tests# "]
[53.473026, "i", "cat /app/task/tests/rewardkit/__init__.py\n"]
[53.473526, "o", "cat /app/task/tests/rewardkit/__init__.py"]
[53.473557, "o", "\r\n\u001b[?2004l\r"]
[53.474411, "o", "\"\"\"rewardkit — the reward substrate the DFIR verifier is written against.\r\n\r\nThis is a real, self-contained implementation of the (previously fictional) `harbor-rewardkit`\r\nAPI the criterion files use: the `@criterion` decorator, the `rk.shared.<name>` namespace of\r\nshared helpers, and the `rk.<name>(...)` registrars for parametrized criteria\r\n(`rk.discovered`, `rk.step_verified`, `rk.silent_artifact_recall`). The scoring/aggregation\r\nloop lives in `runner.py`; the Tier-3 judge adapter in `judge.py`.\r\n\r\nDesign notes:\r\n- `@criterion(shared=True)` registers a helper on `shared` (callable as `rk.shared.<name>`).\r\n- `@criterion(...)` (non-shared) registers a criterion *definition*. A definition with no\r\n  required parameters beyond `workspace` is auto-scheduled to run once; a definition that\r\n  takes extra required parameters (e.g. `discovered(workspace, chk, artifact)`) is a template\r\n  scheduled explicitly via `rk.<name>(...)`.\r\n- `rk.<name>(...)` schedules one instance of criterion `<name>` with bound args + a weight.\r\n- Instance dedup key is (name, positional-args). An explicit registration overrides an\r\n  auto-scheduled one for the same key (this is how `rk.silent_artifact_recall(weight=0.0)`\r\n  turns the auto-scheduled headline metric into a reported-but-unweighted one).\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport inspect\r\n\r\n\r\nclass _Shared:\r\n    \"\"\"Namespace object populated by @criterion(shared=True); reached as rk.shared.<name>.\"\"\"\r\n\r\n\r\nshared = _Shared()\r\n\r\n# name -> {\"fn\", \"description\", \"required_pass\", \"group\"}\r\n_defs: dict = {}\r\n# (name, args_tuple) -> {\"name\",\"args\",\"kwargs\",\"weight\",\"auto\",\"group\"}\r\n_instances: dict = {}\r\n_current_group = None\r\n\r\n\r\ndef _reset() -> None:\r\n    \"\"\"Clear all state (the runner calls this before each run).\"\"\"\r\n    global _current_group\r\n    _defs.clear()\r\n    _instances.clear()\r\n    for k in [k for k in vars(shared)]:\r\n        delattr(shared, k)\r\n    _current_group = None\r\n\r\n\r\ndef _set_group(group) -> None:\r\n    global _current_group\r\n    _current_group = group\r\n\r\n\r\ndef _required_extra(fn) -> list:\r\n    \"\"\"Required positional parameters beyond the leading `workspace` (no default, not *args).\"\"\"\r\n    params = list(inspect.signature(fn).parameters.values())[1:]\r\n    return [p for p in params\r\n            if p.default is inspect._empty\r\n            and p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)]\r\n\r\n\r\ndef criterion(_fn=None, *, shared=False, description=None, weight=1.0,\r\n              required_pass=False, **_extra):\r\n    \"\"\"Register a criterion (or, with shared=True, a shared helper).\"\"\"\r\n    def deco(fn):\r\n        if shared:\r\n            setattr(globals()[\"shared\"], fn.__name__, fn)\r\n            return fn\r\n        _defs[fn.__name__] = {\r\n            \"fn\": fn, \"description\": description,\r\n            \"required_pass\": required_pass, \"group\": _current_group,\r\n        }\r\n        if not _required_extra(fn):          # runnable with only `workspace` → auto-schedule\r\n            _schedule(fn.__name__, (), {}, weight, auto=True)\r\n        return fn\r\n    return deco(_fn) if _fn is not None else deco\r\n\r\n\r\ndef _schedule(name, args, kwargs, weight, auto) -> None:\r\n    key = (name, tuple(args))\r\n    existing = _instances.get(key)\r\n    if existing is not None and not existing[\"auto\"] and auto:\r\n        return                               # never let an auto instance clobber an explicit one\r\n    _instances[key] = {\r\n        \"name\": name, \"args\": tuple(args), \"kwargs\": dict(kwargs),\r\n        \"weight\": weight, \"auto\": auto, \"group\": _current_group,\r\n    }\r\n\r\n\r\ndef __getattr__(name):\r\n    \"\"\"Any unknown attribute is a registrar: rk.discovered(...), rk.step_verified(...), etc.\"\"\"\r\n    def register(*args, weight=1.0, **kwargs):\r\n        _schedule(name, args, kwargs, weight, auto=False)\r\n    return register\r\n"]
