[4.579455, "o", "schema_version = \"1.4\"\r\n\r\n[task]"]
[4.579515, "o", "\r\nname        = \"dfir-eval/ssh-miner\"\r\nversion     = \"1.0.0\"\r\ndescription = \"Post-compromise forensic investigation and remediation planning: CentOS 7 host compromised via SSH brute force.\"\r\nauthors     = [{ name = \"DFIR Synthetic Corpus\" }]\r\nkeywords    = [\"security\", \"dfir\", \"incident-response\", \"long-horizon\"]\r\n\r\n[metadata]\r\nauthor_name  = \"DFIR Synthetic Corpus\"\r\nauthor_email = \"\"\r\ndifficulty   = \"hard\"\r\ncategory     = \"security\"\r\ntags         = [\"security\", \"dfir\", \"incident-response\", \"long-horizon\"]\r\n"]
[4.579526, "o", "\r\n[agent]\r\ntimeout_sec = 3600.0\r\n\r\n[verifier]\r\ntimeout_sec = 900.0\r\n\r\n[verifier.env]\r\n# Tier-3 LLM judge (OPTIONAL). ${VAR:-} = empty default, so a missing var does NOT block the\r\n# run (Harbor would treat a bare ${VAR} as required) — the judge degrades to Tier 1+2. To\r\n# enable it: export REWARDKIT_JUDGE=anthropic/claude-opus-5 and ANTHROPIC_API_KEY before running.\r\nANTHROPIC_API_KEY = \"${ANTHROPIC_API_KEY:-}\"\r\nREWARDKIT_JUDGE   = \"${REWARDKIT_JUDGE:-}\"\r\n\r\n[environment]\r\n# Analysis machine is Linux regardless of the victim OS in the forensic image at /disk.\r\nos                = \"linux\"\r\nbuild_timeout_sec = 900.0\r\n"]
