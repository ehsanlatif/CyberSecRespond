[31.058693, "o", "{\r\n  \"range_id\": \"ssh-miner\",\r\n  \"difficulty\": 2,\r\n  \"alert_coverage\": 0.55,\r\n  \"platform\": {\r\n    \"os\": \"centos\",\r\n    \"version\": \"7\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1110\",\r\n      \"desc\": \"SSH brute force as root\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1021.004\",\r\n      \"desc\": \"SSH login\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1059.004\",\r\n      \"desc\": \"shell execution\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1496\",\r\n      \"desc\": \"cryptomining\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        3\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n      \"attck\": \"T1546.004\",\r\n      \"desc\": \"bashrc persistence\",\r\n\u001b[?2004h"]
