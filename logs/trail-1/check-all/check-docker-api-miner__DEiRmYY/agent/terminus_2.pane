[?2004l# tests/grounding/no_fabrication.py  (FIXED — Tier 1, the fabrication gate)
from pathlib import Path

import rewardkit as rk
from rewardkit import criterion


@criterion(description="no citation invents a path whose directory does not exist")
def no_fabrication(workspace: Path) -> bool:
    """Returns False (→ detection gate = 0, fabrication_rate ++) only when a citation is
    'fabricated' — its parent directory is absent under BOTH /disk and /sas. A citation that
    is merely 'plausible' (wrong file inside a real directory) is a wrong citation, not an
    invented one, and does not trip the gate (doc 02 §2.3)."""
    classify = rk.shared._grounding(workspace)
    for f in rk.shared._findings(workspace):
        for path, _ in f["citations"]:
            if classify(path) == "fabricated":
                return False
    return True
[?2004hroot@8aa600449623:/app# cat /app/task/tests/grounding/citations_resolve.py
[?2004l# tests/grounding/citations_resolve.py  (FIXED — Tier 1, the evidence sub-score)
from pathlib import Path

import rewardkit as rk
from rewardkit import criterion


@criterion(description="fraction of findings whose citation resolves under /disk or /sas")
def grounding_rate(workspace: Path) -> float:
    """Evidence sub-score, computed without a judge (doc 02 §2.3). A finding is grounded if
    at least one of its citations resolves to a real file under an evidence root. Findings
    whose citations are only 'plausible' (wrong file in a real dir) score 0 here but are not
    fabrication; fabrication is handled by no_fabrication.py."""
    findings = rk.shared._findings(workspace)
    if not findings:
        return 0.0
    classify = rk.shared._grounding(workspace)
    grounded = 0
    for f in findings:
        if any(classify(path) == "resolved" for path, _ in f["citations"]):
            grounded += 1
    return grounded / len(findings)
[?2004hroot@8aa600449623:/app# grep -A 30 "def _grounding" /app/task/tests/criteria.py
[?2004ldef _grounding(workspace: Path):
    """Return a classifier path -> {'resolved','plausible','fabricated'} so every criterion
    shares one filesystem view of the evidence mounts (doc 02 §2.3)."""

    def classify(path: str) -> str:
        cands = _candidates(path)
        if any(c.exists() for c in cands):
            return "resolved"
        if any(c.parent.exists() for c in cands):
            return "plausible"          # wrong file/line inside a real directory
        return "fabricated"             # parent directory absent under every mount

    return classify


# --------------------------------------------------------------------------------------
# Framework-agnostic helpers (pure Python; no rewardkit dependency). Imported by the tier
# files. The docs (doc 02/04) leave these as `_helpers`; here they are implemented in full.
# --------------------------------------------------------------------------------------

def _haystack(finding: dict) -> str:
    """All searchable text of a finding: its claim plus its cited path strings."""
    return finding["claim"] + " " + " ".join(c[0] for c in finding["citations"])


def _needles(artifact: dict) -> list:
    """Locator needles for finding an artifact's plan block: its path, the path basename, and
    any `match` terms. Used by coverage's block lookup (within-plan, low collision risk)."""
    path = artifact.get("path", "")
    base = path.rstrip("/").split("/")[-1] if path else ""
    return [n for n in ([path, base] + list(artifact.get("match") or [])) if n]
[?2004hroot@8aa600449623:/app# grep -A 25 "def _candidates" /app/task/tests/criteria.py
[?2004ldef _candidates(path: str) -> list:
    """Real filesystem candidate(s) a citation could resolve to, by mount prefix."""
    p = "/" + path.lstrip("/")
    for prefix, root in EVIDENCE_MOUNTS.items():
        if p == prefix or p.startswith(prefix + "/"):
            return [root / p[len(prefix):].lstrip("/")]
    # No mount prefix -> a host path inside the forensic image.
    return [EVIDENCE_MOUNTS[HOST_ROOT] / p.lstrip("/")]


@criterion(shared=True)
def _grounding(workspace: Path):
    """Return a classifier path -> {'resolved','plausible','fabricated'} so every criterion
    shares one filesystem view of the evidence mounts (doc 02 §2.3)."""

    def classify(path: str) -> str:
        cands = _candidates(path)
        if any(c.exists() for c in cands):
            return "resolved"
        if any(c.parent.exists() for c in cands):
            return "plausible"          # wrong file/line inside a real directory
        return "fabricated"             # parent directory absent under every mount

    return classify


