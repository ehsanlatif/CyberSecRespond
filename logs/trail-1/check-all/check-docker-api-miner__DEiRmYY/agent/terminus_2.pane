[?2004l# tests/reward.toml  (FIXED — aggregate keys; per-dimension keys are never collapsed)
[[reward]]
name = "detection"
aggregation = "weighted_mean"

[[reward]]
name = "plan"
aggregation = "weighted_mean"

[[reward]]
name = "quality"           # Q-dimension judge items; reported, eval-only by default (doc 02 §6 Q2)
