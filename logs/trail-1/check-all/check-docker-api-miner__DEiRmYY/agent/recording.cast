[58.465734, "o", "\u001b[?2004hroot@8aa600449623:/app# "]
[72.887577, "i", "cat /app/task/tests/grounding/no_fabrication.py\n"]
[72.888078, "o", "cat /app/task/tests/grounding/no_fabrication.py\r\n\u001b[?2004l\r"]
[72.888348, "o", "# tests/grounding/no_fabrication.py  (FIXED — Tier 1, the fabrication gate)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n\r\n@criterion(description=\"no citation invents a path whose directory does not exist\")\r\ndef no_fabrication(workspace: Path) -> bool:\r\n    \"\"\"Returns False (→ detection gate = 0, fabrication_rate ++) only when a citation is\r\n    'fabricated' — its parent directory is absent under BOTH /disk and /sas. A citation that\r\n    is merely 'plausible' (wrong file inside a real directory) is a wrong citation, not an\r\n    invented one, and does not trip the gate (doc 02 §2.3).\"\"\"\r\n    classify = rk.shared._grounding(workspace)\r\n    for f in rk.shared._findings(workspace):\r\n        for path, _ in f[\"citations\"]:\r\n            if classify(path) == \"fabricated\":\r\n                return False\r\n    return True\r\n"]
[72.888446, "o", "\u001b[?2004hroot@8aa600449623:/app# "]
[73.093473, "i", "cat /app/task/tests/grounding/citations_resolve.py\n"]
[73.093632, "o", "cat /app/task/tests/grounding/citations_resolve.py"]
[73.093705, "o", "\r\n"]
[73.093717, "o", "\u001b[?2004l\r"]
[73.094058, "o", "# tests/grounding/citations_resolve.py  (FIXED — Tier 1, the evidence sub-score)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n\r\n@criterion(description=\"fraction of findings whose citation resolves under /disk or /sas\")\r\ndef grounding_rate(workspace: Path) -> float:\r\n    \"\"\"Evidence sub-score, computed without a judge (doc 02 §2.3). A finding is grounded if\r\n    at least one of its citations resolves to a real file under an evidence root. Findings"]
[73.094127, "o", "\r\n    whose citations are only 'plausible' (wrong file in a real dir) score 0 here but are not\r\n    fabrication; fabrication is handled by no_fabrication.py.\"\"\"\r\n    findings = rk.shared._findings(workspace)\r\n    if not findings:\r\n        return 0.0\r\n    classify = rk.shared._grounding(workspace)\r\n    grounded = 0\r\n    for f in findings:\r\n        if any(classify(path) == \"resolved\" for path, _ in f[\"citations\"]):\r\n            grounded += 1\r\n    return grounded / len(findings)\r\n"]
[73.094306, "o", "\u001b[?2004hroot@8aa600449623:/app# "]
[73.308821, "i", "grep -A 30 \"def _grounding\" /app/task/tests/criteria.py\n"]
[73.309431, "o", "grep -A 30 \"def _grounding\" /app/task/tests/criteria.py\r\n\u001b[?2004l\r"]
[73.310039, "o", "def _grounding(workspace: Path):"]
[73.31021, "o", "\r\n    \"\"\"Return a classifier path -> {'resolved','plausible','fabricated'} so every criterion\r\n    shares one filesystem view of the evidence mounts (doc 02 §2.3).\"\"\"\r\n\r\n    def classify(path: str) -> str:\r\n        cands = _candidates(path)\r\n        if any(c.exists() for c in cands):\r\n            return \"resolved\"\r\n        if any(c.parent.exists() for c in cands):\r\n            return \"plausible\"          # wrong file/line inside a real directory\r\n        return \"fabricated\"             # parent directory absent under every mount\r\n\r\n    return classify\r\n\r\n\r\n# --------------------------------------------------------------------------------------\r\n# Framework-agnostic helpers (pure Python; no rewardkit dependency). Imported by the tier\r\n# files. The docs (doc 02/04) leave these as `_helpers`; here they are implemented in full.\r\n# --------------------------------------------------------------------------------------\r\n\r\ndef _haystack(finding: dict) -> str:\r\n    \"\"\"All searchable text of a finding: its claim plus its cited path strings.\"\"\"\r\n    return finding[\"claim\"] + \" \" + \" \".join(c[0] for c in finding[\"citations\"])\r\n\r\n\r\ndef _needles(artifact: dict) -> list:\r\n    \"\"\"Locator needles for finding an artifact's plan block: its path, the path basename, and\r\n    any `match` terms. Used by coverage's block lookup (within-plan, low collision risk).\"\"\"\r\n    path = artifact.get(\"path\", \"\")\r\n    base = path.rstrip(\"/\").split(\"/\")[-1] if path else \"\"\r\n    return [n for n in ([path, base] + list(artifact.get(\"match\") or [])) if n]\r\n"]
[73.310593, "o", "\u001b[?2004hroot@8aa600449623:/app# "]
[81.174673, "i", "grep -A 25 \"def _candidates\" /app/task/tests/criteria.py\n"]
[81.175144, "o", "grep -A 25 \"def _candidates\" /app/task/tests/criteria.py\r\n\u001b[?2004l\r"]
[81.176373, "o", "def _candidates(path: str) -> list:\r\n    \"\"\"Real filesystem candidate(s) a citation could resolve to, by mount prefix.\"\"\"\r\n    p = \"/\" + path.lstrip(\"/\")\r\n    for prefix, root in EVIDENCE_MOUNTS.items():\r\n        if p == prefix or p.startswith(prefix + \"/\"):\r\n            return [root / p[len(prefix):].lstrip(\"/\")]\r\n    # No mount prefix -> a host path inside the forensic image.\r\n    return [EVIDENCE_MOUNTS[HOST_ROOT] / p.lstrip(\"/\")]\r\n\r\n\r\n@criterion(shared=True)\r\ndef _grounding(workspace: Path):\r\n    \"\"\"Return a classifier path -> {'resolved','plausible','fabricated'} so every criterion\r\n    shares one filesystem view of the evidence mounts (doc 02 §2.3).\"\"\"\r\n\r\n    def classify(path: str) -> str:\r\n        cands = _candidates(path)\r\n        if any(c.exists() for c in cands):\r\n            return \"resolved\"\r\n        if any(c.parent.exists() for c in cands):\r\n            return \"plausible\"          # wrong file/line inside a real directory\r\n        return \"fabricated\"             # parent directory absent under every mount\r\n\r\n    return classify\r\n\r\n\r\n"]
