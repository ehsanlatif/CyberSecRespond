[58.259666, "o", "[\r\n  {\r\n    \"group\": \"structure\",\r\n    \"criterion\": \"five_files_exist\",\r\n    \"args\": [],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"structure\",\r\n    \"criterion\": \"nonempty_and_parses\",\r\n    \"args\": [],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"structure\",\r\n    \"criterion\": \"required_sections\",\r\n    \"args\": [],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"grounding\",\r\n    \"criterion\": \"grounding_rate\",\r\n    \"args\": [],\r\n    \"weight\": 1.0,\r\n    \"score\": 0.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"grounding\",\r\n    \"criterion\": \"no_fabrication\",\r\n    \"args\": [],\r\n    \"weight\": 1.0,\r\n    \"score\": 0.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"detection\",\r\n    \"criterion\": \"chain_score\",\r\n    \"args\": [],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"detection\",\r\n    \"criterion\": \"silent_artifact_recall\",\r\n    \"args\": [],\r\n    \"weight\": 0.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"detection\",\r\n    \"criterion\": \"discovered\",\r\n    \"args\": [\r\n      \"CHK-01\",\r\n      \"/opt/xmrig/xmrig\"\r\n    ],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"detection\",\r\n    \"criterion\": \"discovered\",\r\n    \"args\": [\r\n      \"CHK-02\",\r\n      \"/etc/cron.d/docker-mon\"\r\n    ],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"detection\",\r\n    \"criterion\": \"discovered\",\r\n    \"args\": [\r\n      \"CHK-03\",\r\n      \"/etc/systemd/system/docker-metrics.service\"\r\n    ],\r\n    \"weight\": 2.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"detection\",\r\n    \"criterion\": \"discovered\",\r\n    \"args\": [\r\n      \"CHK-04\",\r\n      \"/var/lib/docker/overlay2/attacker/diff/entrypoint.sh\"\r\n    ],\r\n    \"weight\": 1.5,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"detection\",\r\n    \"criterion\": \"discovered\",\r\n    \"args\": [\r\n      \"CHK-05\",\r\n      \"/etc/docker/daemon.json\"\r\n    ],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"detection\",\r\n    \"criterion\": \"no_false_cve\",\r\n    \"args\": [\r\n      \"neg-deliverable\"\r\n    ],\r\n    \"weight\": 1.5,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"planning\",\r\n    \"criterion\": \"plan_covers_findings\",\r\n    \"args\": [],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"planning\",\r\n    \"criterion\": \"ordering_ok\",\r\n    \"args\": [],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"planning\",\r\n    \"criterion\": \"step_verified\",\r\n    \"args\": [\r\n      \"CHK-20\"\r\n    ],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"planning\",\r\n    \"criterion\": \"step_verified\",\r\n    \"args\": [\r\n      \"CHK-01\"\r\n    ],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"planning\",\r\n    \"criterion\": \"step_verified\",\r\n    \"args\": [\r\n      \"CHK-02\"\r\n    ],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"planning\",\r\n    \"criterion\": \"step_verified\",\r\n    \"args\": [\r\n      \"CHK-03\"\r\n    ],\r\n    \"weight\": 1.0,\r\n    \"score\": 1.0,\r\n    \"error\": null\r\n  },\r\n  {\r\n    \"group\": \"planning\