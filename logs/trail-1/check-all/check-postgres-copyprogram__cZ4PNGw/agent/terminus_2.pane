37-# The three report files findings are parsed from. progress.md and remediation-plan.md are
38-# handled by their own criteria and are not scanned for detection findings.
39-REPORT_FILES = ("intrusion-report.md", "vuln-report.md", "baseline-report.md")
40-
41-# ATT&CK technique id, e.g. T1110 or T1546.004.
42-ATTCK = re.compile(r"\bT\d{4}(?:\.\d{3})?\b")
43-
44-
45-@criterion(shared=True)
46-def _manifest(workspace: Path) -> dict:
47-    """Ground truth for this range (generated corpus) or hand-extracted (SecRespond)."""
48-    return json.loads((TESTS_DIR / "manifest.json").read_text())
49-
50-
51-@criterion(shared=True)
52:def _findings(workspace: Path) -> list:
53-    """Parse (claim, citations) pairs out of the agent's markdown reports."""
54-    out = []
55-    for name in REPORT_FILES:
56-        p = workspace / name
57-        if not p.exists():
58-            continue
59-        for line in p.read_text(errors="replace").splitlines():
60-            cites = CITE.findall(line)
61-            if cites:
62-                out.append({"claim": line.strip(), "citations": cites, "source": name})
63-    return out
64-
65-
66-def _candidates(path: str) -> list:
67-    """Real filesystem candidate(s) a citation could resolve to, by mount prefix."""
68-    p = "/" + path.lstrip("/")
69-    for prefix, root in EVIDENCE_MOUNTS.items():
70-        if p == prefix or p.startswith(prefix + "/"):
71-            return [root / p[len(prefix):].lstrip("/")]
72-    # No mount prefix -> a host path inside the forensic image.
