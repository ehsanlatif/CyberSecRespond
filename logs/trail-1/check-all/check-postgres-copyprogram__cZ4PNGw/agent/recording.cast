[23.335832, "o", "/app/task/tests/:\r\ntotal 64\r\ndrwxr-xr-x 8 502 dialout  4096 Aug 16 14:03 .\r\ndrwxr-xr-x 7 502 dialout  4096 Aug 16 14:03 ..\r\n-rw-r--r-- 1 502 dialout 13991 Aug 16 11:23 criteria.py\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 14:03 detection\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 10:50 grounding\r\n-rw-r--r-- 1 502 dialout  4974 Aug 16 14:03 manifest.json\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 14:03 planning\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 11:22 quality\r\n-rw-r--r-- 1 502 dialout   511 Aug 16 10:51 reward.toml\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 12:19 rewardkit\r\ndrwxr-xr-x 2 502 dialout  4096 Aug 16 11:26 structure\r\n-rwxr-xr-x 1 502 dialout  1987 Aug 16 14:27 test.sh\r\n\r\n/app/task/tests/detection:\r\ntotal 28\r\ndrwxr-xr-x 2 502 dialout 4096 Aug 16 14:03 .\r\ndrwxr-xr-x 8 502 dialout 4096 Aug 16 14:03 ..\r\n-rw-r--r-- 1 502 dialout 1142 Aug 16 14:03 attribution.toml\r\n-rw-r--r-- 1 502 dialout  919 Aug 16 10:50 chain_topology.py\r\n-rw-r--r-- 1 502 dialout 1765 Aug 16 14:03 discovery.py\r\n-rw-r--r-- 1 502 dialout 1863 Aug 16 11:43 no_cve_claimed.py\r\n-rw-r--r-- 1 502 dialout  938 Aug 16 10:50 silent_recall.py"]
[23.335864, "o", "\r\n\r\n/app/task/tests/grounding:\r\ntotal 16\r\ndrwxr-xr-x 2 502 dialout 4096 Aug 16 10:50 .\r\ndrwxr-xr-x 8 502 dialout 4096 Aug 16 14:03 ..\r\n-rw-r--r-- 1 502 dialout  956 Aug 16 10:50 citations_resolve.py\r\n-rw-r--r-- 1 502 dialout  854 Aug 16 10:50 no_fabrication.py\r\n\r\n/app/task/tests/planning:\r\n"]
[23.33597, "o", "total 24\r\ndrwxr-xr-x 2 502 dialout 4096 Aug 16 14:03 .\r\ndrwxr-xr-x 8 502 dialout 4096 Aug 16 14:03 ..\r\n-rw-r--r-- 1 502 dialout 1680 Aug 16 11:01 coverage.py\r\n-rw-r--r-- 1 502 dialout  744 Aug 16 10:51 ordering.py\r\n-rw-r--r-- 1 502 dialout  837 Aug 16 10:51 quality.toml\r\n-rw-r--r-- 1 502 dialout 1431 Aug 16 14:03 verification.py\r\n\r\n/app/task/tests/quality:\r\n"]
[23.336048, "o", "total 12\r\ndrwxr-xr-x 2 502 dialout 4096 Aug 16 11:22 .\r\ndrwxr-xr-x 8 502 dialout 4096 Aug 16 14:03 ..\r\n-rw-r--r-- 1 502 dialout 1092 Aug 16 11:22 q_items.toml\r\n\r\n/app/task/tests/rewardkit:\r\ntotal 36\r\ndrwxr-xr-x 2 502 dialout 4096 Aug 16 12:19 .\r\ndrwxr-xr-x 8 502 dialout 4096 Aug 16 14:03 ..\r\n-rw-r--r-- 1 502 dialout 3725 Aug 16 11:23 __init__.py\r\n-rw-r--r-- 1 502 dialout 1064 Aug 16 11:24 __main__.py\r\n-rw-r--r-- 1 502 dialout 8263 Aug 16 12:19 judge.py\r\n-rw-r--r-- 1 502 dialout 6025 Aug 16 11:26 runner.py\r\n\r\n/app/task/tests/structure:\r\ntotal 20\r\ndrwxr-xr-x 2 502 dialout 4096 Aug 16 11:26 .\r\ndrwxr-xr-x 8 502 dialout 4096 Aug 16 14:03 ..\r\n-rw-r--r-- 1 502 dialout  662 Aug 16 10:50 five_files_exist.py\r\n-rw-r--r-- 1 502 dialout  915 Aug 16 10:50 nonempty_and_parses.py\r\n-rw-r--r-- 1 502 dialout 1457 Aug 16 11:26 required_sections.py\r\n"]
[23.336208, "o", "\u001b[?2004h"]
[23.336263, "o", "root@4d226f3f713c:/app# "]
[31.013061, "i", "cat /app/task/tests/rewardkit/runner.py\n"]
[31.013292, "o", "cat /app/task/tests/rewardkit/runner.py"]
[31.013445, "o", "\r\n"]
[31.01346, "o", "\u001b[?2004l\r"]
[31.013831, "o", "\"\"\"The scoring loop: import criterion files, evaluate instances, apply gates, aggregate."]
[31.013855, "o", "\r\n"]
[31.01388, "o", "\r\n"]
[31.01394, "o", "Directory → reward-key mapping mirrors the design (doc 02 §2.1, §3.6):"]
[31.013962, "o", "\r\n"]
[31.013996, "o", "  structure/  → structure gate (required_pass, multiplicative)"]
[31.014037, "o", "\r\n  grounding/  → grounding rate + fabrication gate\r\n  detection/  → `detection` axis (discovery, silent_recall[w=0], chain, no_cve, attribution)\r\n  planning/   → `plan` axis (coverage, verification, ordering, plan-quality judge)"]
[31.014108, "o", "\r\n  quality/    → `quality` key (Q-dimension judge; eval-only by default)\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport importlib.util\r\nimport json\r\nimport os\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nimport rewardkit.judge as judgemod   # dotted form: the module __getattr__ registrar shadows\r\n"]
[31.014166, "o", "                                     # `from rewardkit import judge` (it returns a function)\r\n\r\nGROUPS = [\"structure\", \"grounding\", \"detection\", \"planning\", \"quality\"]\r\nGROUP_TO_REWARD = {\"planning\": \"plan\"}          # others map to their own name\r\nLATE = (\"discovery.py\", \"verification.py\")      # generated instance-registration files\r\nTHRESHOLD = 0.70                                # per-axis pass threshold (doc 01 §4.6)\r\n\r\n\r\ndef _reward_key(group: str) -> str:\r\n    return GROUP_TO_REWARD.get(group, group)\r\n\r\n\r\ndef _load(path: Path, name: str):\r\n    spec = importlib.util.spec_from_file_location(name, str(path))\r\n    mod = importlib.util.module_from_spec(spec)\r\n    sys.modules[name] = mod\r\n    spec.loader.exec_module(mod)\r\n    return mod\r\n\r\n\r\ndef _wmean(pairs):\r\n    num = sum(w * s for w, s in pairs)\r\n    den = sum(w for w, _ in pairs)\r\n    return round(num / den, 4) if den else None\r\n"]
[31.014214, "o", "\r\n\r\ndef _parse_reward_toml(path: Path) -> list:\r\n    \"\"\"Tiny purpose-built parser for reward.toml ([[reward]] name/aggregation) — avoids a TOML\r\n    dependency so the deterministic path runs on stock Python 3.9.\"\"\"\r\n    blocks, cur = [], None\r\n    for raw in path.read_text().splitlines():\r\n        line = raw.split(\"#\", 1)[0].strip()\r\n        if line == \"[[reward]]\":\r\n            cur = {}\r\n            blocks.append(cur)\r\n        elif cur is not None and \"=\" in line:\r\n            k, _, v = line.partition(\"=\")\r\n            cur[k.strip()] = v.strip().strip('\"')\r\n    return blocks"]
[31.014276, "o", "\r\n\r\n\r\ndef run(tests, app, disk, sas) -> dict:\r\n    tests, app = Path(tests), Path(app)\r\n    os.environ.update(RK_TESTS=str(tests), RK_DISK=str(disk),\r\n                      RK_SAS=str(sas), RK_APP=str(app))\r\n    if str(tests) not in sys.path:\r\n        sys.path.insert(0, str(tests))\r\n\r\n    rk._reset()\r\n    _load(tests / \"criteria.py\", \"criteria\")\r\n    import criteria as C  # now resolvable via sys.modules\r\n\r\n    for group in GROUPS:\r\n        gdir = tests / group\r\n        if not gdir.exists():\r\n            continue"]
[31.01434, "o", "\r\n        rk._set_group(group)\r\n        files = sorted(gdir.glob(\"*.py\"))\r\n        for f in [x for x in files if x.name not in LATE] + [x for x in files if x.name in LATE]:\r\n            _load(f, f\"rk_{group}_{f.stem}\")\r\n    rk._set_group(None)\r\n\r\n    details, group_pairs = [], {g: [] for g in GROUPS}\r\n    required_fail, silent_recall = False, None\r\n\r\n    # --- deterministic instances (Tier 1 + Tier 2) ---\r\n    for (name, _args), inst in rk._instances.items():\r\n        d = rk._defs.get(name)\r\n"]
[31.014528, "o", "        if d is None:\r\n            continue\r\n        try:\r\n            val = d[\"fn\"](app, *inst[\"args\"], **inst[\"kwargs\"])\r\n            score = (1.0 if val else 0.0) if isinstance(val, bool) else float(val)\r\n            err = None\r\n        except Exception as e:\r\n            score, err = 0.0, f\"{type(e).__name__}: {e}\"\r\n        details.append({\"group\": inst[\"group\"], \"criterion\": name, \"args\": list(inst[\"args\"]),\r\n                        \"weight\": inst[\"weight\"], \"score\": score, \"error\": err})\r\n        if name == \"silent_artifact_recall\":\r\n            silent_recall = score\r\n        if d.get(\"required_pass\") and score < 1.0:"]
[31.014634, "o", "\r\n            required_fail = True\r\n        if inst[\"weight\"] > 0 and inst[\"group\"] in group_pairs:\r\n            group_pairs[inst[\"group\"]].append((inst[\"weight\"], score))\r\n\r\n    # --- Tier 3 judge tomls ---\r\n    for group in GROUPS:\r\n        gdir = tests / group\r\n        if not gdir.exists():\r\n            continue\r\n        for tf in sorted(gdir.glob(\"*.toml\")):\r\n            for r in judgemod.run_judge(tf, app, tests)[\"criteria\"]:\r\n                details.append({\"group\": group, \"criterion\": f\"{tf.stem}:{r['name']}\",\r\n                                \"args\": [], \"weight\": r[\"weight\"], \"score\": r[\"score\"],\r\n                                \"skipped\": r.get(\"skipped\", False),\r\n                                \"judge_reason\": r.get(\"reason\")})\r\n                if not r.get(\"skipped\") and r[\"score\"] is not None and r[\"weight\"] > 0:\r\n"]
[31.014644, "o", "                    group_pairs[group].append((r[\"weight\"], r[\"score\"]))\r\n\r\n    # --- aggregate into reward keys per reward.toml ---\r\n    reward = {}\r\n    for g in GROUPS:\r\n        reward[_reward_key(g)] = _wmean(group_pairs[g])\r\n    reward_spec = _parse_reward_toml(tests / \"reward.toml\") if (tests / \"reward.toml\").exists() else []\r\n\r\n    # --- gates ---\r\n    classify = C._grounding(app)\r\n    cites = [c for f in C._findings(app) for c in f[\"citations\"]]\r\n    fabricated = sum(1 for path, _ in cites if classify(path) == \"fabricated\")\r\n    fab_rate = round(fabricated / len(cites), 4) if cites else 0.0\r\n\r\n    outcome = \"incomplete_output\" if required_fail else \"scored\"\r\n    reward[\"structure\"] = 0.0 if required_fail else 1.0\r\n    if fab_rate > 0:                                  # fabrication gate zeroes detection\r\n        reward[\"detection\"] = 0.0\r\n\r\n    det = reward.get(\"detection\") or 0.0\r\n    plan = reward.get(\"plan\") or 0.0\r\n    passed = outcome == \"scored\" and det >= THRESHOLD and plan >= THRESHOLD\r\n    reward[\"reward\"] = 1.0 if passed else 0.0\r\n    reward[\"silent_artifact_recall\"] = silent_recall if silent_recall is not None else 0.0\r\n    reward[\"fabrication_rate\"] = fab_rate\r\n    reward[\"outcome\"] = outcome\r\n\r\n    (app / \"reward.json\").write_text(json.dumps(reward, indent=2) + \"\\n\")\r\n    (app / \"reward-details.json\").write_text(json.dumps(details, indent=2) + \"\\n\")\r\n    return reward\r\n"]
[31.014768, "o", "\u001b[?2004h"]
[31.014819, "o", "root@4d226f3f713c:/app# "]
[31.541399, "i", "cat /app/task/tests/reward.toml\n"]
[31.541743, "o", "cat /app/task/tests/reward.toml\r\n\u001b[?2004l\r"]
[31.542393, "o", "# tests/reward.toml  (FIXED — aggregate keys; per-dimension keys are never collapsed)\r\n[[reward]]\r\nname = \"detection\"\r\naggregation = \"weighted_mean\"\r\n\r\n[[reward]]\r\nname = \"plan\"\r\naggregation = \"weighted_mean\"\r\n\r\n[[reward]]\r\nname = \"quality\"           # Q-dimension judge items; reported, eval-only by default (doc 02 §6 Q2)\r\naggregation = \"weighted_mean\"\r\n\r\n[[reward]]\r\nname = \"reward\"            # Harbor's parsed score\r\naggregation = \"threshold\"  # both axes >= 0.70 (never a sum of the two — doc 00 non-negotiable #2)\r\n"]
[31.54253, "o", "\u001b[?2004hroot@4d226f3f713c:/app# "]
[37.221466, "i", "cat /app/task/environment/README.md 2>/dev/null || echo 'No env README'\n"]
[37.222334, "o", "cat /app/task/environment/README.md 2>/dev/null || echo 'No env README'\r\n\u001b[?2004l\r"]
[37.222942, "o", "# environment/disk.tar.gz is produced by build_disk.py\r\n\r\nRun `python3 build_disk.py tasks/<range>` after generation to synthesise the forensic image here (+ sha256) and augment `sas-mock/` with the CTI/handoff materials. The Docker build (context = this directory) bakes it read-only at `/disk`; `sas-mock/` is baked at `/sas`."]
[37.222958, "o", "\r\n\r\nEvery path cited in `tests/manifest.json` must exist inside the image (QA gate: manifest ↔ disk 100%).\r\n"]
[37.223099, "o", "\u001b[?2004h"]
[37.223152, "o", "root@4d226f3f713c:/app# "]
[37.691096, "i", "head -n 50 /app/task/tests/criteria.py\n"]
[37.691694, "o", "head -n 50 /app/task/tests/criteria.py\r\n\u001b[?2004l\r"]
[37.692443, "o", "# tests/criteria.py"]
[37.692494, "o", "\r\n"]
[37.692561, "o", "from __future__ import annotations\r\n#\r\n# Shared library for the post-compromise DFIR verifier. This file is FIXED — it is identical"]
[37.69266, "o", "\r\n# for every range in the subdomain. Nothing here is range-specific; the only per-range input\r\n# is manifest.json (doc 02 §3.0). The @criterion(shared=True) loaders are exposed to the\r\n# tier files as rk.shared.<name>; the plain functions below them are framework-agnostic\r\n# helpers imported directly (`from criteria import _dag, ...`).\r\nimport json\r\nimport os\r\nimport re\r\nfrom pathlib import Path\r\n\r\nfrom rewardkit import criterion\r\n\r\n# Mount locations default to the container paths but are overridable via env, so the runner\r\n# (and selftest) can point them at real or synthesised directories without editing this file.\r\nTESTS_DIR = Path(os.environ.get(\"RK_TESTS\", \"/tests\"))\r\n\r\n"]
[37.692774, "o", "# Citations MUST be backtick-delimited: `/abs/path` or `/abs/path:line`. Requiring the\r\n# backticks stops bare slashes in prose (\"and/or\", \"TCP/IP\", \"24/7\") from being parsed as\r\n# paths and then flagged as fabrication. The path class excludes ':' so the optional\r\n# ':line' suffix splits unambiguously (doc 02 §3.3).\r\nCITE = re.compile(r\"`(/[^`\\s:]+)(?::(\\d+))?`\")\r\n\r\n# Read-only evidence mounts the agent is given (doc 02 §2.3). Citations are resolved by\r\n# mount prefix, NOT by blindly stripping the leading '/':\r\n#   - a citation beginning with a mount prefix (\"/sas/alerts.json\") resolves literally under\r\n#     that mount;\r\n#   - any other host-absolute citation (\"/etc/ssh/sshd_config\") is a path *inside the\r\n#     forensic image* and resolves under the primary host root (/disk) — never against the\r\n#     analysis machine's own filesystem.\r\nEVIDENCE_MOUNTS = {\"/sas\": Path(os.environ.get(\"RK_SAS\", \"/sas\")),\r\n                   \"/disk\": Path(os.environ.get(\"RK_DISK\", \"/disk\"))}\r\nHOST_ROOT = \"/disk\"\r\n\r\n# The three report files findings are parsed from. progress.md and remediation-plan.md are\r\n# handled by their own criteria and are not scanned for detection findings.\r\nREPORT_FILES = (\"intrusion-report.md\", \"vuln-report.md\", \"baseline-report.md\")\r\n\r\n# ATT&CK technique id, e.g. T1110 or T1546.004.\r\nATTCK = re.compile(r\"\\bT\\d{4}(?:\\.\\d{3})?\\b\")\r\n\r\n\r\n@criterion(shared=True)\r\ndef _manifest(workspace: Path) -> dict:"]
[37.692787, "o", "\r\n    \"\"\"Ground truth for this range (generated corpus) or hand-extracted (SecRespond).\"\"\"\r\n    return json.loads((TESTS_DIR / \"manifest.json\").read_text())\r\n\r\n\r\n"]
[37.692863, "o", "\u001b[?2004h"]
[37.692895, "o", "root@4d226f3f713c:/app# "]
[48.018987, "i", "cat /app/task/task.toml\n"]
[48.019362, "o", "cat /app/task/task.toml\r\n\u001b[?2004l\r"]
[48.020343, "o", "schema_version = \"1.4\"\r\n\r\n[task]\r\nname        = \"dfir-eval/postgres-copyprogram\"\r\nversion     = \"1.0.0\"\r\ndescription = \"Post-compromise forensics: CentOS Stream 9 host with a weak-credential PostgreSQL abused via COPY TO PROGRAM, DNS-tunnel exfiltration, cron and systemd persistence, timestomping.\"\r\nauthors     = [{ name = \"DFIR Synthetic Corpus\" }]\r\nkeywords    = [\"security\", \"dfir\", \"incident-response\", \"long-horizon\"]\r\n\r\n[metadata]\r\nauthor_name  = \"DFIR Synthetic Corpus\"\r\nauthor_email = \"\"\r\ndifficulty   = \"hard\"\r\ncategory     = \"security\"\r\ntags         = [\"security\", \"dfir\", \"incident-response\", \"long-horizon\"]\r\n\r\n[agent]\r\ntimeout_sec = 3600.0\r\n\r\n[verifier]\r\ntimeout_sec = 900.0\r\n\r\n[verifier.env]\r\n# Tier-3 LLM judge (OPTIONAL). ${VAR:-} = empty default, so a missing var does NOT block the\r\n# run (Harbor would treat a bare ${VAR} as required) — the judge degrades to Tier 1+2. To\r\n# enable it: export REWARDKIT_JUDGE=anthropic/claude-opus-5 and ANTHROPIC_API_KEY before running.\r\nANTHROPIC_API_KEY = \"${ANTHROPIC_API_KEY:-}\"\r\nREWARDKIT_JUDGE   = \"${REWARDKIT_JUDGE:-}\"\r\n\r\n[environment]\r\n# Analysis machine is Linux regardless of the victim OS in the forensic image at /disk.\r\nos                = \"linux\"\r\nbuild_timeout_sec = 900.0\r\n"]
[48.020503, "o", "\u001b[?2004h"]
[48.020679, "o", "root@4d226f3f713c:/app# "]
[56.119992, "i", "cat /app/task/tests/rewardkit/__main__.py\n"]
[56.121251, "o", "cat /app/task/tests/rewardkit/__main__.py\r\n\u001b[?2004l\r"]
[56.121756, "o", "\"\"\"CLI: `python -m rewardkit --tests DIR [--app DIR --disk DIR --sas DIR]`.\r\n\r\nInvoked by tests/test.sh inside the Harbor container. Scores /app against the range's\r\nmanifest and writes reward.json (+ reward-details.json), then prints reward.json to stdout.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport json\r\nimport sys\r\n\r\nfrom rewardkit.runner import run\r\n\r\n\r\ndef main(argv=None) -> int:\r\n    ap = argparse.ArgumentParser(prog=\"rewardkit\", description=__doc__)\r\n    ap.add_argument(\"--tests\", default=\"/tests\", help=\"tests directory (manifest + criteria)\")\r\n    ap.add_argument(\"--app\", default=\"/app\", help=\"agent workspace (the reports to score)\")\r\n    ap.add_argument(\"--disk\", default=\"/disk\", help=\"forensic-image evidence root\")\r\n    ap.add_argument(\"--sas\", default=\"/sas\", help=\"security-product feed evidence root\")\r\n    args = ap.parse_args(argv)\r\n\r\n    reward = run(args.tests, args.app, args.disk, args.sas)\r\n    json.dump(reward, sys.stdout, indent=2)\r\n    sys.stdout.write(\"\\n\")\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[56.121864, "o", "\u001b[?2004hroot@4d226f3f713c:/app# "]
[63.037445, "i", "cat /app/task/tests/structure/required_sections.py\n"]
[63.038213, "o", "cat /app/task/tests/structure/required_sections.py\r\n\u001b[?2004l\r"]
[63.038377, "o", "# tests/structure/required_sections.py  (FIXED — structure gate, required_pass)\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\n# Minimal section contract each report must satisfy (case-insensitive substring match).\r\n# Deliberately loose — the gate checks SHAPE, not content quality. In particular it does NOT\r\n# require verification language in the plan (that is a Tier-1 plan score, not a structure\r\n# gate), so a well-formed but evidence-free no-op report still passes structure.\r\nREQUIRED_SECTIONS = {\r\n    \"intrusion-report.md\": (\"entry\", \"chain\"),        # entry point + attack chain\r\n    \"vuln-report.md\":      (\"vuln\",),                 # a vulnerability section\r\n    \"baseline-report.md\":  (\"baseline\",),             # baseline weaknesses\r\n    \"remediation-plan.md\": (\"remediat\",),             # a remediation plan\r\n}\r\n\r\n\r\ndef _headings(text: str) -> str:\r\n    return \"\\n\".join(l for l in text.splitlines() if l.lstrip().startswith(\"#\")).lower()\r\n\r\n\r\n@criterion(description=\"each report contains its required sections\", required_pass=True)\r\ndef required_sections(workspace: Path) -> bool:\r\n    for name, needles in REQUIRED_SECTIONS.items():\r\n        p = workspace / name\r\n        if not p.exists():\r\n            return False\r\n        blob = p.read_text(errors=\"replace\").lower()\r\n        heads = _headings(blob)\r\n        for n in needles:\r\n            if n not in heads and n not in blob:\r\n                return False\r\n    return True\r\n"]
[63.038679, "o", "\u001b[?2004hroot@4d226f3f713c:/app# "]
[63.526959, "i", "cat /app/task/tests/detection/discovery.py\n"]
[63.527374, "o", "cat /app/task/tests/detection/discovery.py\r\n\u001b[?2004l\r"]
[63.528256, "o", "# tests/detection/discovery.py  (GENERATED by the task generator from manifest.json)\r\n# One discovery criterion per artifact; evidence/grounding is scored separately by the"]
[63.528342, "o", "\r\n# grounding gate (doc 02 §2.3), so this returns a pure 0/1 discovery sub-score.\r\nfrom pathlib import Path\r\n\r\nimport rewardkit as rk\r\nfrom rewardkit import criterion\r\n\r\nfrom criteria import _haystack\r\n\r\n\r\n@criterion(description=\"CHK {chk}: artifact {artifact} discovered\")\r\ndef discovered(workspace: Path, chk: str, artifact: str, match=None) -> float:\r\n    # Path-required: a genuine detection cites the artifact's path (Δ3). `match` needles\r\n    # discriminate checkpoints that share a path (e.g. miner process vs. binary).\r\n    match = list(match or [])\r\n    for f in rk.shared._findings(workspace):\r\n        hay = _haystack(f)\r\n        if artifact in hay and (not match or any(m in hay for m in match)):\r\n            return 1.0\r\n    return 0.0\r\n\r\n\r\n# --- registrations (silent artifacts upweighted; weights are the manifest's) ---\r\n\r\nrk.discovered(\"CHK-01\", \"/var/lib/pgsql/.local/pgdaemon\", match=['postgres', 'daemon'], weight=1.0)\r\nrk.discovered(\"CHK-02\", \"/var/spool/cron/postgres\", match=['pgdaemon', 'cron'], weight=1.0)\r\nrk.discovered(\"CHK-03\", \"/etc/pgdaemon.conf\", match=['dns', 'tunnel'], weight=2.0)  # SILENT\r\nrk.discovered(\"CHK-04\", \"/etc/systemd/system/pg-metrics.service\", match=['pgdaemon', 'ExecStart'], weight=2.0)  # SILENT\r\nrk.discovered(\"CHK-05\", \"/var/lib/pgsql/.local/.timestamps\", match=['timestomp', 'mtime'], weight=1.5)  # SILENT\r\nrk.discovered(\"CHK-06\", \"/var/lib/pgsql/data/pg_hba.conf\", match=['trust', '0.0.0.0/0'], weight=1.0)\r\nrk.silent_artifact_recall(weight=0.0)   # reported, not scored — headline diagnostic\r\nrk.no_false_cve(\"neg-deliverable\", weight=1.5)   # no-CVE ranges only\r\n"]
