[103.576208, "o", "62-                out.append({\"claim\": line.strip(), \"citations\": cites, \"source\": name})\r\n63-    return out\r\n64-\r\n65-\r\n66-def _candidates(path: str) -> list:\r\n67-    \"\"\"Real filesystem candidate(s) a citation could resolve to, by mount prefix.\"\"\"\r\n68-    p = \"/\" + path.lstrip(\"/\")\r\n69-    for prefix, root in EVIDENCE_MOUNTS.items():\r\n70-        if p == prefix or p.startswith(prefix + \"/\"):\r\n71-            return [root / p[len(prefix):].lstrip(\"/\")]\r\n72-    # No mount prefix -> a host path inside the forensic image.\r\n73-    return [EVIDENCE_MOUNTS[HOST_ROOT] / p.lstrip(\"/\")]\r\n74-\r\n75-\r\n76-@criterion(shared=True)\r\n77:def _grounding(workspace: Path):"]
[103.576295, "o", "\r\n78-    \"\"\"Return a classifier path -> {'resolved','plausible','fabricated'} so every criterion\r\n79-    shares one filesystem view of the evidence mounts (doc 02 §2.3).\"\"\"\r\n80-\r\n81-    def classify(path: str) -> str:\r\n82-        cands = _candidates(path)\r\n83-        if any(c.exists() for c in cands):\r\n84-            return \"resolved\"\r\n85-        if any(c.parent.exists() for c in cands):\r\n86-            return \"plausible\"          # wrong file/line inside a real directory\r\n87-        return \"fabricated\"             # parent directory absent under every mount\r\n88-\r\n89-    return classify\r\n90-\r\n91-\r\n92-# --------------------------------------------------------------------------------------\r\n"]
