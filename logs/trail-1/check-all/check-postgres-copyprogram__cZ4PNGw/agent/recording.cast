[18.416456, "o", "{\r\n  \"range_id\": \"postgres-copyprogram\",\r\n  \"difficulty\": 4,\r\n  \"alert_coverage\": 0.5,\r\n  \"platform\": {\r\n    \"os\": \"centos\",\r\n    \"version\": \"stream-9\"\r\n  },\r\n  \"chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"attck\": \"T1078\",\r\n      \"desc\": \"valid accounts (weak postgres superuser)\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"attck\": \"T1059.004\",\r\n      \"desc\": \"COPY TO PROGRAM shell execution\",\r\n      \"depends_on\": [\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"attck\": \"T1048.003\",\r\n      \"desc\": \"DNS-tunnel exfiltration\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 4,\r\n      \"attck\": \"T1053.003\",\r\n      \"desc\": \"cron persistence\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 5,\r\n      \"attck\": \"T1543.002\",\r\n      \"desc\": \"systemd persistence\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    },\r\n    {\r\n      \"step\": 6,\r\n      \"attck\": \"T1070.006\",\r\n      \"desc\": \"timestomp dropped files\",\r\n      \"depends_on\": [\r\n        2\r\n      ]\r\n    }\r\n  ],\r\n  \"artifacts\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/var/lib/pgsql/.local/pgdaemon\",\r\n      \"kind\": \"dropper\",\r\n      \"capability\": \"ENT-P01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1059.004\",\r\n      \"match\": [\r\n        \"postgres\",\r\n        \"daemon\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"path\": \"/var/spool/cron/postgres\",\r\n      \"kind\": \"cron\",\r\n      \"capability\": \"PER-S01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"attck\": \"T1053.003\",\r\n      \"match\": [\r\n        \"pgdaemon\",\r\n        \"cron\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"path\": \"/etc/pgdaemon.conf\",\r\n      \"kind\": \"dns-tunnel-config\",\r\n      \"capability\": \"ENT-N01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1048.003\",\r\n      \"match\": [\r\n        \"dns\",\r\n        \"tunnel\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"path\": \"/etc/systemd/system/pg-metrics.service\",\r\n      \"kind\": \"systemd\",\r\n      \"capability\": \"PER-V01\",\r\n      \"alerted\": false,\r\n      \"weight\": 2.0,\r\n      \"attck\": \"T1543.002\",\r\n      \"match\": [\r\n        \"pgdaemon\",\r\n        \"ExecStart\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-05\",\r\n      \"path\": \"/var/lib/pgsql/.local/.timestamps\",\r\n      \"kind\": \"timestomp-residue\",\r\n      \"capability\": \"ENT-F04\",\r\n      \"alerted\": false,\r\n      \"weight\": 1.5,\r\n      \"attck\": \"T1070.006\",\r\n      \"match\": [\r\n        \"timestomp\",\r\n        \"mtime\"\r\n      ]\r\n    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"path\": \"/var/lib/pgsql/data/pg_hba.conf\",\r\n      \"kind\": \"postgres-baseline\",\r\n      \"capability\": \"BAS-01\",\r\n      \"alerted\": true,\r\n      \"weight\": 1.0,\r\n      \"match\": [\r\n        \"trust\",\r\n        \"0.0.0.0/0\"\r\n      ]\r\n    }\r\n  ],\r\n  \"remediation\": [\r\n    {\r\n      \"chk\": \"CHK-20\",\r\n      \"action\": \"block the DNS-tunnel resolver and attacker IP at the egress firewall\",\r\n      \"verify\": \"outbound DNS to the tunnel domain is blocked\",\r\n      \"phase\": \"contain\",\r\n      \"risk_class\": \"network\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"action\": \"quarantine the pgdaemon dropper and terminate the process\",\r\n      \"verify\": \"pgrep -f pgdaemon returns empty\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-02\",\r\n      \"action\": \"remove the postgres cron entry\",\r\n      \"verify\": \"! test -f /var/spool/cron/postgres\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-03\",\r\n      \"action\": \"remove the DNS-tunnel configuration\",\r\n      \"verify\": \"! test -f /etc/pgdaemon.conf\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"runtime\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-04\",\r\n      \"action\": \"disable and remove the pg-metrics systemd unit\",\r\n      \"verify\": \"systemctl is-enabled pg-metrics returns not enabled\",\r\n      \"phase\": \"eradicate\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-06\",\r\n      \"action\": \"set scram-sha-256 auth in pg_hba.conf and restrict listen_addresses\",\r\n      \"verify\": \"pg_hba.conf has no trust lines and listen is localh"]
[18.416474, "o", "ost\",\r\n      \"phase\": \"harden\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-07\",\r\n      \"action\": \"rotate the postgres superuser password and app DB credentials\",\r\n      \"verify\": \"credential rotation timestamps are recent\",\r\n      \"phase\": \"rotate\",\r\n      \"risk_class\": \"auth\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-21\",\r\n      \"action\": \"confirm COPY TO PROGRAM is no longer reachable by unprivileged roles\",\r\n      \"verify\": \"COPY PROGRAM probe is denied\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    },\r\n    {\r\n      \"chk\": \"CHK-22\",\r\n      \"action\": \"restart postgresql and confirm database health\",\r\n      \"verify\": \"systemctl is-active postgresql and a test query succeeds\",\r\n      \"phase\": \"verify\",\r\n      \"risk_class\": \"service\"\r\n    }\r\n  ],\r\n  \"precedence\": [\r\n    \"contain\",\r\n    \"eradicate\",\r\n    \"harden\",\r\n    \"rotate\",\r\n    \"verify\"\r\n  ],\r\n  \"no_cve_entry\": true,\r\n  \"decoys\": [\r\n    {\r\n      \"path\": \"/etc/systemd/system/pg-backup.service\",\r\n      \"looks_malicious\": true,\r\n      \"benign\": true\r\n    }\r\n  ],\r\n  \"signature\": \"c5f08041507f\"\r\n}\r\n"]
