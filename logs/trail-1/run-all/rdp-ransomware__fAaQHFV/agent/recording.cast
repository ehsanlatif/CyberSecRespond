      \"evidence\": \"`/disk/Windows/System32/winevt/Logs/Security.evtx`\"\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h>       \"chk\": \"CHK-06\",\r\n\u001b[?2004l\r\u001b[?2004h>       \"path\": \"/Windows/System32/config/RDP-Tcp.reg\",\r\n\u001b[?2004l\r\u001b[?2004h>       \"attck\": \"T1021.001\",\r\n\u001b[?2004l\r\u001b[?2004h>       \"confidence\": \"high\",\r\n\u001b[?2004l\r\u001b[?2004h>       \"evidence\": \"`/disk/Windows/System32/config/RDP-Tcp.reg`\"\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   ]\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
