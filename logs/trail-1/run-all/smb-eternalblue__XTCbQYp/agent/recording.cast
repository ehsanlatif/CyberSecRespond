[15.944218, "o", "\r\n  {\r\n    \"id\": \"ALERT-01\",\r\n    \"chk\": \"CHK-01\",\r\n    \"kind\": \"exploit-implant\",\r\n    \"path\": \"/Windows/Temp/mssecsvc.exe\",\r\n    \"capability\": \"VUL-01\",\r\n    \"summary\": \"exploit-implant observed at /Windows/Temp/mssecsvc.exe\"\r\n  },\r\n  {\r\n    \"id\": \"ALERT-02\",\r\n    \"chk\": \"CHK-02\",\r\n    \"kind\": \"credential-dump\",\r\n    \"path\": \"/Windows/Temp/lsass.dmp\",\r\n    \"capability\": \"ENT-F01\",\r\n    \"summary\": \"credential-dump observed at /Windows/Temp/lsass.dmp\"\r\n  },\r\n  {\r\n    \"id\": \"ALERT-03\",\r\n    \"chk\": \"CHK-03\",\r\n    \"kind\": \"ransomware-binary\",\r\n    \"path\": \"/Users/Public/enc.exe\",\r\n    \"capability\": \"ENT-F02\",\r\n    \"summary\": \"ransomware-binary observed at /Users/Public/enc.exe\"\r\n  },\r\n  {\r\n    \"id\": \"ALERT-04\",\r\n    \"chk\": \"CHK-07\",\r\n    \"kind\": \"smbv1-baseline\",\r\n    \"path\": \"/Windows/System32/drivers/srv.sys\",\r\n    \"capability\": \"BAS-01\",\r\n    \"summary\": \"smbv1-baseline observed at /Windows/System32/drivers/srv.sys\"\r\n  }\r\n]\r\n[\r\n  {\r\n    \"chk\": \"CHK-07\",\r\n    \"path\": \"/Windows/System32/drivers/srv.sys\",\r\n    \"check\": \"smbv1-baseline\",\r\n    \"capability\": \"BAS-01\"\r\n  }\r\n]\r\n[\r\n  {\r\n    \"chk\": \"CHK-01\",\r\n    \"cve\": \"CVE-2017-0144\",\r\n    \"path\": \"/Windows/Temp/mssecsvc.exe\"\r\n  }\r\n]\r\n"]
