[182.592975, "o", "{\r\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\r\n  \"title\": \"finding\",\r\n  \"type\": \"object\",\r\n  \"required\": [\r\n    \"chk\",\r\n    \"path\",\r\n    \"attck\",\r\n    \"confidence\",\r\n    \"evidence\"\r\n  ],\r\n  \"properties\": {\r\n    \"chk\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"path\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"attck\": {\r\n      \"type\": \"string\",\r\n      \"pattern\": \"^T\\\\d{4}(\\\\.\\\\d{3})?$\"\r\n    },\r\n    \"confidence\": {\r\n      \"enum\": [\r\n        \"low\",\r\n        \"medium\",\r\n        \"high\"\r\n      ]\r\n    },\r\n    \"evidence\": {\r\n      \"type\": \"string\",\r\n      \"description\": \"backtick-cited /disk or /sas path\"\r\n    }\r\n  }\r\n}\r\n{\r\n  \"findings\": [\r\n    {\r\n      \"chk\": \"CHK-01\",\r\n      \"path\": \"/tmp/.redis/kdevtmpfsi\",\r\n      \"attck\": \"T1496\",\r\n      \"confidence\": \"high\",\r\n      \"evidence\": \"`/tmp/.redis/kdevtmpfsi`\"\r\n    },\r\n    {\r\n      \"chk\": \"TODO\",\r\n      \"path\": \"TODO\",\r\n      \"attck\": \"TODO\",\r\n      \"confidence\": \"TODO\",\r\n      \"evidence\": \"TODO\"\r\n    }\r\n  ]\r\n}\r\n"]
