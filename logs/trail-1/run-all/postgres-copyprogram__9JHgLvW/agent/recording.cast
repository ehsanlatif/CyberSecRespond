[11.792378, "o", "[\r\n  {\r\n    \"id\": \"ALERT-01\",\r\n    \"chk\": \"CHK-01\",\r\n    \"kind\": \"dropper\",\r\n    \"path\": \"/var/lib/pgsql/.local/pgdaemon\",\r\n    \"capability\": \"ENT-P01\",\r\n    \"summary\": \"dropper observed at /var/lib/pgsql/.local/pgdaemon\"\r\n  },\r\n  {\r\n    \"id\": \"ALERT-02\",\r\n    \"chk\": \"CHK-02\",\r\n    \"kind\": \"cron\",\r\n    \"path\": \"/var/spool/cron/postgres\",\r\n    \"capability\": \"PER-S01\",\r\n    \"summary\": \"cron observed at /var/spool/cron/postgres\"\r\n  },\r\n  {\r\n    \"id\": \"ALERT-03\",\r\n    \"chk\": \"CHK-06\",\r\n    \"kind\": \"postgres-baseline\",\r\n    \"path\": \"/var/lib/pgsql/data/pg_hba.conf\",\r\n    \"capability\": \"BAS-01\",\r\n    \"summary\": \"postgres-baseline observed at /var/lib/pgsql/data/pg_hba.conf\"\r\n  }\r\n]\r\n[\r\n  {\r\n    \"chk\": \"CHK-06\",\r\n    \"path\": \"/var/lib/pgsql/data/pg_hba.conf\",\r\n    \"check\": \"postgres-baseline\",\r\n    \"capability\": \"BAS-01\"\r\n  }\r\n]\r\n[]\r\n\u001b[?2004h"]
