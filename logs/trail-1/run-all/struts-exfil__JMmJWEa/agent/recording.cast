[12.384618, "o", "[\r\n  {\r\n    \"id\": \"ALERT-01\",\r\n    \"chk\": \"CHK-01\",\r\n    \"kind\": \"webshell\",\r\n    \"path\": \"/opt/tomcat/webapps/ROOT/static/upload.jsp\",\r\n    \"capability\": \"VUL-01\",\r\n    \"summary\": \"webshell observed at /opt/tomcat/webapps/ROOT/static/upload.jsp\"\r\n  },\r\n  {\r\n    \"id\": \"ALERT-02\",\r\n    \"chk\": \"CHK-02\",\r\n    \"kind\": \"exfil-archive\",\r\n    \"path\": \"/tmp/.cache/dump.tar.gz\",\r\n    \"capability\": \"ENT-F01\",\r\n    \"summary\": \"exfil-archive observed at /tmp/.cache/dump.tar.gz\"\r\n  },\r\n  {\r\n    \"id\": \"ALERT-03\",\r\n    \"chk\": \"CHK-04\",\r\n    \"kind\": \"cron\",\r\n    \"path\": \"/var/spool/cron/tomcat\",\r\n    \"capability\": \"PER-S01\",\r\n    \"summary\": \"cron observed at /var/spool/cron/tomcat\"\r\n  },\r\n  {\r\n    \"id\": \"ALERT-04\",\r\n    \"chk\": \"CHK-05\",\r\n    \"kind\": \"vulnerable-lib\",\r\n    \"path\": \"/opt/tomcat/lib/struts2-core.jar\",\r\n    \"capability\": \"BAS-01\",\r\n    \"summary\": \"vulnerable-lib observed at /opt/tomcat/lib/struts2-core.jar\"\r\n  }\r\n]\r\n[\r\n  {\r\n    \"chk\": \"CHK-05\",\r\n    \"path\": \"/opt/tomcat/lib/struts2-core.jar\",\r\n    \"check\": \"vulnerable-lib\",\r\n    \"capability\": \"BAS-01\"\r\n  }\r\n]\r\n[\r\n  {\r\n    \"chk\": \"CHK-01\",\r\n    \"cve\": \"CVE-2023-50164\",\r\n    \"path\": \"/opt/tomcat/webapps/ROOT/static/upload.jsp\"\r\n  }\r\n]\r\n"]
