[224.22068, "o", "total 32\r\ndrwxr-xr-x 1 root root 4096 Aug 16 14:59 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root 4096 Aug 16 14:55 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root 2070 Aug 16 14:58 baseline-report.md\r\n-rw-r--r-- 1 root root 3693 Aug 16 14:58 intrusion-report.md\r\n-rw-r--r-- 1 root root 2757 Aug 16 14:58 progress.md\r\n-rw-r--r-- 1 root root 4208 Aug 16 14:59 remediation-plan.md\r\n-rw-r--r-- 1 root root 1852 Aug 16 14:58 vuln-report.md\r\n"]
